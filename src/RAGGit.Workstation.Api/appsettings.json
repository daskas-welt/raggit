{
    "Api": {
        "AdminKey": "",
        "EmployeeKey": ""
    },
    "Auth": {
        "JwtSigningKeyPath": "./data/auth.key",
        "TokenLifetimeHours": 8,
        "Pbkdf2Iterations": 310000,
        "LockoutThreshold": 5,
        "LockoutMinutes": 15
    },
    "VectorDb": {
        "Path": "./data/lancedb",
        "Provider": "LanceDB",
        "VectorSize": 1024
    },
    "Ollama": {
        "Url": "http://localhost:11434",
        "EmbedModel": "bge-m3",
        "ChatModel": "qwen3:4b-instruct-2507-q4_K_M",
        "TimeoutMs": 900000,
        "NumCtx": 32768
    },
    "_prod": { "comment": "measured on a 4-core Skull Canyon + Vega M GL: bge-m3 ingests 16 PDFs in 65s with 7/7 retrieval; qwen3:4b-instruct is the only model with zero false statements but needs TimeoutMs 900000 (broad prompts take 5-11 min). Keep VectorSize 1024 and re-ingest when EmbedModel changes." },
    "Onnx": {
        "EmbeddingModelPath": "./models/bge-micro-v2/onnx/model.onnx",
        "ChatModelPath": "./models/phi-3-mini/cpu-int4"
    },
    "Cache": {
        "DocsMaxAgeSec": 30,
        "EmbedCap": 10000,
        "EmbedTTLHours": 24,
        "Enabled": true
    },
    "Ingest": {
        "MaxConcurrentJobs": 2,
        "MaxSpreadsheetCells": 500000,
        "EmbedBatchSize": 64,
        "ChunkSize": 512,
        "ChunkOverlap": 50,
        "ParentGroupSize": 2,
        "EnableChunkCache": true,
        "ChunkCacheTtl": "01:00:00",
        "MaintenanceInterval": "00:00:30",
        "MaintenanceCleanupOlderThan": "7.00:00:00",
        "VectorIndexThresholdRows": 10000
    },
    "Retrieval": {
        "TopK": 5,
        "MinScore": 0.25,
        "BroadCandidateMultiplier": 4,
        "MaxCandidates": 50
    },
    "Generation": {
        "FallbackToTopChunk": true,
        "FallbackMinScore": 0.3
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*"
}
