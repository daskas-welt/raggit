{
    "Api": {
        "AdminKey": "",
        "EmployeeKey": ""
    },
    "Auth": {
        "JwtSigningKeyPath": "./data/auth.key",
        "TokenLifetimeHours": 8,
        "Pbkdf2Iterations": 310000,
        "LockoutThreshold": 5,
        "LockoutMinutes": 15
    },
    "VectorDb": {
        "Path": "./data/lancedb",
        "Provider": "LanceDB",
        "VectorSize": 1024
    },
    "Ollama": {
        "Url": "http://localhost:11434",
        "EmbedModel": "snowflake-arctic-embed2",
        "ChatModel": "qwen2.5:3b",
        "TimeoutMs": 300000
    },
    "_prod": { "comment": "prod workstation: VectorDb:VectorSize 768 + Ollama:EmbedModel nomic-embed-text + ChatModel llama3.2:3b; non-English libraries (e.g. Greek): VectorSize 1024 + bge-m3 or snowflake-arctic-embed2 + qwen2.5:3b, then re-ingest all documents" },
    "Onnx": {
        "EmbeddingModelPath": "./models/bge-micro-v2/onnx/model.onnx",
        "ChatModelPath": "./models/phi-3-mini/cpu-int4"
    },
    "Cache": {
        "Enabled": true,
        "EmbedCap": 10000,
        "EmbedTTLHours": 24,
        "DocsMaxAgeSec": 30
    },
    "Ingest": {
        "MaxSpreadsheetCells": 500000,
        "EmbedBatchSize": 64,
        "ChunkSize": 512,
        "ChunkOverlap": 50,
        "EnableChunkCache": true,
        "ChunkCacheTtl": "01:00:00"
    },
    "Retrieval": {
        "MinScore": 0.25
    },
    "Generation": {
        "FallbackToTopChunk": true,
        "FallbackMinScore": 0.3
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*"
}
