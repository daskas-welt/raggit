{
  "VectorDb": { "Path": "./data/lancedb", "Provider": "LanceDB", "VectorSize": 384 },
  "Ollama": { "Url": "http://localhost:11434", "EmbedModel": "all-minilm", "ChatModel": "phi3:mini", "TimeoutMs": 120000 },
  "_prod": { "comment": "prod: 768 + nomic-embed-text + llama3.2:3b" },
  "Cache": {
    "Enabled": true,
    "EmbedCap": 1000,
    "EmbedTTLHours": 1,
    "DocsMaxAgeSec": 10
  },
  "Ingest": {
    "EmbedBatchSize": 16,
    "ChunkSize": 512,
    "ChunkOverlap": 50,
    "EnableChunkCache": true,
    "ChunkCacheTtl": "00:10:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
