{
  "VectorDb": { "Path": "./data/lancedb", "Provider": "LanceDB", "VectorSize": 1024 },
  "Ollama": { "Url": "http://localhost:11434", "EmbedModel": "snowflake-arctic-embed2", "ChatModel": "qwen2.5:3b", "TimeoutMs": 300000 },
  "_prod": { "comment": "prod: 768 + nomic-embed-text + llama3.2:3b" },
  "Cache": {
    "Enabled": true,
    "EmbedCap": 1000,
    "EmbedTTLHours": 1,
    "DocsMaxAgeSec": 10
  },
  "Ingest": {
    "MaxSpreadsheetCells": 500000,
    "EmbedBatchSize": 64,
    "ChunkSize": 512,
    "ChunkOverlap": 50,
    "EnableChunkCache": true,
    "ChunkCacheTtl": "00:10:00"
  },
  "Retrieval": {
    "MinScore": 0.25
  },
  "Generation": {
    "FallbackToTopChunk": true,
    "FallbackMinScore": 0.3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
