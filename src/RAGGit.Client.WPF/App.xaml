<Application
    x:Class="RAGGit.Client.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Startup="OnStartup"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- Design-system text styles (feature 023). Adopt these instead of re-declaring attributes. -->
            <Style x:Key="PageTitleText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Title" />
            </Style>
            <Style x:Key="PageSubtitleText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Body" />
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="ui:TextBlock">
                <Setter Property="Appearance" Value="Secondary" />
            </Style>
            <!-- Metadata (counts, dates, helper lines under a row title): a step below Body. -->
            <Style x:Key="MetaText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Caption" />
                <Setter Property="Appearance" Value="Secondary" />
            </Style>
            <!-- Panel/section headline: one step below PageTitleText. Dashboard panels and the
                 selected-person card use this so a section never competes with the page title. -->
            <Style x:Key="PanelHeaderText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Subtitle" />
            </Style>
            <Style x:Key="EmptyStateGlyph" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter
                    Property="Foreground"
                    Value="{ui:ThemeResource TextFillColorSecondaryBrush}"
                />
            </Style>
            <!-- One empty-state hierarchy: the title sits a step below the page title and the
                 body is secondary, wrapped and centred. Panel-level states inside a card keep
                 this body but use SectionHeaderText for the title. -->
            <Style x:Key="EmptyStateTitleText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Subtitle" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="EmptyStateBodyText" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Body" />
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!-- Design-system spacing tokens (feature 028, 4-px scale). Reference
                 these instead of inline literals on affected surfaces. -->
            <Thickness x:Key="PageHeaderCardPadding">16,12</Thickness>
            <Thickness x:Key="CardPaddingSmall">12</Thickness>
            <Thickness x:Key="CardPaddingMedium">20</Thickness>
            <Thickness x:Key="CardPaddingLarge">24</Thickness>
            <sys:Double x:Key="DialogPrimaryButtonMinWidth">136</sys:Double>
            <sys:Double x:Key="DialogSecondaryButtonMinWidth">96</sys:Double>

            <!-- Shared page-level empty state: one surface for every page, capped so the copy wraps
                 in a readable column instead of stretching across the page. It carries no border;
                 BasedOn is still required — a bare Style TargetType="ui:Card" replaces WPF-UI's
                 implicit style and drops the card template, so padding stops rendering too. -->
            <Style
                x:Key="EmptyStateCard"
                TargetType="ui:Card"
                BasedOn="{StaticResource {x:Type ui:Card}}"
            >
                <Setter Property="Padding" Value="{StaticResource CardPaddingLarge}" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Shared page-header treatment: title + supporting line on the left,
                 page actions on the right (Library/History/My Documents/Admin). -->
            <Style x:Key="PageHeaderCard" TargetType="ui:Card">
                <Setter Property="Padding" Value="{StaticResource PageHeaderCardPadding}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
