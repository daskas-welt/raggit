<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
>
    <ScrollViewer
        Padding="0,24"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
    >
        <!-- The header card and the settings rows both span the page, like every other screen. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Standard header card (US5 adds re-check/copy actions to the actions area). -->
            <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Settings" />
                        <ui:TextBlock
                            Style="{StaticResource PageSubtitleText}"
                            Text="Preferences for this client"
                        />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <!-- 32 = the appearance row's trailing inset plus the next section's lead. -->
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Appearance & behavior -->
                <ui:TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionHeaderText}"
                    Text="Appearance &amp; behavior"
                />
                <ui:CardControl
                    Grid.Row="2"
                    AutomationProperties.AutomationId="SettingsRowAppearance"
                >
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="App theme" />
                            <ui:TextBlock
                                Style="{StaticResource MetaText}"
                                TextWrapping="Wrap"
                                Text="Select which app theme to display"
                            />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            Grid.Column="0"
                            x:Name="LightThemeRadio"
                            AutomationProperties.AutomationId="LightThemeRadio"
                            TabIndex="0"
                            VerticalContentAlignment="Center"
                            Content="Light"
                            GroupName="AppTheme"
                            Checked="OnLightThemeChecked"
                        />
                        <RadioButton
                            Grid.Column="2"
                            x:Name="DarkThemeRadio"
                            AutomationProperties.AutomationId="DarkThemeRadio"
                            TabIndex="1"
                            VerticalContentAlignment="Center"
                            Content="Dark"
                            GroupName="AppTheme"
                            Checked="OnDarkThemeChecked"
                        />
                    </Grid>
                </ui:CardControl>

                <!-- Connection -->
                <ui:TextBlock
                    Grid.Row="4"
                    Style="{StaticResource SectionHeaderText}"
                    Text="Connection"
                />
                <ui:CardControl
                    Grid.Row="6"
                    AutomationProperties.AutomationId="SettingsRowConnection"
                >
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Workstation URL" />
                            <ui:TextBlock
                                Style="{StaticResource MetaText}"
                                TextWrapping="Wrap"
                                Text="The AI workstation this client connects to"
                            />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            x:Name="WorkstationUrlText"
                            AutomationProperties.AutomationId="WorkstationUrlValue"
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text="(not configured)"
                        />
                        <ui:Button
                            Grid.Column="2"
                            x:Name="SettingsCopyWorkstationUrlButton"
                            AutomationProperties.AutomationId="SettingsCopyWorkstationUrlButton"
                            AutomationProperties.Name="Copy workstation URL"
                            ToolTip="Copy workstation URL"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Click="OnCopyWorkstationUrlClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:CardControl>
                <ui:CardControl
                    Grid.Row="8"
                    AutomationProperties.AutomationId="SettingsRowSignedInAs"
                >
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Person24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Signed in as" />
                            <ui:TextBlock
                                Style="{StaticResource MetaText}"
                                TextWrapping="Wrap"
                                Text="The account currently using this client"
                            />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            x:Name="SignedInAsText"
                            AutomationProperties.AutomationId="SignedInAsValue"
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Text=""
                        />
                        <ui:Button
                            Grid.Column="2"
                            x:Name="SettingsCopySignedInAsButton"
                            AutomationProperties.AutomationId="SettingsCopySignedInAsButton"
                            AutomationProperties.Name="Copy signed-in account"
                            ToolTip="Copy signed-in account"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Click="OnCopySignedInAsClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:CardControl>
                <ui:CardControl
                    Grid.Row="10"
                    AutomationProperties.AutomationId="SettingsRowConnectionStatus"
                >
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Connection status" />
                            <ui:TextBlock
                                Style="{StaticResource MetaText}"
                                TextWrapping="Wrap"
                                Text="Reachability of the AI workstation"
                            />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            x:Name="ConnectionStatusIcon"
                            Symbol="PlugConnected24"
                            VerticalAlignment="Center"
                        />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ui:TextBlock
                                x:Name="ConnectionStatusText"
                                AutomationProperties.AutomationId="ConnectionStatusValue"
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Text=""
                            />
                            <ui:TextBlock
                                x:Name="ConnectionLastCheckedText"
                                Style="{StaticResource SecondaryText}"
                                Text=""
                            />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="4"
                            x:Name="SettingsRecheckConnectionButton"
                            AutomationProperties.AutomationId="SettingsRecheckConnectionButton"
                            AutomationProperties.Name="Re-check connection"
                            ToolTip="Re-check connection"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Click="OnRecheckConnectionClicked"
                        >
                            <Grid Width="24" Height="24">
                                <ui:SymbolIcon
                                    x:Name="RecheckStatusIcon"
                                    Symbol="ArrowClockwise24"
                                />
                                <ui:ProgressRing
                                    x:Name="RecheckStatusRing"
                                    Width="24"
                                    Height="24"
                                    AutomationProperties.Name="Re-checking connection"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed"
                                />
                            </Grid>
                        </ui:Button>
                    </Grid>
                </ui:CardControl>

                <!-- Session -->
                <ui:TextBlock
                    Grid.Row="12"
                    Style="{StaticResource SectionHeaderText}"
                    Text="Session"
                />
                <ui:CardControl
                    Grid.Row="14"
                    AutomationProperties.AutomationId="SettingsRowSession"
                >
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="SignOut24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="Sign out" />
                            <ui:TextBlock
                                Style="{StaticResource MetaText}"
                                TextWrapping="Wrap"
                                Text="End this session on this device"
                            />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button
                        x:Name="SignOutButton"
                        AutomationProperties.AutomationId="SignOutButton"
                        TabIndex="2"
                        HorizontalAlignment="Left"
                        Appearance="Danger"
                        Content="Sign out"
                        Click="OnSignOutClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="SignOut24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </ui:CardControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
