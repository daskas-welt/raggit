<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    Title="Sign in"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:Card Width="360" Padding="24">
            <StackPanel>
                <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Sign in to RAGGit" />
                <ui:TextBlock
                    Margin="0,8,0,16"
                    Style="{StaticResource PageSubtitleText}"
                    Text="Enter your workstation credentials."
                />

                <ui:TextBox
                    x:Name="UsernameBox"
                    AutomationProperties.AutomationId="UsernameBox"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Username"
                    Margin="0,0,0,12"
                    KeyDown="OnCredentialKeyDown"
                />

                <ui:PasswordBox
                    x:Name="PasswordBox"
                    AutomationProperties.AutomationId="PasswordBox"
                    PlaceholderText="Password"
                    Margin="0,0,0,12"
                    PasswordChanged="OnPasswordChanged"
                    KeyDown="OnCredentialKeyDown"
                />

                <components:StatusFooterControl
                    Margin="0,0,0,12"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    IsOpen="{Binding HasError, Mode=OneWay}"
                    StatusAutomationId="LoginStatusMessage"
                />

                <ui:TextBlock
                    x:Name="LoginProgressText"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    AutomationProperties.AutomationId="LoginProgressText"
                    Text="Signing in…"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                />

                <ui:Button
                    x:Name="SignInButton"
                    AutomationProperties.AutomationId="SignInButton"
                    Appearance="Primary"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <ui:SymbolIcon
                                Symbol="ArrowEnterLeft24"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                            />
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="Signing in"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            />
                        </Grid>
                        <ui:TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Sign in" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
