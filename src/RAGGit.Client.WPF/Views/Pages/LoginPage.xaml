<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    Title="Sign in"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <ui:Card Width="360" Padding="24">
            <!-- The 8px row is the subtitle's former top margin; the 12/16px rows are the
                 summed gutters between the stacked fields (each field held a 0,0,0,12 margin).
                 The status and progress blocks carry their own trailing gutter so a hidden
                 block leaves no gap behind. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock
                    Grid.Row="0"
                    Style="{StaticResource PageTitleText}"
                    Text="Sign in to RAGGit"
                />

                <ui:TextBlock
                    Grid.Row="2"
                    Style="{StaticResource PageSubtitleText}"
                    Text="Enter your workstation credentials."
                />

                <ui:TextBox
                    x:Name="UsernameBox"
                    Grid.Row="4"
                    AutomationProperties.AutomationId="UsernameBox"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Username"
                    KeyDown="OnCredentialKeyDown"
                />

                <ui:PasswordBox
                    x:Name="PasswordBox"
                    Grid.Row="6"
                    AutomationProperties.AutomationId="PasswordBox"
                    PlaceholderText="Password"
                    PasswordChanged="OnPasswordChanged"
                    KeyDown="OnCredentialKeyDown"
                />

                <Grid
                    Grid.Row="8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"
                >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <components:StatusFooterControl
                        Grid.Row="0"
                        Message="{Binding ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        IsOpen="{Binding HasError, Mode=OneWay}"
                        StatusAutomationId="LoginStatusMessage"
                    />
                </Grid>

                <Grid
                    Grid.Row="9"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock
                        x:Name="LoginProgressText"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        AutomationProperties.AutomationId="LoginProgressText"
                        Text="Signing in…"
                    />
                </Grid>

                <ui:Button
                    x:Name="SignInButton"
                    Grid.Row="10"
                    AutomationProperties.AutomationId="SignInButton"
                    Appearance="Primary"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="24" Height="24">
                            <ui:SymbolIcon
                                Symbol="ArrowEnterLeft24"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                            />
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="Signing in"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            />
                        </Grid>
                        <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Sign in" />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
