<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Library"
>
    <Page.Resources>
        <converters:DocumentMimeLabelConverter x:Key="MimeLabel" />
        <converters:SizeMbConverter x:Key="SizeMb" />
        <converters:CreatorLabelConverter x:Key="CreatorLabel" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:DocumentDownloadingConverter x:Key="DocumentDownloading" />
        <!-- Responsive table state (feature 028 US4): the page-owned SizeChanged
             switch in the code-behind replaces these values at content widths
             ≤720 DIPs, so the header row and every realized data row collapse
             and restore together (DynamicResource propagates to template
             instances, including rows realized after the switch). -->
        <GridLength x:Key="LibraryCreatorColumnWidth">130</GridLength>
        <GridLength x:Key="LibraryCreatedColumnWidth">150</GridLength>
        <Visibility x:Key="LibrarySecondaryColumnVisibility">Visible</Visibility>
    </Page.Resources>
    <Grid
        x:Name="LibraryLayout"
        Margin="{StaticResource PagePadding}"
        RowDefinitions="Auto, *, Auto, Auto"
        SizeChanged="OnLibraryLayoutSizeChanged"
    >
        <!-- Header card -->
        <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Document Library" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents available to everyone"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="Refresh documents"
                        Command="{Binding LoadDocumentsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Refresh documents"
                    >
                        <Grid Width="24" Height="24">
                            <ui:SymbolIcon
                                Symbol="ArrowClockwise24"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                            />
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="Refreshing documents"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            />
                        </Grid>
                    </ui:Button>
                    <ui:Button
                        x:Name="UploadButton"
                        Width="44"
                        Height="44"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UploadButton"
                        AutomationProperties.Name="Upload documents"
                        Click="OnUploadClicked"
                        ToolTip="Upload documents"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUpload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Document list surface. A Border rather than the library's Card: the Card style centres
             its content (VerticalContentAlignment=Center, which a local override does not win
             against in 4.3.0's template), floating a short table in the middle of the card. The
             Border fills the row; one horizontal scroller wraps the pinned header and the rows so
             the columns stay aligned, and the ListView owns the vertical scrolling. -->
        <ui:Card
            Grid.Row="1"
            Margin="0,12,0,0"
            VerticalAlignment="Stretch"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
        >
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
            >
                <Grid x:Name="TableGrid" MinWidth="880" RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="{DynamicResource LibraryCreatorColumnWidth}" />
                            <ColumnDefinition Width="{DynamicResource LibraryCreatedColumnWidth}" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Filename"
                        />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Type"
                        />
                        <ui:TextBlock
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Size"
                        />
                        <ui:TextBlock
                            Grid.Column="3"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Status"
                        />
                        <ui:TextBlock
                            Grid.Column="4"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Visibility="{DynamicResource LibrarySecondaryColumnVisibility}"
                            Text="Creator"
                        />
                        <ui:TextBlock
                            Grid.Column="5"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Visibility="{DynamicResource LibrarySecondaryColumnVisibility}"
                            Text="Created"
                        />
                        <Border
                            Grid.ColumnSpan="8"
                            Height="1"
                            IsHitTestVisible="False"
                            VerticalAlignment="Bottom"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                        />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ui:ListView
                            x:Name="DocumentsList"
                            ItemsSource="{Binding PageItems}"
                            SelectionMode="Single"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="DocumentsList"
                            AutomationProperties.Name="Documents"
                        >
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <Grid Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="{DynamicResource LibraryCreatorColumnWidth}" />
                                            <ColumnDefinition Width="{DynamicResource LibraryCreatedColumnWidth}" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Filename}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Converter={StaticResource MimeLabel}}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Converter={StaticResource SizeMb}}"
                                        />
                                        <components:StatusChip
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.HelpText="{Binding FailureReason}"
                                            Status="{Binding Status}"
                                            ToolTip="{Binding FailureReason}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Visibility="{DynamicResource LibrarySecondaryColumnVisibility}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Converter={StaticResource CreatorLabel}}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="5"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Visibility="{DynamicResource LibrarySecondaryColumnVisibility}"
                                            Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                        />
                                        <ui:Button
                                            Grid.Column="6"
                                            Width="44"
                                            Height="44"
                                            Margin="0,0,8,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Download document"
                                            Click="OnDownloadClicked"
                                            ToolTip="Download document"
                                        >
                                            <ui:Button.IsEnabled>
                                                <MultiBinding
                                                    Converter="{StaticResource DocumentDownloading}"
                                                    ConverterParameter="Invert"
                                                >
                                                    <Binding Path="Id" />
                                                    <Binding
                                                        Path="DataContext.DownloadingIds"
                                                        ElementName="DocumentsList"
                                                    />
                                                </MultiBinding>
                                            </ui:Button.IsEnabled>
                                            <Grid Width="24" Height="24">
                                                <ui:SymbolIcon Symbol="ArrowDownload24">
                                                    <ui:SymbolIcon.Visibility>
                                                        <MultiBinding
                                                            Converter="{StaticResource DocumentDownloading}"
                                                            ConverterParameter="Invert"
                                                        >
                                                            <Binding Path="Id" />
                                                            <Binding
                                                                Path="DataContext.DownloadingIds"
                                                                ElementName="DocumentsList"
                                                            />
                                                        </MultiBinding>
                                                    </ui:SymbolIcon.Visibility>
                                                </ui:SymbolIcon>
                                                <ui:ProgressRing
                                                    Width="24"
                                                    Height="24"
                                                    AutomationProperties.Name="Downloading document"
                                                    IsIndeterminate="True"
                                                >
                                                    <ui:ProgressRing.Visibility>
                                                        <MultiBinding Converter="{StaticResource DocumentDownloading}">
                                                            <Binding Path="Id" />
                                                            <Binding
                                                                Path="DataContext.DownloadingIds"
                                                                ElementName="DocumentsList"
                                                            />
                                                        </MultiBinding>
                                                    </ui:ProgressRing.Visibility>
                                                </ui:ProgressRing>
                                            </Grid>
                                        </ui:Button>
                                        <ui:Button
                                            Grid.Column="7"
                                            Width="44"
                                            Height="44"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Delete document"
                                            Click="OnDeleteClicked"
                                            ToolTip="Delete document"
                                            Visibility="{Binding DataContext.IsAdmin, ElementName=DocumentsList, Converter={StaticResource BoolVisibility}}"
                                        >
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <Border
                                            Grid.ColumnSpan="8"
                                            Height="1"
                                            IsHitTestVisible="False"
                                            VerticalAlignment="Bottom"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>

                        <!-- Empty state (ListView has no empty view): sits in the list area, below the
                             pinned header. Gated on IsEmpty (set only by a successful load) so it never
                             shows while loading — overlapping the ProgressRing — or after a failed load. -->
                        <ui:Card
                            Padding="{StaticResource CardPaddingLarge}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                        >
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No documents yet"
                                />
                                <ui:TextBlock
                                    Margin="{StaticResource EmptyStateBodyMargin}"
                                    HorizontalAlignment="Center"
                                    FontTypography="Body"
                                    Style="{StaticResource SecondaryText}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                                    Text="Upload a document to see it here."
                                />
                                <ui:TextBlock
                                    Margin="{StaticResource EmptyStateBodyMargin}"
                                    HorizontalAlignment="Center"
                                    FontTypography="Body"
                                    Style="{StaticResource SecondaryText}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Text="Ask a question to get started, or contact an admin to add documents."
                                />
                            </StackPanel>
                        </ui:Card>

                        <ui:ProgressRing
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Loading documents"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </ui:Card>

        <!-- Pagination footer -->
        <components:PaginationFooterControl
            Grid.Row="2"
            Margin="0,12,0,0"
            VerticalAlignment="Center"
            PageSizeOptions="{Binding PageSizeOptions}"
            SelectedPageSize="{Binding PageSize, Mode=TwoWay}"
            StatusText="{Binding StatusText}"
            Sequence="{Binding VisibleSequence}"
            GoToCommand="{Binding GoToPageCommand}"
            FirstCommand="{Binding FirstPageCommand}"
            PreviousCommand="{Binding PreviousPageCommand}"
            NextCommand="{Binding NextPageCommand}"
            LastCommand="{Binding LastPageCommand}"
            CanGoPrevious="{Binding HasPrevious}"
            CanGoNext="{Binding HasNext}"
        />

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="3"
            Margin="0,12,0,0"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RetryCommand}"
            RetryContent="Retry"
            RetryAutomationId="LibraryRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
