<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Library"
>
    <Page.Resources>
        <converters:DocumentMimeLabelConverter x:Key="MimeLabel" />
        <converters:SizeMbConverter x:Key="SizeMb" />
        <converters:CreatorLabelConverter x:Key="CreatorLabel" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:DocumentDownloadingConverter x:Key="DocumentDownloading" />
    </Page.Resources>
    <Grid
        x:Name="LibraryLayout"
        Margin="{StaticResource PagePadding}"
        RowDefinitions="Auto, Auto, *, Auto, Auto"
        SizeChanged="OnLibraryLayoutSizeChanged"
    >
        <!-- Header card -->
        <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Document Library" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents available to everyone"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                    <ui:Button
                        x:Name="UploadButton"
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UploadButton"
                        AutomationProperties.Name="Upload documents"
                        Click="OnUploadClicked"
                        ToolTip="Upload documents"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUpload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Width="44"
                        Height="44"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="Refresh documents"
                        Command="{Binding LoadDocumentsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Refresh documents"
                    >
                        <Grid Width="24" Height="24">
                            <ui:SymbolIcon
                                Symbol="ArrowClockwise24"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                            />
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="Refreshing documents"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            />
                        </Grid>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Search (feature 029): filters the loaded list as the user types. -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*, Auto, Auto">
            <ui:TextBox
                x:Name="LibrarySearchBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="LibrarySearchBox"
                AutomationProperties.Name="Search documents"
                PlaceholderText="Search documents"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />
            <ui:Button
                x:Name="LibrarySearchClearButton"
                Grid.Column="1"
                Width="44"
                Height="44"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LibrarySearchClearButton"
                AutomationProperties.Name="Clear document search"
                ToolTip="Clear search"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Click="OnClearSearchClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock
                x:Name="LibraryMatchCount"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                AutomationProperties.AutomationId="LibraryMatchCount"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Text="{Binding MatchCaption}"
            />
        </Grid>

        <!-- Document list surface. A WPF-UI DataGrid owns the column headers, row
             painting and both scrollbars, replacing the hand-rolled pinned-header
             ListView. The grid scrolls horizontally when the fixed columns plus the
             Filename minimum no longer fit; at content widths ≤720 DIPs the page
             hides the secondary columns (see ApplyResponsiveLayout) so Filename,
             Status and the row actions fit without horizontal scrolling. -->
        <ui:Card
            Grid.Row="2"
            Margin="0,12,0,0"
            VerticalAlignment="Stretch"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
        >
            <Grid x:Name="TableGrid">
                <ui:DataGrid
                    x:Name="DocumentsGrid"
                    ItemsSource="{Binding PageItems}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0"
                    Background="Transparent"
                    RowHeight="68"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="DocumentsList"
                    AutomationProperties.Name="Documents"
                >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Filename" Width="*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:TextBlock
                                        Margin="16,0,8,0"
                                        FontTypography="Body"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Filename}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="TypeColumn" Header="Type" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:TextBlock
                                        FontTypography="Body"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Converter={StaticResource MimeLabel}}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="SizeColumn" Header="Size" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:TextBlock
                                        FontTypography="Body"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding Converter={StaticResource SizeMb}}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <components:StatusChip
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{Binding FailureReason}"
                                        Status="{Binding Status}"
                                        ToolTip="{Binding FailureReason}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="CreatorColumn" Header="Creator" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:TextBlock
                                        FontTypography="Body"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryText}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Converter={StaticResource CreatorLabel}}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="CreatedColumn" Header="Created" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:TextBlock
                                        FontTypography="Body"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryText}"
                                        Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                    />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:Button
                                        Width="44"
                                        Height="44"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Download document"
                                        Click="OnDownloadClicked"
                                        ToolTip="Download document"
                                    >
                                        <ui:Button.IsEnabled>
                                            <MultiBinding
                                                Converter="{StaticResource DocumentDownloading}"
                                                ConverterParameter="Invert"
                                            >
                                                <Binding Path="Id" />
                                                <Binding
                                                    Path="DataContext.DownloadingIds"
                                                    RelativeSource="{RelativeSource AncestorType=DataGrid}"
                                                />
                                            </MultiBinding>
                                        </ui:Button.IsEnabled>
                                        <Grid Width="24" Height="24">
                                            <ui:SymbolIcon Symbol="ArrowDownload24">
                                                <ui:SymbolIcon.Visibility>
                                                    <MultiBinding
                                                        Converter="{StaticResource DocumentDownloading}"
                                                        ConverterParameter="Invert"
                                                    >
                                                        <Binding Path="Id" />
                                                        <Binding
                                                            Path="DataContext.DownloadingIds"
                                                            RelativeSource="{RelativeSource AncestorType=DataGrid}"
                                                        />
                                                    </MultiBinding>
                                                </ui:SymbolIcon.Visibility>
                                            </ui:SymbolIcon>
                                            <ui:ProgressRing
                                                Width="24"
                                                Height="24"
                                                AutomationProperties.Name="Downloading document"
                                                IsIndeterminate="True"
                                            >
                                                <ui:ProgressRing.Visibility>
                                                    <MultiBinding Converter="{StaticResource DocumentDownloading}">
                                                        <Binding Path="Id" />
                                                        <Binding
                                                            Path="DataContext.DownloadingIds"
                                                            RelativeSource="{RelativeSource AncestorType=DataGrid}"
                                                        />
                                                    </MultiBinding>
                                                </ui:ProgressRing.Visibility>
                                            </ui:ProgressRing>
                                        </Grid>
                                    </ui:Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <ui:Button
                                        Width="44"
                                        Height="44"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Delete document"
                                        Click="OnDeleteClicked"
                                        ToolTip="Delete document"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolVisibility}}"
                                    >
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>

                <!-- Empty state (DataGrid has no empty view): sits in the list area,
                     below the headers. Gated on IsEmpty (set only by a successful
                     load) so it never shows while loading — overlapping the
                     ProgressRing — or after a failed load. -->
                <ui:Card
                    Padding="{StaticResource CardPaddingLarge}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
                >
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Document24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,12"
                        />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            FontTypography="Title"
                            Text="No documents yet"
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            FontTypography="Body"
                            Style="{StaticResource SecondaryText}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                            Text="Upload a document to see it here."
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            FontTypography="Body"
                            Style="{StaticResource SecondaryText}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Text="Ask a question to get started, or contact an admin to add documents."
                        />
                    </StackPanel>
                </ui:Card>

                <ui:ProgressRing
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Loading documents"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                />

                <!-- No-match state: distinct from the no-records state above, which wins
                     when the library is genuinely empty (clearing the search would not help). -->
                <ui:Card
                    x:Name="LibraryNoMatchState"
                    Padding="{StaticResource CardPaddingLarge}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="LibraryNoMatchState"
                >
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding IsSearchActive}"
                                            Value="True"
                                        />
                                        <Condition Binding="{Binding HasMatch}" Value="False" />
                                        <Condition Binding="{Binding IsEmpty}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Search24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,12"
                        />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            FontTypography="Title"
                            Text="No matching documents"
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            FontTypography="Body"
                            Style="{StaticResource SecondaryText}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Text="Nothing matches your search."
                        />
                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Clear document search"
                            Content="Clear search"
                            Click="OnClearSearchClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </ui:Card>

        <!-- Pagination footer -->
        <components:PaginationFooterControl
            Grid.Row="3"
            Margin="0,12,0,0"
            VerticalAlignment="Center"
            PageSizeOptions="{Binding PageSizeOptions}"
            SelectedPageSize="{Binding PageSize, Mode=TwoWay}"
            StatusText="{Binding StatusText}"
            Sequence="{Binding VisibleSequence}"
            GoToCommand="{Binding GoToPageCommand}"
            FirstCommand="{Binding FirstPageCommand}"
            PreviousCommand="{Binding PreviousPageCommand}"
            NextCommand="{Binding NextPageCommand}"
            LastCommand="{Binding LastPageCommand}"
            CanGoPrevious="{Binding HasPrevious}"
            CanGoNext="{Binding HasNext}"
        />

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="4"
            Margin="0,12,0,0"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RetryCommand}"
            RetryContent="Retry"
            RetryAutomationId="LibraryRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
