<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Library"
>
    <Page.Resources>
        <converters:DocumentMimeLabelConverter x:Key="MimeLabel" />
        <converters:SizeMbConverter x:Key="SizeMb" />
        <converters:CreatorLabelConverter x:Key="CreatorLabel" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullVisibility" />
    </Page.Resources>
    <Grid Margin="0,24" RowDefinitions="Auto, *, Auto, Auto">
        <!-- Header card -->
        <ui:Card Grid.Row="0" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Document Library" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents available to everyone"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="Refresh documents"
                        Command="{Binding LoadDocumentsCommand}"
                        ToolTip="Refresh documents"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="UploadButton"
                        Width="44"
                        Height="44"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UploadButton"
                        AutomationProperties.Name="Upload documents"
                        Click="OnUploadClicked"
                        ToolTip="Upload documents"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowUpload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Document list surface. A Border rather than the library's Card: the Card style centres
             its content (VerticalContentAlignment=Center, which a local override does not win
             against in 4.3.0's template), floating a short table in the middle of the card. The
             Border fills the row; one horizontal scroller wraps the pinned header and the rows so
             the columns stay aligned, and the ListView owns the vertical scrolling. -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            VerticalAlignment="Stretch"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ControlCornerRadius}"
        >
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
            >
                <Grid MinWidth="880" RowDefinitions="Auto, *">
                    <Grid
                        Grid.Row="0"
                        Margin="16,12"
                        ColumnDefinitions="*, 70, 90, 120, 130, 150, 44, 44"
                    >
                        <ui:TextBlock
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Filename"
                        />
                        <ui:TextBlock
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Type"
                        />
                        <ui:TextBlock
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Size"
                        />
                        <ui:TextBlock
                            Grid.Column="3"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Status"
                        />
                        <ui:TextBlock
                            Grid.Column="4"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Creator"
                        />
                        <ui:TextBlock
                            Grid.Column="5"
                            Margin="0,0,12,0"
                            FontTypography="Caption"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Created"
                        />
                        <Border
                            Grid.ColumnSpan="8"
                            Height="1"
                            IsHitTestVisible="False"
                            VerticalAlignment="Bottom"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                        />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ui:ListView
                            x:Name="DocumentsList"
                            ItemsSource="{Binding PageItems}"
                            SelectionMode="Single"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="DocumentsList"
                            AutomationProperties.Name="Documents"
                        >
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Document}">
                                    <Grid
                                        Margin="16,12"
                                        ColumnDefinitions="*, 70, 90, 120, 130, 150, 44, 44"
                                    >
                                        <ui:TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Filename}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Converter={StaticResource MimeLabel}}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding Converter={StaticResource SizeMb}}"
                                        />
                                        <components:StatusChip
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.HelpText="{Binding FailureReason}"
                                            Status="{Binding Status}"
                                            ToolTip="{Binding FailureReason}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Converter={StaticResource CreatorLabel}}"
                                        />
                                        <ui:TextBlock
                                            Grid.Column="5"
                                            Margin="0,0,12,0"
                                            FontTypography="Body"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryText}"
                                            Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                        />
                                        <ui:Button
                                            Grid.Column="6"
                                            Width="36"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Download document"
                                            Click="OnDownloadClicked"
                                            ToolTip="Download document"
                                        >
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Grid.Column="7"
                                            Width="36"
                                            Height="32"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Delete document"
                                            Click="OnDeleteClicked"
                                            ToolTip="Delete document"
                                            Visibility="{Binding DataContext.IsAdmin, ElementName=DocumentsList, Converter={StaticResource BoolVisibility}}"
                                        >
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <Border
                                            Grid.ColumnSpan="8"
                                            Height="1"
                                            IsHitTestVisible="False"
                                            VerticalAlignment="Bottom"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>

                        <!-- Empty state (ListView has no empty view): sits in the list area, below the pinned header -->
                        <ui:Card
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PageItems, Converter={StaticResource EmptyListVisibility}}"
                        >
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No documents yet"
                                />
                                <ui:TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontTypography="Body"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Upload a document to see it here."
                                />
                            </StackPanel>
                        </ui:Card>

                        <ui:ProgressRing
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Loading documents"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Pagination footer -->
        <components:PaginationFooterControl
            Grid.Row="2"
            Margin="0,12,0,0"
            VerticalAlignment="Center"
            PageSizeOptions="{Binding PageSizeOptions}"
            SelectedPageSize="{Binding PageSize, Mode=TwoWay}"
            StatusText="{Binding StatusText}"
            Sequence="{Binding VisibleSequence}"
            GoToCommand="{Binding GoToPageCommand}"
            FirstCommand="{Binding FirstPageCommand}"
            PreviousCommand="{Binding PreviousPageCommand}"
            NextCommand="{Binding NextPageCommand}"
            LastCommand="{Binding LastPageCommand}"
            CanGoPrevious="{Binding HasPrevious}"
            CanGoNext="{Binding HasNext}"
        />

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*, Auto">
            <Grid
                Grid.Column="0"
                VerticalAlignment="Center"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullVisibility}}"
                ColumnDefinitions="Auto, *"
            >
                <ui:SymbolIcon
                    Grid.Column="0"
                    Symbol="ErrorCircle24"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                />
                <ui:TextBlock
                    Grid.Column="1"
                    FontTypography="Body"
                    VerticalAlignment="Center"
                    Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Text="{Binding ErrorMessage}"
                />
            </Grid>
            <ui:Button
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="LibraryRetryButton"
                AutomationProperties.Name="Retry loading library"
                Command="{Binding RetryCommand}"
                Content="Retry"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullVisibility}}"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Grid>
</Page>
