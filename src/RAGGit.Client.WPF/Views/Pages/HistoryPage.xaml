<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="History"
>
    <Page.Resources>
        <converters:HistoryMetaConverter x:Key="HistoryMeta" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto, Auto, *, Auto, Auto">
        <!-- Header card -->
        <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Query History" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Your past questions"
                    />
                </StackPanel>
                <ui:Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh history"
                    ToolTip="Refresh history"
                    TabIndex="0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon
                            Symbol="ArrowClockwise24"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                        />
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="Refreshing history"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Search (feature 029): filters the loaded questions as the user types. -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*, Auto, Auto">
            <ui:TextBox
                x:Name="HistorySearchBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="HistorySearchBox"
                AutomationProperties.Name="Search questions"
                PlaceholderText="Search questions"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />
            <ui:Button
                x:Name="HistorySearchClearButton"
                Grid.Column="1"
                Width="44"
                Height="44"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="HistorySearchClearButton"
                AutomationProperties.Name="Clear question search"
                ToolTip="Clear search"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Click="OnClearSearchClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock
                x:Name="HistoryMatchCount"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                AutomationProperties.AutomationId="HistoryMatchCount"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Text="{Binding MatchCaption}"
            />
        </Grid>

        <!-- History list -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:ListView
                x:Name="HistoryList"
                ItemsSource="{Binding FilteredItems}"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                MouseDoubleClick="OnListDoubleClicked"
            >
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="{StaticResource CardPaddingSmall}">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                                <ui:TextBlock
                                    Grid.Row="0"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding PromptPreview}"
                                />
                                <ui:TextBlock
                                    Grid.Row="1"
                                    FontTypography="Body"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding AnswerPreview}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Margin="0,4,0,0"
                                    FontTypography="Caption"
                                    Text="{Binding Converter={StaticResource HistoryMeta}}"
                                />
                                <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal">
                                    <ui:Button
                                        AutomationProperties.AutomationId="ViewQueryButton"
                                        AutomationProperties.Name="Open query detail"
                                        ToolTip="Open query detail"
                                        Margin="0,0,8,0"
                                        Content="View"
                                        Click="OnViewClicked"
                                    >
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Eye24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button
                                        AutomationProperties.AutomationId="AskAgainButton"
                                        AutomationProperties.Name="Run this query again"
                                        ToolTip="Run this query again"
                                        Content="Ask again"
                                        Click="OnAskAgainClicked"
                                    >
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- Empty state card -->
            <ui:Card
                Padding="{StaticResource CardPaddingLarge}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="History24"
                        Style="{StaticResource EmptyStateGlyph}"
                        Margin="0,0,0,12"
                    />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontTypography="Title"
                        Text="No queries yet"
                    />
                    <ui:TextBlock
                        Margin="{StaticResource EmptyStateBodyMargin}"
                        HorizontalAlignment="Center"
                        FontTypography="Body"
                        Text="Ask a question to see it here."
                    />
                </StackPanel>
            </ui:Card>

            <ui:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading history"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />

            <!-- No-match state: distinct from the no-records state above, which wins when
                 there are genuinely no questions (clearing the search would not help). -->
            <ui:Card
                x:Name="HistoryNoMatchState"
                Padding="{StaticResource CardPaddingLarge}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="HistoryNoMatchState"
            >
                <ui:Card.Style>
                    <Style TargetType="ui:Card">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSearchActive}" Value="True" />
                                    <Condition Binding="{Binding HasMatch}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="Search24"
                        Style="{StaticResource EmptyStateGlyph}"
                        Margin="0,0,0,12"
                    />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontTypography="Title"
                        Text="No matching questions"
                    />
                    <ui:TextBlock
                        Margin="{StaticResource EmptyStateBodyMargin}"
                        HorizontalAlignment="Center"
                        FontTypography="Body"
                        Style="{StaticResource SecondaryText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Text="Nothing loaded matches your search. Load more to search further back."
                    />
                    <ui:Button
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Clear question search"
                        Content="Clear search"
                        Click="OnClearSearchClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Load more -->
        <ui:Button
            x:Name="LoadMoreButton"
            Grid.Row="3"
            AutomationProperties.AutomationId="LoadMoreButton"
            TabIndex="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Command="{Binding LoadMoreCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                    <ui:SymbolIcon
                        Symbol="ArrowDown24"
                        Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                    />
                    <ui:ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Loading more history"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    />
                </Grid>
                <ui:TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Load more" />
            </StackPanel>
        </ui:Button>

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="4"
            Margin="0,12,0,0"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RefreshCommand}"
            RetryContent="Retry"
            RetryAutomationId="HistoryRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
