<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="History"
>
    <Page.Resources>
        <converters:HistoryMetaConverter x:Key="HistoryMeta" />
        <converters:ResponsiveColumnCountConverter x:Key="HistoryColumns" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid>
        <!-- The 24px outer rows carry the former PagePadding inset of this root grid. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Header card -->
        <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Query History" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Your past questions"
                    />
                </StackPanel>
                <ui:Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh history"
                    ToolTip="Refresh history"
                    TabIndex="0"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon
                            Symbol="ArrowClockwise24"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                        />
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="Refreshing history"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Search (feature 029): filters the loaded questions as the user types. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                x:Name="HistorySearchBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="HistorySearchBox"
                AutomationProperties.Name="Search questions"
                PlaceholderText="Search questions"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />
            <ui:Button
                x:Name="HistorySearchClearButton"
                Grid.Column="2"
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="HistorySearchClearButton"
                AutomationProperties.Name="Clear question search"
                ToolTip="Clear search"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Click="OnClearSearchClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock
                x:Name="HistoryMatchCount"
                Grid.Column="4"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                AutomationProperties.AutomationId="HistoryMatchCount"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Text="{Binding MatchCaption}"
            />
        </Grid>

        <!-- History list -->
        <Grid Grid.Row="5">
            <ui:ListView
                x:Name="HistoryList"
                ItemsSource="{Binding FilteredItems}"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                MouseDoubleClick="OnListDoubleClicked"
            >
                <ui:ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- UniformGrid splits whatever height it is arranged into evenly across
                             its rows. Pinning it to the top keeps it at its content height so rows
                             hug the cards instead of spanning the whole viewport. -->
                        <UniformGrid
                            VerticalAlignment="Top"
                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource HistoryColumns}, FallbackValue=3}"
                        />
                    </ItemsPanelTemplate>
                </ui:ListView.ItemsPanel>
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <!-- Item spacing in the UniformGrid panel has no Grid tracks. -->
                        <Setter Property="Margin" Value="0,0,12,12" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="{StaticResource CardPaddingSmall}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Grid.Row="0"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding PromptPreview}"
                                />
                                <ui:TextBlock
                                    Grid.Row="1"
                                    FontTypography="Body"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding AnswerPreview}"
                                />
                                <ui:TextBlock
                                    Grid.Row="3"
                                    FontTypography="Caption"
                                    Text="{Binding Converter={StaticResource HistoryMeta}}"
                                />
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="ViewQueryButton"
                                        AutomationProperties.Name="Open query detail"
                                        ToolTip="Open query detail"
                                        Content="View"
                                        Click="OnViewClicked"
                                    >
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Eye24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="AskAgainButton"
                                        AutomationProperties.Name="Run this query again"
                                        ToolTip="Run this query again"
                                        Content="Ask again"
                                        Click="OnAskAgainClicked"
                                    >
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- Empty state card -->
            <ui:Card
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource EmptyStateCard}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="HistoryEmptyState"
                AutomationProperties.Name="No queries yet"
            >
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon
                        Grid.Row="0"
                        Symbol="History24"
                        Style="{StaticResource EmptyStateGlyph}"
                    />
                    <ui:TextBlock
                        Grid.Row="2"
                        Style="{StaticResource EmptyStateTitleText}"
                        Text="No queries yet"
                    />
                    <ui:TextBlock
                        Grid.Row="4"
                        Style="{StaticResource EmptyStateBodyText}"
                        Text="Ask a question to see it here."
                    />
                    <ui:Button
                        Grid.Row="6"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Ask a question"
                        Content="Ask a question"
                        ToolTip="Ask a question"
                        Click="OnAskQuestionClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Chat24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <ui:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading history"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />

            <!-- No-match state: distinct from the no-records state above, which wins when
                 there are genuinely no questions (clearing the search would not help). -->
            <ui:Card
                x:Name="HistoryNoMatchState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="HistoryNoMatchState"
            >
                <ui:Card.Style>
                    <Style TargetType="ui:Card" BasedOn="{StaticResource EmptyStateCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSearchActive}" Value="True" />
                                    <Condition Binding="{Binding HasMatch}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon
                        Grid.Row="0"
                        Symbol="Search24"
                        Style="{StaticResource EmptyStateGlyph}"
                    />
                    <ui:TextBlock
                        Grid.Row="2"
                        Style="{StaticResource EmptyStateTitleText}"
                        Text="No matching questions"
                    />
                    <ui:TextBlock
                        Grid.Row="4"
                        Style="{StaticResource EmptyStateBodyText}"
                        Text="Nothing loaded matches your search. Load more to search further back."
                    />
                    <ui:Button
                        Grid.Row="6"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Clear question search"
                        Content="Clear search"
                        Click="OnClearSearchClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Load more -->
        <ui:Button
            x:Name="LoadMoreButton"
            Grid.Row="7"
            AutomationProperties.AutomationId="LoadMoreButton"
            TabIndex="1"
            HorizontalAlignment="Center"
            Command="{Binding LoadMoreCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="24" Height="24">
                    <ui:SymbolIcon
                        Symbol="ArrowDown24"
                        Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                    />
                    <ui:ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Loading more history"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    />
                </Grid>
                <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Load more" />
            </Grid>
        </ui:Button>

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="9"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RefreshCommand}"
            RetryContent="Retry"
            RetryAutomationId="HistoryRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
