<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ask"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
        <ObjectDataProvider
            x:Key="QueryModes"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}"
        >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:QueryMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <!-- Outer page inset; was the root PagePadding (0,24) margin. -->
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- Header card -->
            <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock
                            Style="{StaticResource PageTitleText}"
                            Text="Ask the Library"
                        />
                        <ui:TextBlock
                            Style="{StaticResource PageSubtitleText}"
                            Text="Find grounded answers with citations"
                        />
                    </StackPanel>
                    <!-- Actions area (US3 adds the Clear-conversation action here). -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontTypography="Caption"
                            Text="Mode"
                        />
                        <ComboBox
                            Grid.Column="2"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding Source={StaticResource QueryModes}}"
                            SelectedItem="{Binding QueryMode, Mode=TwoWay}"
                            AutomationProperties.AutomationId="QueryModeCombo"
                            AutomationProperties.Name="Query intent mode"
                            ToolTip="Auto lets the server decide; Broad forces synthesis context; Specific forces granular facts"
                        />
                        <ui:Button
                            Grid.Column="4"
                            x:Name="QueryClearConversationButton"
                            AutomationProperties.AutomationId="QueryClearConversationButton"
                            AutomationProperties.Name="Clear conversation"
                            ToolTip="Clear conversation"
                            Content="Clear"
                            Click="OnClearConversationClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- Chat -->
            <components:ChatControl
                x:Name="Chat"
                Grid.Row="3"
                Messages="{Binding Messages}"
                InputText="{Binding QueryText, Mode=TwoWay}"
                SendCommand="{Binding AskCommand}"
                IsBusy="{Binding IsBusy}"
                ReasoningSteps="{Binding ReasoningSteps}"
                HasReasoning="{Binding HasReasoning}"
            />

            <!-- Did-you-mean suggestion chips -->
            <ui:Card
                Grid.Row="5"
                Padding="12"
                Visibility="{Binding HasSuggestedPersons, Converter={StaticResource BoolVisibility}}"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="Did you mean?" />
                    <ItemsControl
                        x:Name="SuggestionChips"
                        Grid.Row="2"
                        ItemsSource="{Binding SuggestedPersons}"
                        AutomationProperties.AutomationId="SuggestionChips"
                    >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PersonSuggestion}">
                                <!-- Chip inset: the 8px trailing/bottom gutter keeps wrapped
                                     chips apart without a Margin. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                    </Grid.RowDefinitions>
                                    <ui:Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Appearance="Primary"
                                        AutomationProperties.AutomationId="SuggestionChipButton"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding ElementName=SuggestionChips, Path=DataContext.UseSuggestedPersonCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ui:Card>

            <!-- Status -->
            <ui:InfoBar
                Grid.Row="7"
                Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}}"
                IsClosable="False"
                IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
                Message="{Binding StatusMessage, Mode=OneWay}"
            />
        </Grid>
    </Grid>
</Page>
