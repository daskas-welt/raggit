<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DocumentCreationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Create Document"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Outer page inset. -->
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
            <StackPanel VerticalAlignment="Center">
                <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Create Document" />
                <ui:TextBlock
                    Style="{StaticResource PageSubtitleText}"
                    Text="Describe what you need and choose a format"
                />
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0" Text="What should the document contain?" />

                <TextBox
                    x:Name="DescriptionBox"
                    Grid.Row="2"
                    MinHeight="140"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="DocumentCreationDescription"
                    AutomationProperties.Name="Document description"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                />

                <ui:TextBlock Grid.Row="4" Text="Document format" />

                <ComboBox
                    x:Name="FormatBox"
                    Grid.Row="6"
                    AutomationProperties.AutomationId="DocumentCreationFormat"
                    AutomationProperties.Name="Document format"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    ItemsSource="{Binding Formats}"
                    SelectedValue="{Binding SelectedFormat, Mode=TwoWay}"
                    SelectedValuePath="Format"
                />

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        AutomationProperties.AutomationId="CreateDocumentButton"
                        AutomationProperties.Name="Create document"
                        Appearance="Primary"
                        Command="{Binding CreateDocumentCommand}"
                        Content="Create document"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:ProgressRing
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        AutomationProperties.AutomationId="DocumentCreationProgressRing"
                        AutomationProperties.Name="Creating document"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    />

                    <ui:Button
                        Grid.Column="4"
                        AutomationProperties.AutomationId="CancelDocumentCreationButton"
                        AutomationProperties.Name="Cancel document creation"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <Grid
                    Grid.Row="10"
                    Visibility="{Binding HasSavedFile, Converter={StaticResource BoolVisibility}}"
                >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0" Text="Saved to:" />
                    <ui:TextBlock
                        Grid.Column="2"
                        Text="{Binding SavedPath}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                    />
                    <ui:Button
                        Grid.Column="4"
                        AutomationProperties.AutomationId="OpenCreatedDocumentButton"
                        AutomationProperties.Name="Open created document"
                        Command="{Binding OpenDocumentCommand}"
                        Content="Open"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Open24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Grid>
        </ui:Card>

        <ui:InfoBar
            Grid.Row="5"
            AutomationProperties.AutomationId="DocumentCreationStatusInfoBar"
            IsClosable="False"
            IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
            Severity="Informational"
        />
    </Grid>
</Page>
