<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DocumentsMinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="My Documents"
>
    <Page.Resources>
        <converters:MineMetaConverter x:Key="MineMeta" />
        <converters:NullToVisibilityConverter x:Key="NullVisibility" />
    </Page.Resources>
    <Grid Margin="0,24" RowDefinitions="Auto, *, Auto, Auto">
        <!-- Header card -->
        <ui:Card Grid.Row="0" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="My Documents" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents you uploaded"
                    />
                </StackPanel>
                <ui:Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh documents"
                    ToolTip="Refresh documents"
                    TabIndex="0"
                    VerticalAlignment="Center"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Document list -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ui:ListView
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            >
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="12">
                            <Grid RowDefinitions="Auto, Auto">
                                <ui:TextBlock
                                    Grid.Row="0"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Filename}"
                                />
                                <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                                    <components:StatusChip
                                        Status="{Binding Status}"
                                        VerticalAlignment="Center"
                                    />
                                    <ui:TextBlock
                                        Margin="8,0,0,0"
                                        FontTypography="Caption"
                                        VerticalAlignment="Center"
                                        Text="{Binding Converter={StaticResource MineMeta}}"
                                    />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- Empty state card -->
            <ui:Card
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="Document24"
                        Style="{StaticResource EmptyStateGlyph}"
                        Margin="0,0,0,12"
                    />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontTypography="Title"
                        Text="No documents yet"
                    />
                    <ui:TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontTypography="Body"
                        Text="Upload a document to see it here."
                    />
                </StackPanel>
            </ui:Card>

            <ui:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading your documents"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />
        </Grid>

        <!-- Load more -->
        <ui:Button
            x:Name="LoadMoreButton"
            Grid.Row="2"
            AutomationProperties.AutomationId="LoadMoreButton"
            TabIndex="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Content="Load more"
            Command="{Binding LoadMoreCommand}"
            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDown24" />
            </ui:Button.Icon>
        </ui:Button>

        <!-- Footer -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,0"
            Visibility="{Binding ErrorMessage, Converter={StaticResource NullVisibility}}"
            ColumnDefinitions="Auto, *"
        >
            <ui:SymbolIcon
                Grid.Column="0"
                Symbol="ErrorCircle24"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
            />
            <ui:TextBlock
                Grid.Column="1"
                FontTypography="Body"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                Text="{Binding ErrorMessage}"
            />
        </Grid>
    </Grid>
</Page>
