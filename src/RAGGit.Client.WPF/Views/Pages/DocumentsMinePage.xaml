<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DocumentsMinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="My Documents"
>
    <Page.Resources>
        <converters:MineMetaConverter x:Key="MineMeta" />
        <converters:ResponsiveColumnCountConverter x:Key="DocumentsMineColumns" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid>
        <!-- The 24px outer rows carry the former PagePadding inset of this root grid;
             the 12px rows are the gutters between the stacked sections. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Header card -->
        <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="My Documents" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents you uploaded"
                    />
                </StackPanel>
                <ui:Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh documents"
                    ToolTip="Refresh documents"
                    TabIndex="0"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon
                            Symbol="ArrowClockwise24"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                        />
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="Refreshing documents"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Search (feature 029): filters the loaded uploads as the user types. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                x:Name="DocumentsMineSearchBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="DocumentsMineSearchBox"
                AutomationProperties.Name="Search my documents"
                PlaceholderText="Search my documents"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            />
            <ui:Button
                x:Name="DocumentsMineSearchClearButton"
                Grid.Column="2"
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="DocumentsMineSearchClearButton"
                AutomationProperties.Name="Clear my documents search"
                ToolTip="Clear search"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Click="OnClearSearchClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBlock
                x:Name="DocumentsMineMatchCount"
                Grid.Column="4"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                AutomationProperties.AutomationId="DocumentsMineMatchCount"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVisibility}}"
                Text="{Binding MatchCaption}"
            />
        </Grid>

        <!-- Document list -->
        <Grid Grid.Row="5">
            <ui:ListView
                ItemsSource="{Binding FilteredItems}"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            >
                <ui:ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- UniformGrid splits whatever height it is arranged into evenly across
                             its rows. Pinning it to the top keeps it at its content height so rows
                             hug the cards instead of spanning the whole viewport. -->
                        <UniformGrid
                            VerticalAlignment="Top"
                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource DocumentsMineColumns}, ConverterParameter=4, FallbackValue=4}"
                        />
                    </ItemsPanelTemplate>
                </ui:ListView.ItemsPanel>
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <!-- Item spacing in the UniformGrid panel has no Grid tracks. -->
                        <Setter Property="Margin" Value="0,0,12,12" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="{StaticResource CardPaddingSmall}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Grid.Row="0"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Filename}"
                                />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <components:StatusChip
                                        Grid.Column="0"
                                        Status="{Binding Status}"
                                        VerticalAlignment="Center"
                                    />
                                    <ui:TextBlock
                                        Grid.Column="2"
                                        FontTypography="Caption"
                                        VerticalAlignment="Center"
                                        Text="{Binding Converter={StaticResource MineMeta}}"
                                    />
                                </Grid>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- Empty state card -->
            <ui:Card
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource EmptyStateCard}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="DocumentsMineEmptyState"
                AutomationProperties.Name="No documents yet"
            >
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon
                        Grid.Row="0"
                        Symbol="Document24"
                        Style="{StaticResource EmptyStateGlyph}"
                    />
                    <ui:TextBlock
                        Grid.Row="2"
                        Style="{StaticResource EmptyStateTitleText}"
                        Text="No documents yet"
                    />
                    <ui:TextBlock
                        Grid.Row="4"
                        Style="{StaticResource EmptyStateBodyText}"
                        Text="Documents you upload from the library appear here."
                    />
                    <ui:Button
                        Grid.Row="6"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Open the library"
                        Content="Open the library"
                        ToolTip="Open the library"
                        Click="OnOpenLibraryClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Library24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <ui:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading your documents"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />

            <!-- No-match state: distinct from the no-records state above, which wins when
                 there are genuinely no uploads (clearing the search would not help). -->
            <ui:Card
                x:Name="DocumentsMineNoMatchState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="DocumentsMineNoMatchState"
            >
                <ui:Card.Style>
                    <Style TargetType="ui:Card" BasedOn="{StaticResource EmptyStateCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSearchActive}" Value="True" />
                                    <Condition Binding="{Binding HasMatch}" Value="False" />
                                    <Condition Binding="{Binding IsEmpty}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:SymbolIcon
                        Grid.Row="0"
                        Symbol="Search24"
                        Style="{StaticResource EmptyStateGlyph}"
                    />
                    <ui:TextBlock
                        Grid.Row="2"
                        Style="{StaticResource EmptyStateTitleText}"
                        Text="No matching documents"
                    />
                    <ui:TextBlock
                        Grid.Row="4"
                        Style="{StaticResource EmptyStateBodyText}"
                        Text="Nothing loaded matches your search. Load more to search further back."
                    />
                    <ui:Button
                        Grid.Row="6"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Clear my documents search"
                        Content="Clear search"
                        Click="OnClearSearchClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Load more -->
        <ui:Button
            x:Name="LoadMoreButton"
            Grid.Row="7"
            AutomationProperties.AutomationId="LoadMoreButton"
            TabIndex="1"
            HorizontalAlignment="Center"
            Command="{Binding LoadMoreCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="24" Height="24">
                    <ui:SymbolIcon
                        Symbol="ArrowDown24"
                        Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                    />
                    <ui:ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Loading more documents"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    />
                </Grid>
                <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Load more" />
            </Grid>
        </ui:Button>

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="9"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RefreshCommand}"
            RetryContent="Retry"
            RetryAutomationId="DocumentsMineRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
