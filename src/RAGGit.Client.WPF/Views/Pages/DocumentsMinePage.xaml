<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DocumentsMinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="My Documents"
>
    <Page.Resources>
        <converters:MineMetaConverter x:Key="MineMeta" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
    </Page.Resources>
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto, *, Auto, Auto">
        <!-- Header card -->
        <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="My Documents" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Documents you uploaded"
                    />
                </StackPanel>
                <ui:Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    AutomationProperties.AutomationId="RefreshButton"
                    AutomationProperties.Name="Refresh documents"
                    ToolTip="Refresh documents"
                    TabIndex="0"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                >
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon
                            Symbol="ArrowClockwise24"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                        />
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            AutomationProperties.Name="Refreshing documents"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </ui:Button>
            </Grid>
        </ui:Card>

        <!-- Document list -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ui:ListView
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            >
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="{StaticResource CardPaddingSmall}">
                            <Grid RowDefinitions="Auto, Auto">
                                <ui:TextBlock
                                    Grid.Row="0"
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Filename}"
                                />
                                <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                                    <components:StatusChip
                                        Status="{Binding Status}"
                                        VerticalAlignment="Center"
                                    />
                                    <ui:TextBlock
                                        Margin="8,0,0,0"
                                        FontTypography="Caption"
                                        VerticalAlignment="Center"
                                        Text="{Binding Converter={StaticResource MineMeta}}"
                                    />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- Empty state card -->
            <ui:Card
                Padding="{StaticResource CardPaddingLarge}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="Document24"
                        Style="{StaticResource EmptyStateGlyph}"
                        Margin="0,0,0,12"
                    />
                    <ui:TextBlock
                        HorizontalAlignment="Center"
                        FontTypography="Title"
                        Text="No documents yet"
                    />
                    <ui:TextBlock
                        Margin="{StaticResource EmptyStateBodyMargin}"
                        HorizontalAlignment="Center"
                        FontTypography="Body"
                        Text="Upload a document to see it here."
                    />
                </StackPanel>
            </ui:Card>

            <ui:ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading your documents"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
            />
        </Grid>

        <!-- Load more -->
        <ui:Button
            x:Name="LoadMoreButton"
            Grid.Row="2"
            AutomationProperties.AutomationId="LoadMoreButton"
            TabIndex="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Content="Load more"
            Command="{Binding LoadMoreCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
            Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <ui:Button.Icon>
                <Grid Width="24" Height="24">
                    <ui:SymbolIcon
                        Symbol="ArrowDown24"
                        Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                    />
                    <ui:ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Loading more documents"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    />
                </Grid>
            </ui:Button.Icon>
        </ui:Button>

        <!-- Footer -->
        <components:StatusFooterControl
            Grid.Row="3"
            Margin="0,12,0,0"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
            IsBusy="{Binding IsBusy, Mode=OneWay}"
            RetryCommand="{Binding RefreshCommand}"
            RetryContent="Retry"
            RetryAutomationId="DocumentsMineRetryButton"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>
    </Grid>
</Page>
