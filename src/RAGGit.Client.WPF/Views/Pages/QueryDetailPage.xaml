<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.QueryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Query Detail"
>
    <Page.Resources>
        <converters:HistoryCitationSubtitleConverter x:Key="CitationSubtitle" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
    </Page.Resources>
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto, Auto, Auto, Auto, *">
        <!-- Header card -->
        <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Query Detail" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="A saved question and its grounded answer"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="AskAgainButton"
                        AutomationProperties.AutomationId="AskAgainButton"
                        AutomationProperties.Name="Run this query again"
                        ToolTip="Run this query again"
                        TabIndex="0"
                        Margin="0,0,8,0"
                        Content="Ask again"
                        Click="OnAskAgainClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="BackButton"
                        AutomationProperties.AutomationId="BackButton"
                        AutomationProperties.Name="Back"
                        ToolTip="Back"
                        TabIndex="1"
                        Content="Back"
                        Click="OnBackClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowLeft24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Error -->
        <components:StatusFooterControl
            Grid.Row="1"
            Margin="0,12,0,0"
            Message="{Binding ErrorMessage, Mode=OneWay}"
            Severity="Error"
        >
            <components:StatusFooterControl.Style>
                <Style TargetType="components:StatusFooterControl">
                    <Setter Property="IsOpen" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="IsOpen" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </components:StatusFooterControl.Style>
        </components:StatusFooterControl>

        <!-- Prompt card -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0" Padding="{StaticResource CardPaddingSmall}">
            <StackPanel>
                <ui:TextBlock Style="{StaticResource SectionHeaderText}" Text="Prompt" />
                <ui:TextBlock
                    Margin="0,6,0,0"
                    FontTypography="Body"
                    TextWrapping="Wrap"
                    Text="{Binding Detail.Prompt}"
                />
                <ui:Button
                    x:Name="CopyPromptButton"
                    AutomationProperties.AutomationId="CopyPromptButton"
                    AutomationProperties.Name="Copy prompt"
                    ToolTip="Copy prompt"
                    TabIndex="2"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0"
                    Content="Copy"
                    Click="CopyPromptButton_Click"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </ui:Card>

        <!-- Answer card -->
        <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="{StaticResource CardPaddingSmall}">
            <StackPanel>
                <ui:TextBlock Style="{StaticResource SectionHeaderText}" Text="Answer" />
                <ui:TextBlock
                    Margin="0,6,0,0"
                    FontTypography="Body"
                    TextWrapping="Wrap"
                    Text="{Binding Detail.Answer}"
                />
                <ui:Button
                    x:Name="CopyAnswerButton"
                    AutomationProperties.AutomationId="CopyAnswerButton"
                    AutomationProperties.Name="Copy answer"
                    ToolTip="Copy answer"
                    TabIndex="3"
                    HorizontalAlignment="Right"
                    Margin="0,6,0,0"
                    Content="Copy"
                    Click="CopyAnswerButton_Click"
                >
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </ui:Card>

        <!-- Citations card -->
        <ui:Card Grid.Row="4" Margin="0,12,0,0" Padding="{StaticResource CardPaddingSmall}">
            <Grid RowDefinitions="Auto, *">
                <ui:TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionHeaderText}"
                    Text="Citations"
                />
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <ListBox
                        ItemsSource="{Binding Detail.Citations}"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <ui:TextBlock
                                            FontTypography="Body"
                                            TextWrapping="Wrap"
                                            Text="{Binding Text}"
                                        />
                                        <ui:TextBlock
                                            Margin="0,4,0,0"
                                            FontTypography="Caption"
                                            Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                        />
                                        <ui:Button
                                            AutomationProperties.AutomationId="CopyCitationButton"
                                            AutomationProperties.Name="Copy citation"
                                            ToolTip="Copy citation"
                                            HorizontalAlignment="Right"
                                            Margin="0,6,0,0"
                                            Content="Copy"
                                            Click="CopyCitationButton_Click"
                                        >
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Detail.Citations, Converter={StaticResource EmptyListVisibility}}"
                    >
                        <ui:SymbolIcon
                            Symbol="Link24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,12"
                        />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            FontTypography="Title"
                            Text="No citations"
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            FontTypography="Body"
                            Style="{StaticResource SecondaryText}"
                            Text="No citations for this query."
                        />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Loading overlay -->
        <ui:ProgressRing
            Grid.Row="0"
            Grid.RowSpan="5"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Loading query details"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
        />
    </Grid>
</Page>
