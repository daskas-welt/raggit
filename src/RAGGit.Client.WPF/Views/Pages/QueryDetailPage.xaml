<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.QueryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Query Detail"
>
    <Page.Resources>
        <converters:HistoryCitationSubtitleConverter x:Key="CitationSubtitle" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
    </Page.Resources>
    <Grid>
        <!-- A long prompt or answer must scroll the page instead of clipping the cards;
             the loading overlay lives outside this scroller so it stays centred. -->
        <ScrollViewer
            x:Name="QueryDetailScroll"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
        >
            <!-- The 24px outer rows carry the former PagePadding inset of this root grid. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=QueryDetailScroll}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <!-- Header card -->
                <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock
                                Style="{StaticResource PageTitleText}"
                                Text="Query Detail"
                            />
                            <ui:TextBlock
                                Style="{StaticResource PageSubtitleText}"
                                Text="A saved question and its grounded answer"
                            />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                x:Name="AskAgainButton"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="AskAgainButton"
                                AutomationProperties.Name="Run this query again"
                                ToolTip="Run this query again"
                                TabIndex="0"
                                Content="Ask again"
                                Click="OnAskAgainClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                x:Name="BackButton"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="BackButton"
                                AutomationProperties.Name="Back"
                                ToolTip="Back"
                                TabIndex="1"
                                Content="Back"
                                Click="OnBackClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- Error -->
                <components:StatusFooterControl
                    Grid.Row="3"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                >
                    <components:StatusFooterControl.Style>
                        <Style TargetType="components:StatusFooterControl">
                            <Setter Property="IsOpen" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="IsOpen" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:StatusFooterControl.Style>
                </components:StatusFooterControl>

                <!-- Prompt card -->
                <ui:Card Grid.Row="5" Padding="{StaticResource CardPaddingSmall}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Style="{StaticResource SectionHeaderText}"
                            Text="Prompt"
                        />
                        <ui:TextBlock
                            Grid.Row="2"
                            FontTypography="Body"
                            TextWrapping="Wrap"
                            Text="{Binding Detail.Prompt}"
                        />
                        <ui:Button
                            x:Name="CopyPromptButton"
                            Grid.Row="4"
                            AutomationProperties.AutomationId="CopyPromptButton"
                            AutomationProperties.Name="Copy prompt"
                            ToolTip="Copy prompt"
                            TabIndex="2"
                            HorizontalAlignment="Right"
                            Content="Copy"
                            Click="CopyPromptButton_Click"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!-- Answer card -->
                <ui:Card Grid.Row="7" Padding="{StaticResource CardPaddingSmall}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Style="{StaticResource SectionHeaderText}"
                            Text="Answer"
                        />
                        <ui:TextBlock
                            Grid.Row="2"
                            FontTypography="Body"
                            TextWrapping="Wrap"
                            Text="{Binding Detail.Answer}"
                        />
                        <ui:Button
                            x:Name="CopyAnswerButton"
                            Grid.Row="4"
                            AutomationProperties.AutomationId="CopyAnswerButton"
                            AutomationProperties.Name="Copy answer"
                            ToolTip="Copy answer"
                            TabIndex="3"
                            HorizontalAlignment="Right"
                            Content="Copy"
                            Click="CopyAnswerButton_Click"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!-- Citations card -->
                <ui:Card Grid.Row="9" Padding="{StaticResource CardPaddingSmall}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Style="{StaticResource SectionHeaderText}"
                            Text="Citations"
                        />
                        <Grid Grid.Row="2">
                            <ListBox
                                ItemsSource="{Binding Detail.Citations}"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxHeight="320"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            >
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter
                                            Property="HorizontalContentAlignment"
                                            Value="Stretch"
                                        />
                                        <Setter Property="Padding" Value="0" />
                                        <!-- Item spacing in the ListBox panel has no Grid tracks. -->
                                        <Setter Property="Margin" Value="0,4" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="4" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBlock
                                                    Grid.Row="0"
                                                    FontTypography="Body"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Text}"
                                                />
                                                <ui:TextBlock
                                                    Grid.Row="2"
                                                    FontTypography="Caption"
                                                    Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                                />
                                                <ui:Button
                                                    Grid.Row="4"
                                                    AutomationProperties.AutomationId="CopyCitationButton"
                                                    AutomationProperties.Name="Copy citation"
                                                    ToolTip="Copy citation"
                                                    HorizontalAlignment="Right"
                                                    Content="Copy"
                                                    Click="CopyCitationButton_Click"
                                                >
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Copy24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Detail.Citations, Converter={StaticResource EmptyListVisibility}}"
                            >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon
                                    Grid.Row="0"
                                    Symbol="Link24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource EmptyStateTitleText}"
                                    Text="No citations"
                                />
                                <ui:TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource EmptyStateBodyText}"
                                    Text="No citations for this query."
                                />
                            </Grid>
                        </Grid>
                    </Grid>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- Loading overlay sits over the viewport, not the scroll extent, so it stays
             centred even when a long answer has scrolled the page. -->
        <ui:ProgressRing
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Loading query details"
            IsIndeterminate="True"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
        />
    </Grid>
</Page>
