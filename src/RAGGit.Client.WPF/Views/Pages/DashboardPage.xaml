<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dashboard"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
    </Page.Resources>
    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,24"
        >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact header: title + supporting line on the left, quick actions on the right. -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel MinWidth="280" Margin="0,0,24,12" VerticalAlignment="Center">
                        <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Dashboard" />
                        <ui:TextBlock
                            Style="{StaticResource PageSubtitleText}"
                            Text="{Binding LibrarySummary}"
                        />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button
                            MinHeight="44"
                            Margin="0,0,8,12"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DashboardTileHistory"
                            AutomationProperties.Name="Open history"
                            Content="History"
                            ToolTip="Open history"
                            Click="OnHistoryClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="History24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            MinHeight="44"
                            Margin="0,0,8,12"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DashboardTileMyDocs"
                            AutomationProperties.Name="Open my documents"
                            Content="My Docs"
                            ToolTip="Open my documents"
                            Click="OnMyDocsClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Document24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            MinHeight="44"
                            Margin="0,0,8,12"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DashboardTileAdmin"
                            AutomationProperties.Name="Open admin"
                            Content="Admin"
                            ToolTip="Open admin"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                            Click="OnAdminClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="People24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Card
                            Padding="14,10"
                            Margin="0,0,12,12"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DashboardProfileCard"
                            AutomationProperties.Name="Logged user profile"
                        >
                            <Grid MinWidth="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                >
                                    <ui:SymbolIcon
                                        Symbol="Person24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                >
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding UserDisplayName}"
                                    />
                                    <ui:TextBlock
                                        Margin="0,2,0,0"
                                        FontTypography="Caption"
                                        Style="{StaticResource SecondaryText}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding UserHandle}"
                                    />
                                    <ui:TextBlock
                                        Margin="0,2,0,0"
                                        FontTypography="Caption"
                                        Style="{StaticResource SecondaryText}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding UserDetails}"
                                    />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <ui:Button
                            Width="44"
                            Height="44"
                            Margin="0,0,0,12"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DashboardRefreshButton"
                            AutomationProperties.Name="Refresh dashboard"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Refresh dashboard"
                        >
                            <Grid Width="24" Height="24">
                                <ui:SymbolIcon
                                    Symbol="ArrowClockwise24"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                                />
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="True"
                                    AutomationProperties.Name="Refreshing dashboard"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                />
                            </Grid>
                        </ui:Button>
                    </WrapPanel>
                </WrapPanel>

                <!-- Metric cards: icon + count + label; wrap at narrow widths. -->
                <WrapPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricDocuments"
                        AutomationProperties.Name="{Binding TotalDocuments, StringFormat={}{0} documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Library24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Documents"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricReady"
                        AutomationProperties.Name="{Binding ReadyDocuments, StringFormat={}{0} ready documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="CheckmarkCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding ReadyDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Ready"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricIndexing"
                        AutomationProperties.Name="{Binding IndexingDocuments, StringFormat={}{0} indexing documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="ArrowSyncCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding IndexingDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Indexing"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricFailed"
                        AutomationProperties.Name="{Binding FailedDocuments, StringFormat={}{0} failed documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                >
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                            <Setter
                                                Property="Foreground"
                                                Value="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                            />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding FailedDocuments}"
                                                    Value="0"
                                                >
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                                    />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding FailedDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Failed"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricQueries"
                        AutomationProperties.Name="{Binding TotalQueries, StringFormat={}{0} questions — ask the library}"
                        ToolTip="Ask the library"
                        Click="OnAskClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalQueries}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Questions"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricMine"
                        AutomationProperties.Name="{Binding MyDocuments, StringFormat={}{0} of my documents — open my documents}"
                        ToolTip="Open my documents"
                        Click="OnMyDocsClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="{Binding MyDocuments}" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Mine"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                </WrapPanel>

                <!-- Content -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Border, not Card: the library's Card style centres its content, which pushes
                         this section title down whenever the sibling card is taller. -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="18"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                    >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent documents"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardLibraryButton"
                                    AutomationProperties.Name="View library"
                                    Click="OnLibraryClicked"
                                    ToolTip="View library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Library24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentDocuments}"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Document}">
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Filename}"
                                            />
                                            <components:StatusChip
                                                Grid.Column="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Status="{Binding Status}"
                                            />
                                            <ui:TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No documents yet"
                                />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Open the library to upload your first document."
                                />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Border, not Card: see the note on the first card. -->
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="18"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                    >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent questions"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardAskButton"
                                    AutomationProperties.Name="Ask the library"
                                    Click="OnAskClicked"
                                    ToolTip="Ask the library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Chat24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentQueries}"
                                Visibility="{Binding HasQueryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <StackPanel Margin="0,10">
                                            <ui:TextBlock
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding PromptPreview}"
                                            />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    FontTypography="Caption"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding CitationCount}"
                                                />
                                                <ui:TextBlock
                                                    Margin="4,0,0,0"
                                                    FontTypography="Caption"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="citations"
                                                />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasQueryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No questions yet"
                                />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Ask the library to find grounded answers."
                                />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:InfoBar
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DashboardStatusBar"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Dashboard status"
                        IsClosable="False"
                        IsOpen="{Binding HasStatus}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
                    />
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DashboardRetryButton"
                        AutomationProperties.Name="Retry loading dashboard"
                        Command="{Binding RetryCommand}"
                        Content="Retry"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
