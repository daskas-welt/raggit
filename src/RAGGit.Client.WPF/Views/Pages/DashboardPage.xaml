<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dashboard"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
    </Page.Resources>
    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,24"
        >
            <Grid
                x:Name="DashboardLayout"
                SizeChanged="OnDashboardLayoutSizeChanged"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
            >
                <!-- Shared header card: title + supporting line on the left, quick actions on the right. -->
                <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel MinWidth="280" Margin="0,0,24,12" VerticalAlignment="Center">
                            <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Dashboard" />
                            <ui:TextBlock
                                Style="{StaticResource PageSubtitleText}"
                                Text="Your library at a glance"
                            />
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button
                                MinHeight="44"
                                Margin="0,0,8,12"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DashboardTileHistory"
                                AutomationProperties.Name="Open history"
                                Content="History"
                                ToolTip="Open history"
                                Click="OnHistoryClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="History24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                MinHeight="44"
                                Margin="0,0,8,12"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DashboardTileMyDocs"
                                AutomationProperties.Name="Open my documents"
                                Content="My Docs"
                                ToolTip="Open my documents"
                                Click="OnMyDocsClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Document24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                MinHeight="44"
                                Margin="0,0,8,12"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DashboardTileAdmin"
                                AutomationProperties.Name="Open admin"
                                Content="Admin"
                                ToolTip="Open admin"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                                Click="OnAdminClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="People24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                Width="44"
                                Height="44"
                                Margin="0,0,0,12"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DashboardRefreshButton"
                                AutomationProperties.Name="Refresh dashboard"
                                Command="{Binding LoadCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip="Refresh dashboard"
                            >
                                <Grid Width="24" Height="24">
                                    <ui:SymbolIcon
                                        Symbol="ArrowClockwise24"
                                        Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                                    />
                                    <ui:ProgressRing
                                        Width="24"
                                        Height="24"
                                        IsIndeterminate="True"
                                        AutomationProperties.Name="Refreshing dashboard"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                    />
                                </Grid>
                            </ui:Button>
                        </WrapPanel>
                    </WrapPanel>
                </ui:Card>

                <!-- Post-header row: library summary left, profile card right. -->
                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*, Auto">
                    <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding LibrarySummary}"
                    >
                        <ui:TextBlock.Style>
                            <Style
                                TargetType="ui:TextBlock"
                                BasedOn="{StaticResource PageSubtitleText}"
                            >
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                    <ui:Card
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="14,10"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="DashboardProfileCard"
                        AutomationProperties.Name="Logged user profile"
                    >
                        <Grid MinWidth="260" ColumnDefinitions="Auto, *">
                            <Border
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                CornerRadius="20"
                            >
                                <ui:SymbolIcon
                                    Symbol="Person24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                            >
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding UserDisplayName}"
                                />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    FontTypography="Caption"
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding UserHandle}"
                                />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    FontTypography="Caption"
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding UserDetails}"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Metric cards: icon + count + label; wrap at narrow widths. Hidden until a
                     load has succeeded, so a first-load failure never presents the initial
                     zeros as loaded data. -->
                <WrapPanel Grid.Row="2" Margin="0,4,0,0" Orientation="Horizontal">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricDocuments"
                        AutomationProperties.Name="{Binding TotalDocuments, StringFormat={}{0} documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Library24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Documents"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricReady"
                        AutomationProperties.Name="{Binding ReadyDocuments, StringFormat={}{0} ready documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="CheckmarkCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding ReadyDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Ready"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricIndexing"
                        AutomationProperties.Name="{Binding IndexingDocuments, StringFormat={}{0} indexing documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="ArrowSyncCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding IndexingDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Indexing"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricFailed"
                        AutomationProperties.Name="{Binding FailedDocuments, StringFormat={}{0} failed documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                >
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                            <Setter
                                                Property="Foreground"
                                                Value="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                            />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding FailedDocuments}"
                                                    Value="0"
                                                >
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                                    />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding FailedDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Failed"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricQueries"
                        AutomationProperties.Name="{Binding TotalQueries, StringFormat={}{0} questions — ask the library}"
                        ToolTip="Ask the library"
                        Click="OnAskClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalQueries}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Questions"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        Width="200"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricMine"
                        AutomationProperties.Name="{Binding MyDocuments, StringFormat={}{0} of my documents — open my documents}"
                        ToolTip="Open my documents"
                        Click="OnMyDocsClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="{Binding MyDocuments}" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Mine"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                </WrapPanel>

                <!-- Whole-dashboard empty state: only after a successful load, once the library is
                     confirmed empty and no questions exist. Not shown while loading or after a failure. -->
                <ui:Card
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    Padding="24"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="DashboardEmptyState"
                    AutomationProperties.Name="Empty library"
                >
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                        <Condition
                                            Binding="{Binding StatusSeverity}"
                                            Value="Success"
                                        />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Library24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,12"
                        />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            FontTypography="Title"
                            Text="No documents yet"
                        />
                        <ui:TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Text="Open the library to upload your first document."
                        />
                        <ui:Button
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            AutomationProperties.Name="Open the library"
                            Content="Open the library"
                            ToolTip="Open the library"
                            Click="OnLibraryClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Library24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <!-- Content -->
                <Grid
                    x:Name="PanelsGrid"
                    Grid.Row="4"
                    Margin="0,4,0,0"
                    ColumnDefinitions="1.15*, *"
                    RowDefinitions="Auto, Auto"
                >
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ui:Card
                        x:Name="DocumentsPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="18"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid RowDefinitions="Auto, *">
                            <Grid Margin="0,0,0,12" ColumnDefinitions="*, Auto">
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent documents"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardLibraryButton"
                                    AutomationProperties.Name="View library"
                                    Click="OnLibraryClicked"
                                    ToolTip="View library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Library24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentDocuments}"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Document}">
                                        <Grid Margin="0,10" ColumnDefinitions="*, Auto, Auto">
                                            <ui:TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Filename}"
                                            />
                                            <components:StatusChip
                                                Grid.Column="1"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Status="{Binding Status}"
                                            />
                                            <ui:TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryText}"
                                                Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No documents yet"
                                />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Open the library to upload your first document."
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card
                        x:Name="QuestionsPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="18"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid RowDefinitions="Auto, *">
                            <Grid Margin="0,0,0,12" ColumnDefinitions="*, Auto">
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent questions"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardAskButton"
                                    AutomationProperties.Name="Ask the library"
                                    Click="OnAskClicked"
                                    ToolTip="Ask the library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Chat24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentQueries}"
                                Visibility="{Binding HasQueryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <StackPanel Margin="0,10">
                                            <ui:TextBlock
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding PromptPreview}"
                                            />
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <ui:TextBlock
                                                    FontTypography="Caption"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="{Binding CitationCount}"
                                                />
                                                <ui:TextBlock
                                                    Margin="4,0,0,0"
                                                    FontTypography="Caption"
                                                    Style="{StaticResource SecondaryText}"
                                                    Text="citations"
                                                />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasQueryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No questions yet"
                                />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Ask the library to find grounded answers."
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>

                <!-- Status -->
                <components:StatusFooterControl
                    Grid.Row="5"
                    Margin="0,12,0,0"
                    Message="{Binding StatusMessage, Mode=OneWay}"
                    Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
                    IsOpen="{Binding HasStatus, Mode=OneWay}"
                    RetryCommand="{Binding RetryCommand}"
                    RetryContent="Retry"
                    StatusAutomationId="DashboardStatusBar"
                    RetryAutomationId="DashboardRetryButton"
                />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
