<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dashboard"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
        <converters:ResponsiveColumnCountConverter x:Key="DashboardMetricColumns" />
        <converters:ResponsiveColumnCountConverter x:Key="DashboardRecentColumns" />
    </Page.Resources>
    <Grid>
        <!-- The layout is at least one viewport tall so the empty state can center in the space
             below the metric cards; the outer 24px rows are the page insets. -->
        <ScrollViewer
            x:Name="DashboardScroll"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
        >
            <Grid
                x:Name="DashboardLayout"
                MinHeight="{Binding ViewportHeight, ElementName=DashboardScroll}"
                SizeChanged="OnDashboardLayoutSizeChanged"
            >
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <!-- Shared header card: title + supporting line on the left, the refresh
                     affordance and the signed-in account chip on the right. -->
                <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" MinWidth="280" VerticalAlignment="Center">
                            <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Dashboard" />
                            <ui:TextBlock
                                Style="{StaticResource PageSubtitleText}"
                                Text="Your library at a glance"
                            />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="4"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="DashboardRefreshButton"
                            AutomationProperties.Name="Refresh dashboard"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Refresh dashboard"
                        >
                            <Grid Width="24" Height="24">
                                <ui:SymbolIcon
                                    Symbol="ArrowClockwise24"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                                />
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="True"
                                    AutomationProperties.Name="Refreshing dashboard"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                />
                            </Grid>
                        </ui:Button>
                        <Border
                            Grid.Column="2"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            AutomationProperties.AutomationId="DashboardProfileCard"
                            AutomationProperties.Name="Logged user profile"
                        >
                            <Grid MinWidth="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                >
                                    <ui:SymbolIcon
                                        Symbol="Person24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding UserDisplayName}"
                                    />
                                    <Grid x:Name="ProfileChipDetails">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="2" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:TextBlock
                                            Grid.Row="0"
                                            FontTypography="Caption"
                                            Style="{StaticResource SecondaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding UserHandle}"
                                        />
                                        <ui:TextBlock
                                            Grid.Row="2"
                                            FontTypography="Caption"
                                            Style="{StaticResource SecondaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding UserDetails}"
                                        />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ui:Card>

                <!-- Status: directly under the header, matching the People Management page so
                     "Dashboard refreshed" / load errors are seen without scrolling. The wrapper
                     owns the 12px insets so they collapse with the bar when there is no status. -->
                <Grid
                    Grid.Row="2"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}"
                >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                    </Grid.RowDefinitions>
                    <components:StatusFooterControl
                        Grid.Row="1"
                        Message="{Binding StatusMessage, Mode=OneWay}"
                        Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
                        IsOpen="{Binding HasStatus, Mode=OneWay}"
                        IsBusy="{Binding IsBusy, Mode=OneWay}"
                        RetryContent="Retry"
                        StatusAutomationId="DashboardStatusBar"
                        RetryAutomationId="DashboardRetryButton"
                    >
                        <components:StatusFooterControl.Style>
                            <Style TargetType="components:StatusFooterControl">
                                <!-- The header carries the page-wide refresh; the status
                                     bar keeps its Retry only for a failed load. -->
                                <Setter Property="RetryCommand" Value="{Binding RetryCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                        <Setter Property="RetryCommand" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </components:StatusFooterControl.Style>
                    </components:StatusFooterControl>
                </Grid>

                <!-- Loading placeholders (feature 029, FR-007): the final layout with em dashes
                     instead of numbers, so a first load never shows a blank area or a fabricated
                     count. Em dashes are visibly not data. The cards keep their trailing margin
                     because a UniformGrid has no tracks to gutter. -->
                <UniformGrid
                    Grid.Row="4"
                    Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DashboardMetricColumns}, ConverterParameter=6, FallbackValue=6}"
                >
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLoaded}" Value="False" />
                                        <Condition Binding="{Binding IsBusy}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    Text="Documents"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Ready" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    Text="Indexing"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    Text="Failed"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    Text="Questions"
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="—" />
                                <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Mine" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </UniformGrid>

                <!-- Metric cards: icon + count + label, stretching to span the full width on
                     desktop and reflowing to fewer columns at narrow widths. Hidden until a
                     load has succeeded, so a first-load failure never presents the initial
                     zeros as loaded data. Each card keeps its trailing margin because a
                     UniformGrid has no tracks to gutter. -->
                <UniformGrid
                    Grid.Row="4"
                    Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DashboardMetricColumns}, ConverterParameter=6, FallbackValue=6}"
                >
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricDocuments"
                        AutomationProperties.Name="{Binding TotalDocuments, StringFormat={}{0} documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Library24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Documents"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricReady"
                        AutomationProperties.Name="{Binding ReadyDocuments, StringFormat={}{0} ready documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="CheckmarkCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding ReadyDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Ready"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricIndexing"
                        AutomationProperties.Name="{Binding IndexingDocuments, StringFormat={}{0} indexing documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="ArrowSyncCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding IndexingDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Indexing"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricFailed"
                        AutomationProperties.Name="{Binding FailedDocuments, StringFormat={}{0} failed documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                >
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <!-- Neutral unless the latest load succeeded with failures.
                                                 A failed refresh must not keep the error glyph up over
                                                 the error status (029, FR-007). -->
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                            <Setter
                                                Property="Foreground"
                                                Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                            />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HasFailedDocuments}"
                                                    Value="True"
                                                >
                                                    <Setter
                                                        Property="Symbol"
                                                        Value="ErrorCircle24"
                                                    />
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                                    />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding FailedDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Failed"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                                <!-- Shown only when a load succeeded and failures exist, so attention
                                     styling can never paint over an error state (FR-007). -->
                                <ui:TextBlock
                                    x:Name="DashboardMetricFailedAttention"
                                    AutomationProperties.AutomationId="DashboardMetricFailedAttention"
                                    FontTypography="Caption"
                                    Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                    Text="Needs attention"
                                >
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition
                                                            Binding="{Binding HasLoaded}"
                                                            Value="True"
                                                        />
                                                        <Condition
                                                            Binding="{Binding HasFailedDocuments}"
                                                            Value="True"
                                                        />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricQueries"
                        AutomationProperties.Name="{Binding TotalQueries, StringFormat={}{0} questions — ask the library}"
                        ToolTip="Ask the library"
                        Click="OnAskClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalQueries}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Questions"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Ask the library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricMine"
                        AutomationProperties.Name="{Binding MyDocuments, StringFormat={}{0} of my documents — open my documents}"
                        ToolTip="Open my documents"
                        Click="OnMyDocsClicked"
                    >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="{Binding MyDocuments}" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Mine"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open my documents" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                </UniformGrid>

                <!-- Whole-dashboard empty state: only after a successful load, once the library is
                     confirmed empty and no questions exist. Not shown while loading or after a
                     failure. It shares the content row with the panels below, centered in the
                     space the metric cards leave. -->
                <ui:Card
                    Grid.Row="6"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="DashboardEmptyState"
                    AutomationProperties.Name="Empty library"
                >
                    <ui:Card.Style>
                        <!-- The trigger needs a local Style; BasedOn keeps the shared empty-state
                             surface instead of replacing the implicit ui:Card style. -->
                        <Style TargetType="ui:Card" BasedOn="{StaticResource EmptyStateCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                        <Condition
                                            Binding="{Binding StatusSeverity}"
                                            Value="Success"
                                        />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:SymbolIcon
                            Grid.Row="0"
                            Symbol="Library24"
                            Style="{StaticResource EmptyStateGlyph}"
                        />
                        <ui:TextBlock
                            Grid.Row="2"
                            Style="{StaticResource EmptyStateTitleText}"
                            Text="No documents yet"
                        />
                        <ui:TextBlock
                            Grid.Row="4"
                            Style="{StaticResource EmptyStateBodyText}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                            Text="Open the library to upload your first document."
                        />
                        <ui:TextBlock
                            Grid.Row="4"
                            Style="{StaticResource EmptyStateBodyText}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                            Text="Ask a question to get grounded answers, or contact an admin to add documents."
                        />
                        <ui:Button
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            AutomationProperties.Name="Open the library"
                            Content="Open the library"
                            ToolTip="Open the library"
                            Click="OnLibraryClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Library24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!-- Content -->
                <Grid x:Name="PanelsGrid" Grid.Row="6" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ui:Card
                        x:Name="DocumentsPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="{StaticResource CardPaddingMedium}"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource PanelHeaderText}"
                                    VerticalAlignment="Center"
                                    Text="Recent documents"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardLibraryButton"
                                    AutomationProperties.Name="View library"
                                    Click="OnLibraryClicked"
                                    ToolTip="View library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Library24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="2"
                                ItemsSource="{Binding RecentDocuments}"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            VerticalAlignment="Top"
                                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource DashboardRecentColumns}, ConverterParameter=2, FallbackValue=2}"
                                        />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Document}">
                                        <!-- UniformGrid item spacing has no Grid tracks. -->
                                        <ui:Card
                                            Margin="0,0,12,12"
                                            Padding="{StaticResource CardPaddingSmall}"
                                            VerticalAlignment="Stretch"
                                        >
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBlock
                                                    Grid.Row="0"
                                                    FontTypography="BodyStrong"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Filename}"
                                                />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <components:StatusChip
                                                        Grid.Column="0"
                                                        Status="{Binding Status}"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <ui:TextBlock
                                                        Grid.Column="2"
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                                    />
                                                </Grid>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid
                                Grid.Row="2"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:SymbolIcon
                                        Grid.Row="0"
                                        Symbol="Document24"
                                        Style="{StaticResource EmptyStateGlyph}"
                                    />
                                    <ui:TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource SectionHeaderText}"
                                        HorizontalAlignment="Center"
                                        Text="No documents yet"
                                    />
                                    <ui:TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource EmptyStateBodyText}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                                        Text="Open the library to upload your first document."
                                    />
                                    <ui:TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource EmptyStateBodyText}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                                        Text="Ask a question to get grounded answers, or contact an admin to add documents."
                                    />
                                </Grid>
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <ui:Card
                        x:Name="QuestionsPanel"
                        Grid.Row="0"
                        Grid.Column="2"
                        Padding="{StaticResource CardPaddingMedium}"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource PanelHeaderText}"
                                    VerticalAlignment="Center"
                                    Text="Recent questions"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="DashboardAskButton"
                                    AutomationProperties.Name="Ask the library"
                                    Click="OnAskClicked"
                                    ToolTip="Ask the library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Chat24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="2"
                                ItemsSource="{Binding RecentQueries}"
                                Visibility="{Binding HasQueryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            VerticalAlignment="Top"
                                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource DashboardRecentColumns}, ConverterParameter=2, FallbackValue=2}"
                                        />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <!-- UniformGrid item spacing has no Grid tracks. -->
                                        <ui:Card
                                            Margin="0,0,12,12"
                                            Padding="{StaticResource CardPaddingSmall}"
                                            VerticalAlignment="Stretch"
                                        >
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBlock
                                                    Grid.Row="0"
                                                    FontTypography="BodyStrong"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding PromptPreview}"
                                                />
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBlock
                                                        Grid.Column="0"
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="{Binding CitationCount}"
                                                    />
                                                    <ui:TextBlock
                                                        Grid.Column="2"
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="citations"
                                                    />
                                                </Grid>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid
                                Grid.Row="2"
                                Visibility="{Binding HasQueryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:SymbolIcon
                                        Grid.Row="0"
                                        Symbol="Chat24"
                                        Style="{StaticResource EmptyStateGlyph}"
                                    />
                                    <ui:TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource SectionHeaderText}"
                                        HorizontalAlignment="Center"
                                        Text="No questions yet"
                                    />
                                    <ui:TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource EmptyStateBodyText}"
                                        Text="Ask the library to find grounded answers."
                                    />
                                </Grid>
                            </Grid>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
