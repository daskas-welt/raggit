<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dashboard"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
        <converters:ResponsiveColumnCountConverter x:Key="DashboardMetricColumns" />
        <converters:ResponsiveColumnCountConverter x:Key="DashboardRecentColumns" />
    </Page.Resources>
    <Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,24"
        >
            <Grid
                x:Name="DashboardLayout"
                SizeChanged="OnDashboardLayoutSizeChanged"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto"
            >
                <!-- Shared header card: title + supporting line on the left, the refresh
                     affordance and the signed-in account chip on the right. -->
                <ui:Card Grid.Row="0" Style="{StaticResource PageHeaderCard}">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <StackPanel
                            Grid.Column="0"
                            MinWidth="280"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                        >
                            <ui:TextBlock Style="{StaticResource PageTitleText}" Text="Dashboard" />
                            <ui:TextBlock
                                Style="{StaticResource PageSubtitleText}"
                                Text="Your library at a glance"
                            />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="DashboardRefreshButton"
                            AutomationProperties.Name="Refresh dashboard"
                            Command="{Binding LoadCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            ToolTip="Refresh dashboard"
                        >
                            <Grid Width="24" Height="24">
                                <ui:SymbolIcon
                                    Symbol="ArrowClockwise24"
                                    Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                                />
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="True"
                                    AutomationProperties.Name="Refreshing dashboard"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                                />
                            </Grid>
                        </ui:Button>
                        <Border
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            Padding="14,10"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            AutomationProperties.AutomationId="DashboardProfileCard"
                            AutomationProperties.Name="Logged user profile"
                        >
                            <Grid MinWidth="260" ColumnDefinitions="Auto, *">
                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                >
                                    <ui:SymbolIcon
                                        Symbol="Person24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                >
                                    <ui:TextBlock
                                        FontTypography="BodyStrong"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding UserDisplayName}"
                                    />
                                    <StackPanel x:Name="ProfileChipDetails" Margin="0,2,0,0">
                                        <ui:TextBlock
                                            FontTypography="Caption"
                                            Style="{StaticResource SecondaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding UserHandle}"
                                        />
                                        <ui:TextBlock
                                            Margin="0,2,0,0"
                                            FontTypography="Caption"
                                            Style="{StaticResource SecondaryText}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding UserDetails}"
                                        />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ui:Card>

                <!-- Status: directly under the header, matching the People Management page so
                     "Dashboard refreshed" / load errors are seen without scrolling. -->
                <components:StatusFooterControl
                    Grid.Row="1"
                    Margin="0,12,0,12"
                    Message="{Binding StatusMessage, Mode=OneWay}"
                    Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
                    IsOpen="{Binding HasStatus, Mode=OneWay}"
                    IsBusy="{Binding IsBusy, Mode=OneWay}"
                    RetryContent="Retry"
                    StatusAutomationId="DashboardStatusBar"
                    RetryAutomationId="DashboardRetryButton"
                >
                    <components:StatusFooterControl.Style>
                        <Style TargetType="components:StatusFooterControl">
                            <!-- The header carries the page-wide refresh; the status
                                 bar keeps its Retry only for a failed load. -->
                            <Setter Property="RetryCommand" Value="{Binding RetryCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                    <Setter Property="RetryCommand" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:StatusFooterControl.Style>
                </components:StatusFooterControl>

                <!-- Loading placeholders (feature 029, FR-007): the final layout with em dashes
                     instead of numbers, so a first load never shows a blank area or a fabricated
                     count. Em dashes are visibly not data. -->
                <UniformGrid
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DashboardMetricColumns}, ConverterParameter=6, FallbackValue=6}"
                >
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLoaded}" Value="False" />
                                        <Condition Binding="{Binding IsBusy}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Documents" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Ready" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Indexing" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Failed" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Questions" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,12,12" Padding="0" VerticalAlignment="Stretch">
                        <StackPanel Margin="14,12" VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="Title" Text="—" />
                            <ui:TextBlock Style="{StaticResource SecondaryText}" Text="Mine" />
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <!-- Metric cards: icon + count + label, stretching to span the full width on
                     desktop and reflowing to fewer columns at narrow widths. Hidden until a
                     load has succeeded, so a first-load failure never presents the initial
                     zeros as loaded data. -->
                <UniformGrid
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource DashboardMetricColumns}, ConverterParameter=6, FallbackValue=6}"
                >
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricDocuments"
                        AutomationProperties.Name="{Binding TotalDocuments, StringFormat={}{0} documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Library24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Documents"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricReady"
                        AutomationProperties.Name="{Binding ReadyDocuments, StringFormat={}{0} ready documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="CheckmarkCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding ReadyDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Ready"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricIndexing"
                        AutomationProperties.Name="{Binding IndexingDocuments, StringFormat={}{0} indexing documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="ArrowSyncCircle24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding IndexingDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Indexing"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricFailed"
                        AutomationProperties.Name="{Binding FailedDocuments, StringFormat={}{0} failed documents — open library}"
                        ToolTip="Open library"
                        Click="OnLibraryClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                >
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <!-- Neutral unless the latest load succeeded with failures.
                                                 A failed refresh must not keep the error glyph up over
                                                 the error status (029, FR-007). -->
                                            <Setter Property="FontSize" Value="24" />
                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                            <Setter
                                                Property="Foreground"
                                                Value="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                            />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HasFailedDocuments}"
                                                    Value="True"
                                                >
                                                    <Setter
                                                        Property="Symbol"
                                                        Value="ErrorCircle24"
                                                    />
                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                                    />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding FailedDocuments}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Failed"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open library" />
                                <!-- Shown only when a load succeeded and failures exist, so attention
                                     styling can never paint over an error state (FR-007). -->
                                <ui:TextBlock
                                    x:Name="DashboardMetricFailedAttention"
                                    AutomationProperties.AutomationId="DashboardMetricFailedAttention"
                                    FontTypography="Caption"
                                    Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                    Text="Needs attention"
                                >
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition
                                                            Binding="{Binding HasLoaded}"
                                                            Value="True"
                                                        />
                                                        <Condition
                                                            Binding="{Binding HasFailedDocuments}"
                                                            Value="True"
                                                        />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricQueries"
                        AutomationProperties.Name="{Binding TotalQueries, StringFormat={}{0} questions — ask the library}"
                        ToolTip="Ask the library"
                        Click="OnAskClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock
                                    FontTypography="Title"
                                    Text="{Binding TotalQueries}"
                                />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Questions"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Ask the library" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <ui:CardAction
                        VerticalAlignment="Stretch"
                        Margin="0,0,12,12"
                        Padding="0"
                        IsChevronVisible="False"
                        AutomationProperties.AutomationId="DashboardMetricMine"
                        AutomationProperties.Name="{Binding MyDocuments, StringFormat={}{0} of my documents — open my documents}"
                        ToolTip="Open my documents"
                        Click="OnMyDocsClicked"
                    >
                        <Grid ColumnDefinitions="Auto, *">
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="14,0,12,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    FontSize="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,12" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Title" Text="{Binding MyDocuments}" />
                                <ui:TextBlock
                                    Style="{StaticResource SecondaryText}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="Mine"
                                />
                                <ui:TextBlock FontTypography="Caption" Text="Open my documents" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                </UniformGrid>

                <!-- Whole-dashboard empty state: only after a successful load, once the library is
                     confirmed empty and no questions exist. Not shown while loading or after a failure. -->
                <ui:Card
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    Padding="24"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="DashboardEmptyState"
                    AutomationProperties.Name="Empty library"
                >
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                        <Condition
                                            Binding="{Binding StatusSeverity}"
                                            Value="Success"
                                        />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            Symbol="Library24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,12"
                        />
                        <ui:TextBlock
                            HorizontalAlignment="Center"
                            FontTypography="Title"
                            Text="No documents yet"
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                            Text="Open the library to upload your first document."
                        />
                        <ui:TextBlock
                            Margin="{StaticResource EmptyStateBodyMargin}"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryText}"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                            Text="Ask a question to get grounded answers, or contact an admin to add documents."
                        />
                        <ui:Button
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            AutomationProperties.Name="Open the library"
                            Content="Open the library"
                            ToolTip="Open the library"
                            Click="OnLibraryClicked"
                        >
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Library24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <!-- Content -->
                <Grid
                    x:Name="PanelsGrid"
                    Grid.Row="4"
                    Margin="0,4,0,0"
                    ColumnDefinitions="1.15*, *"
                    RowDefinitions="Auto, Auto"
                >
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition
                                            Binding="{Binding HasLibraryData}"
                                            Value="False"
                                        />
                                        <Condition Binding="{Binding HasQueryData}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ui:Card
                        x:Name="DocumentsPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="18"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid RowDefinitions="Auto, *">
                            <Grid Margin="0,0,0,12" ColumnDefinitions="*, Auto">
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent documents"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DashboardLibraryButton"
                                    AutomationProperties.Name="View library"
                                    Click="OnLibraryClicked"
                                    ToolTip="View library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Library24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentDocuments}"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            VerticalAlignment="Top"
                                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource DashboardRecentColumns}, ConverterParameter=2, FallbackValue=2}"
                                        />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Document}">
                                        <ui:Card
                                            Margin="0,0,12,12"
                                            Padding="{StaticResource CardPaddingSmall}"
                                            VerticalAlignment="Stretch"
                                        >
                                            <Grid RowDefinitions="Auto, Auto">
                                                <ui:TextBlock
                                                    Grid.Row="0"
                                                    FontTypography="BodyStrong"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding Filename}"
                                                />
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                >
                                                    <components:StatusChip
                                                        Status="{Binding Status}"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <ui:TextBlock
                                                        Margin="8,0,0,0"
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                                    />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasLibraryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Document24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No documents yet"
                                />
                                <ui:TextBlock
                                    Margin="{StaticResource EmptyStateBodyMargin}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                                    Text="Open the library to upload your first document."
                                />
                                <ui:TextBlock
                                    Margin="{StaticResource EmptyStateBodyMargin}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource InvertedBoolVisibility}}"
                                    Text="Ask a question to get grounded answers, or contact an admin to add documents."
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <ui:Card
                        x:Name="QuestionsPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="18"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                    >
                        <Grid RowDefinitions="Auto, *">
                            <Grid Margin="0,0,0,12" ColumnDefinitions="*, Auto">
                                <ui:TextBlock
                                    Grid.Column="0"
                                    FontTypography="Title"
                                    VerticalAlignment="Center"
                                    Text="Recent questions"
                                />
                                <ui:Button
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="DashboardAskButton"
                                    AutomationProperties.Name="Ask the library"
                                    Click="OnAskClicked"
                                    ToolTip="Ask the library"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Chat24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentQueries}"
                                Visibility="{Binding HasQueryData, Converter={StaticResource BoolVisibility}}"
                            >
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
                                            VerticalAlignment="Top"
                                            Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource DashboardRecentColumns}, ConverterParameter=2, FallbackValue=2}"
                                        />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <ui:Card
                                            Margin="0,0,12,12"
                                            Padding="{StaticResource CardPaddingSmall}"
                                            VerticalAlignment="Stretch"
                                        >
                                            <Grid RowDefinitions="Auto, Auto">
                                                <ui:TextBlock
                                                    Grid.Row="0"
                                                    FontTypography="BodyStrong"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{Binding PromptPreview}"
                                                />
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                >
                                                    <ui:TextBlock
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="{Binding CitationCount}"
                                                    />
                                                    <ui:TextBlock
                                                        Margin="4,0,0,0"
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        Text="citations"
                                                    />
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasQueryData, Converter={StaticResource InvertedBoolVisibility}}"
                            >
                                <ui:SymbolIcon
                                    Symbol="Chat24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No questions yet"
                                />
                                <ui:TextBlock
                                    Margin="{StaticResource EmptyStateBodyMargin}"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Ask the library to find grounded answers."
                                />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
