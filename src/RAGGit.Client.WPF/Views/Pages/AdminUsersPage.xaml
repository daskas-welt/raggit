<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.AdminUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="People Management"
>
    <Page.Resources>
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullVisibility" />
        <converters:SelectedUserLabelConverter x:Key="SelectedUserLabel" />
        <converters:RoleActionLabelConverter x:Key="RoleActionLabel" />
        <converters:ActiveVerbConverter x:Key="ActiveVerb" />
        <converters:ActiveStatusLabelConverter x:Key="ActiveStatusLabel" />
        <converters:LastSignInLabelConverter x:Key="LastSignInLabel" />
        <converters:ActiveToggleLabelConverter x:Key="ActiveToggleLabel" />
        <converters:UserScopedAutomationIdConverter x:Key="UserScopedAutomationId" />
        <converters:LockedLabelConverter x:Key="LockedLabel" />
        <converters:LockStatusLabelConverter x:Key="LockStatusLabel" />
    </Page.Resources>

    <Grid x:Name="AdminLayout" Margin="0,24" SizeChanged="OnAdminLayoutSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="People Management" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Manage accounts and access"
                    />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="AddPersonButton"
                        AutomationProperties.AutomationId="AddPersonButton"
                        AutomationProperties.Name="Add person"
                        ToolTip="Add person"
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Content="Add person"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Click="OnAddPersonClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="RefreshUsersButton"
                        AutomationProperties.AutomationId="RefreshUsersButton"
                        AutomationProperties.Name="Refresh users"
                        ToolTip="Refresh users"
                        Width="44"
                        Height="44"
                        Command="{Binding LoadUsersCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="12,8"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.AutomationId="AdminStatusBar"
            AutomationProperties.LiveSetting="Polite"
            Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
        >
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="Info24" />
                            <Setter
                                Property="Foreground"
                                Value="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter
                                        Property="Foreground"
                                        Value="{ui:ThemeResource SystemFillColorSuccessBrush}"
                                    />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Warning">
                                    <Setter Property="Symbol" Value="Warning24" />
                                    <Setter
                                        Property="Foreground"
                                        Value="{ui:ThemeResource SystemFillColorCautionBrush}"
                                    />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                    <Setter
                                        Property="Foreground"
                                        Value="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                    />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <ui:TextBlock
                    FontTypography="Body"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}"
                />
            </StackPanel>
        </Border>

        <Grid x:Name="PeopleLayout" Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="DirectoryPanel"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="UserSearchBox"
                            AutomationProperties.AutomationId="UserSearchBox"
                            AutomationProperties.Name="Search people"
                            PlaceholderText="Search name or username"
                            TextChanged="OnFiltersChanged"
                            Margin="0,0,8,0"
                        />
                        <ComboBox
                            x:Name="RoleFilterCombo"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RoleFilterCombo"
                            AutomationProperties.Name="Filter by role"
                            ToolTip="Filter by role"
                            SelectedIndex="0"
                            SelectionChanged="OnFiltersChanged"
                            Margin="0,0,8,0"
                        >
                            <ComboBoxItem Content="All roles" Tag="All" />
                            <ComboBoxItem Content="Admin" Tag="Admin" />
                            <ComboBoxItem Content="Employee" Tag="Employee" />
                        </ComboBox>
                        <ComboBox
                            x:Name="StatusFilterCombo"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="StatusFilterCombo"
                            AutomationProperties.Name="Filter by account status"
                            ToolTip="Filter by account status"
                            SelectedIndex="0"
                            SelectionChanged="OnFiltersChanged"
                        >
                            <ComboBoxItem Content="All statuses" Tag="All" />
                            <ComboBoxItem Content="Active" Tag="Active" />
                            <ComboBoxItem Content="Disabled" Tag="Disabled" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            x:Name="VisibleUsersText"
                            FontTypography="Caption"
                            Style="{StaticResource SecondaryText}"
                            Text="People"
                        />
                        <ui:TextBlock
                            x:Name="SortStatusText"
                            Grid.Column="1"
                            FontTypography="Caption"
                            Style="{StaticResource SecondaryText}"
                            Text="Sorted by name, ascending"
                        />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ui:ListView
                            x:Name="UsersList"
                            SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                            SelectionMode="Single"
                            Background="Transparent"
                            BorderThickness="0"
                            TabIndex="1"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                            GridViewColumnHeader.Click="OnUserColumnHeaderClick"
                            AutomationProperties.AutomationId="UsersList"
                            AutomationProperties.Name="People directory"
                        >
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="56" />
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Width="235">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Content="Person"
                                                Tag="DisplayName"
                                                AutomationProperties.AutomationId="SortPeopleHeader"
                                                AutomationProperties.Name="Sort by person name"
                                            />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="8,4">
                                                    <ui:TextBlock
                                                        FontTypography="BodyStrong"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding DisplayName}"
                                                    />
                                                    <ui:TextBlock
                                                        FontTypography="Caption"
                                                        Style="{StaticResource SecondaryText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Text="{Binding Username}"
                                                    />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="135">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Content="Role"
                                                Tag="Role"
                                                AutomationProperties.AutomationId="SortRoleHeader"
                                                AutomationProperties.Name="Sort by role"
                                            />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    MinHeight="44"
                                                    MinWidth="112"
                                                    ItemsSource="{Binding DataContext.Roles, ElementName=UsersList}"
                                                    SelectedItem="{Binding Role, Mode=OneWay}"
                                                    IsEnabled="{Binding DataContext.IsBusy, ElementName=UsersList, Converter={StaticResource InverseBooleanConverter}}"
                                                    SelectionChanged="OnRoleSelectionChanged"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource RoleActionLabel}}"
                                                    AutomationProperties.AutomationId="{Binding Converter={StaticResource UserScopedAutomationId}, ConverterParameter=RoleSelector}"
                                                    ToolTip="Choose a role; confirmation is required"
                                                />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="190">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader
                                                Content="Account status"
                                                Tag="IsActive"
                                                AutomationProperties.AutomationId="SortStatusHeader"
                                                AutomationProperties.Name="Sort by account status"
                                            />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                >
                                                    <Border
                                                        Padding="8,4"
                                                        CornerRadius="6"
                                                        Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                                    >
                                                        <ui:TextBlock FontTypography="Caption">
                                                            <ui:TextBlock.Style>
                                                                <Style TargetType="ui:TextBlock">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="Disabled"
                                                                    />
                                                                    <Setter
                                                                        Property="Foreground"
                                                                        Value="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                                    />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsActive}"
                                                                            Value="True"
                                                                        >
                                                                            <Setter
                                                                                Property="Text"
                                                                                Value="Active"
                                                                            />
                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{ui:ThemeResource SystemFillColorSuccessBrush}"
                                                                            />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:TextBlock.Style>
                                                        </ui:TextBlock>
                                                    </Border>
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding LockedOut, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    >
                                                        <ui:SymbolIcon
                                                            Symbol="LockClosed24"
                                                            FontSize="16"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"
                                                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                        />
                                                        <ui:TextBlock
                                                            FontTypography="Caption"
                                                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                            Text="Locked"
                                                        />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="132">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Action" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button
                                                    MinWidth="112"
                                                    Height="44"
                                                    Content="{Binding IsActive, Converter={StaticResource ActiveVerb}}"
                                                    IsEnabled="{Binding DataContext.IsBusy, ElementName=UsersList, Converter={StaticResource InverseBooleanConverter}}"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource ActiveToggleLabel}}"
                                                    AutomationProperties.AutomationId="{Binding Converter={StaticResource UserScopedAutomationId}, ConverterParameter=ActiveAction}"
                                                    ToolTip="{Binding Converter={StaticResource ActiveToggleLabel}}"
                                                    Click="OnToggleActiveClicked"
                                                >
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon>
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter
                                                                        Property="Symbol"
                                                                        Value="Checkmark24"
                                                                    />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsActive}"
                                                                            Value="True"
                                                                        >
                                                                            <Setter
                                                                                Property="Symbol"
                                                                                Value="Dismiss24"
                                                                            />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                        <ui:ProgressRing
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsIndeterminate="True"
                            AutomationProperties.Name="Loading users"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        />
                        <ui:Card
                            Padding="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                        >
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon
                                    Symbol="People24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,12"
                                />
                                <ui:TextBlock
                                    HorizontalAlignment="Center"
                                    FontTypography="Title"
                                    Text="No people yet"
                                />
                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontTypography="Body"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Add a person to start managing access."
                                />
                            </StackPanel>
                        </ui:Card>
                        <ui:Card
                            x:Name="FilteredEmptyState"
                            Padding="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                        >
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon
                                    Symbol="Search24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                    Margin="0,0,0,8"
                                />
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="No matching people"
                                />
                                <ui:Button
                                    x:Name="ClearUserFiltersButton"
                                    AutomationProperties.AutomationId="ClearUserFiltersButton"
                                    AutomationProperties.Name="Clear people filters"
                                    Margin="0,8,0,0"
                                    Content="Clear filters"
                                    Click="OnClearFiltersClicked"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="DetailPanel"
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="20"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
            >
                <Grid>
                    <StackPanel
                        x:Name="NoSelectionPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    >
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon
                            Symbol="Person24"
                            Style="{StaticResource EmptyStateGlyph}"
                            Margin="0,0,0,8"
                        />
                        <ui:TextBlock
                            FontTypography="BodyStrong"
                            Text="Select a person"
                            HorizontalAlignment="Center"
                        />
                        <ui:TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SecondaryText}"
                            Text="Account details and actions will appear here."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                        />
                    </StackPanel>
                    <ScrollViewer
                        x:Name="SelectedDetailsPanel"
                        AutomationProperties.AutomationId="SelectedPersonDetails"
                        AutomationProperties.Name="Selected person details"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding SelectedUser, Converter={StaticResource NullVisibility}}"
                    >
                        <StackPanel>
                            <ui:TextBlock
                                FontTypography="Caption"
                                Style="{StaticResource SecondaryText}"
                                Text="Selected person"
                            />
                            <ui:TextBlock
                                Margin="0,4,0,0"
                                FontTypography="Title"
                                TextWrapping="Wrap"
                                Text="{Binding SelectedUser.DisplayName}"
                            />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontTypography="Body"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding SelectedUser.Username}"
                                TextWrapping="Wrap"
                            />
                            <Separator Margin="0,16,0,12" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="Account" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Role"
                                />
                                <ui:TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Text="{Binding SelectedUser.Role}"
                                />
                                <ui:TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Status"
                                />
                                <ui:TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="12,8,0,0"
                                    Text="{Binding SelectedUser.IsActive, Converter={StaticResource ActiveStatusLabel}}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Lockout"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="12,8,0,0"
                                    Text="{Binding SelectedUser.LockedOut, Converter={StaticResource LockedLabel}}"
                                />
                                <ui:TextBlock
                                    Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Created"
                                />
                                <ui:TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="12,8,0,0"
                                    Text="{Binding SelectedUser.CreatedAt, StringFormat={}{0:g}}"
                                />
                            </Grid>
                            <ui:TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding SelectedUser.LastSignInAt, Converter={StaticResource LastSignInLabel}}"
                                TextWrapping="Wrap"
                            />
                            <ui:Button
                                x:Name="OpenResetPasswordButton"
                                AutomationProperties.AutomationId="OpenResetPasswordButton"
                                AutomationProperties.Name="Reset selected person's password"
                                ToolTip="Reset selected person's password"
                                Margin="0,20,0,0"
                                Appearance="Primary"
                                Content="Reset password"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Click="OnResetPasswordClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="KeyReset24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
