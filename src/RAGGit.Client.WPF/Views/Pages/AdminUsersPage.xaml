<Page
    x:Class="RAGGit.Client.WPF.Views.Pages.AdminUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:components="clr-namespace:RAGGit.Client.WPF.Components"
    xmlns:models="clr-namespace:RAGGit.Core.Models;assembly=RAGGit.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="People Management"
>
    <Page.Resources>
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullVisibility" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
        <converters:SelectedUserLabelConverter x:Key="SelectedUserLabel" />
        <converters:RoleActionLabelConverter x:Key="RoleActionLabel" />
        <converters:ActiveVerbConverter x:Key="ActiveVerb" />
        <converters:ActiveStatusLabelConverter x:Key="ActiveStatusLabel" />
        <converters:LastSignInLabelConverter x:Key="LastSignInLabel" />
        <converters:ActiveToggleLabelConverter x:Key="ActiveToggleLabel" />
        <converters:UserScopedAutomationIdConverter x:Key="UserScopedAutomationId" />
        <converters:LockedLabelConverter x:Key="LockedLabel" />
        <converters:LockStatusLabelConverter x:Key="LockStatusLabel" />
    </Page.Resources>

    <Grid x:Name="AdminLayout" SizeChanged="OnAdminLayoutSizeChanged">
        <Grid.RowDefinitions>
            <!-- Outer page inset; was the root PagePadding (0,24) margin. -->
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <ui:Card Grid.Row="1" Style="{StaticResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Style="{StaticResource PageTitleText}" Text="People Management" />
                    <ui:TextBlock
                        Style="{StaticResource PageSubtitleText}"
                        Text="Manage accounts and access"
                    />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        x:Name="AddPersonButton"
                        AutomationProperties.AutomationId="AddPersonButton"
                        AutomationProperties.Name="Add person"
                        ToolTip="Add person"
                        Appearance="Primary"
                        Content="Add person"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Click="OnAddPersonClicked"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="RefreshUsersButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="RefreshUsersButton"
                        AutomationProperties.Name="Refresh users"
                        ToolTip="Refresh users"
                        Width="44"
                        Height="44"
                        Command="{Binding LoadUsersCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    >
                        <Grid Width="24" Height="24">
                            <ui:SymbolIcon
                                Symbol="ArrowClockwise24"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolVisibility}}"
                            />
                            <ui:ProgressRing
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="Refreshing users"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                            />
                        </Grid>
                    </ui:Button>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- The wrapper owns the 12px leading inset so it collapses with the bar. -->
        <Grid
            Grid.Row="2"
            Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <components:StatusFooterControl
                Grid.Row="1"
                Message="{Binding StatusMessage, Mode=OneWay}"
                Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
                IsOpen="{Binding HasStatus, Mode=OneWay}"
                IsBusy="{Binding IsBusy, Mode=OneWay}"
                RetryContent="Retry"
                StatusAutomationId="AdminStatusBar"
                RetryAutomationId="AdminRetryButton"
            >
                <components:StatusFooterControl.Style>
                    <Style TargetType="components:StatusFooterControl">
                        <!-- A successful load has nothing to retry; failures keep the action. -->
                        <Setter Property="RetryCommand" Value="{Binding LoadUsersCommand}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                <Setter Property="RetryCommand" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </components:StatusFooterControl.Style>
            </components:StatusFooterControl>
        </Grid>

        <Grid x:Name="PeopleLayout" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <!-- Wide: a 16px column gutter (the panels' 8px margins summed) and a 312px detail
                 track (the old 320px track less the 8px inset it carried). Compact: the column
                 gutter closes and row gutter 1 opens, see ApplyResponsiveLayout. -->
            <ui:Card
                x:Name="DirectoryPanel"
                Grid.Row="0"
                Grid.Column="0"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <!-- 137 = the role filter's old 145 track less the 8px gutter its margin held. -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="137" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="UserSearchBox"
                            AutomationProperties.AutomationId="UserSearchBox"
                            AutomationProperties.Name="Search people"
                            PlaceholderText="Search name or username"
                            TextChanged="OnFiltersChanged"
                        />
                        <ComboBox
                            x:Name="RoleFilterCombo"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RoleFilterCombo"
                            AutomationProperties.Name="Filter by role"
                            ToolTip="Filter by role"
                            SelectedIndex="0"
                            SelectionChanged="OnFiltersChanged"
                        >
                            <ComboBoxItem Content="All roles" Tag="All" />
                            <ComboBoxItem Content="Admin" Tag="Admin" />
                            <ComboBoxItem Content="Employee" Tag="Employee" />
                        </ComboBox>
                        <ComboBox
                            x:Name="StatusFilterCombo"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="StatusFilterCombo"
                            AutomationProperties.Name="Filter by account status"
                            ToolTip="Filter by account status"
                            SelectedIndex="0"
                            SelectionChanged="OnFiltersChanged"
                        >
                            <ComboBoxItem Content="All statuses" Tag="All" />
                            <ComboBoxItem Content="Active" Tag="Active" />
                            <ComboBoxItem Content="Disabled" Tag="Disabled" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            x:Name="VisibleUsersText"
                            FontTypography="Caption"
                            Style="{StaticResource SecondaryText}"
                            Text="People"
                        />
                        <ui:TextBlock
                            x:Name="SortStatusText"
                            Grid.Column="1"
                            FontTypography="Caption"
                            Style="{StaticResource SecondaryText}"
                            Text="Sorted by name, ascending"
                        />
                    </Grid>
                    <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Pinned header (feature 029, FR-008): the GridView header scrolls away
                             with its rows, so it is suppressed and this sibling row carries the
                             sort affordances. It stays put while the list below scrolls, and the
                             sort indicator is rewritten by the click handler. -->
                        <Grid x:Name="PeopleHeader" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <GridViewColumnHeader
                                Content="Person"
                                Tag="DisplayName"
                                AutomationProperties.AutomationId="SortPeopleHeader"
                                AutomationProperties.Name="Sort by person name"
                                Click="OnUserColumnHeaderClick"
                            />
                            <GridViewColumnHeader
                                Grid.Column="1"
                                Content="Role"
                                Tag="Role"
                                AutomationProperties.AutomationId="SortRoleHeader"
                                AutomationProperties.Name="Sort by role"
                                Click="OnUserColumnHeaderClick"
                            />
                            <GridViewColumnHeader
                                Grid.Column="2"
                                Content="Account status"
                                Tag="IsActive"
                                AutomationProperties.AutomationId="SortStatusHeader"
                                AutomationProperties.Name="Sort by account status"
                                Click="OnUserColumnHeaderClick"
                            />
                            <GridViewColumnHeader Grid.Column="3" Content="Action" />
                            <Border
                                Grid.ColumnSpan="4"
                                Height="1"
                                IsHitTestVisible="False"
                                VerticalAlignment="Bottom"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                            />
                        </Grid>
                        <ui:ListView
                            Grid.Row="2"
                            x:Name="UsersList"
                            SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                            SelectionMode="Single"
                            Background="Transparent"
                            BorderThickness="0"
                            TabIndex="1"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                            AutomationProperties.AutomationId="UsersList"
                            AutomationProperties.Name="People directory"
                        >
                            <ui:ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="56" />
                                </Style>
                            </ui:ListView.ItemContainerStyle>
                            <ui:ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="235">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="4" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="4" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                    >
                                                        <ui:TextBlock
                                                            FontTypography="BodyStrong"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{Binding DisplayName}"
                                                        />
                                                        <ui:TextBlock
                                                            FontTypography="Caption"
                                                            Style="{StaticResource SecondaryText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{Binding Username}"
                                                        />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    MinHeight="44"
                                                    MinWidth="112"
                                                    ItemsSource="{Binding DataContext.Roles, ElementName=UsersList}"
                                                    SelectedItem="{Binding Role, Mode=OneWay}"
                                                    IsEnabled="{Binding DataContext.IsBusy, ElementName=UsersList, Converter={StaticResource InverseBooleanConverter}}"
                                                    SelectionChanged="OnRoleSelectionChanged"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource RoleActionLabel}}"
                                                    AutomationProperties.AutomationId="{Binding Converter={StaticResource UserScopedAutomationId}, ConverterParameter=RoleSelector}"
                                                    ToolTip="Choose a role; confirmation is required"
                                                />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Padding="8,4"
                                                        CornerRadius="6"
                                                        Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                                    >
                                                        <ui:TextBlock FontTypography="Caption">
                                                            <ui:TextBlock.Style>
                                                                <Style TargetType="ui:TextBlock">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="Disabled"
                                                                    />
                                                                    <Setter
                                                                        Property="Foreground"
                                                                        Value="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                                    />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsActive}"
                                                                            Value="True"
                                                                        >
                                                                            <Setter
                                                                                Property="Text"
                                                                                Value="Active"
                                                                            />
                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{ui:ThemeResource SystemFillColorSuccessBrush}"
                                                                            />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:TextBlock.Style>
                                                        </ui:TextBlock>
                                                    </Border>
                                                    <Grid
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding LockedOut, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    >
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon
                                                            Symbol="LockClosed24"
                                                            FontSize="16"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                        />
                                                        <ui:TextBlock
                                                            Grid.Column="2"
                                                            FontTypography="Caption"
                                                            Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                            Text="Locked"
                                                        />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="132">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button
                                                    MinWidth="112"
                                                    Height="44"
                                                    Content="{Binding IsActive, Converter={StaticResource ActiveVerb}}"
                                                    IsEnabled="{Binding DataContext.IsBusy, ElementName=UsersList, Converter={StaticResource InverseBooleanConverter}}"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource ActiveToggleLabel}}"
                                                    AutomationProperties.AutomationId="{Binding Converter={StaticResource UserScopedAutomationId}, ConverterParameter=ActiveAction}"
                                                    ToolTip="{Binding Converter={StaticResource ActiveToggleLabel}}"
                                                    Click="OnToggleActiveClicked"
                                                >
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon>
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter
                                                                        Property="Symbol"
                                                                        Value="Checkmark24"
                                                                    />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsActive}"
                                                                            Value="True"
                                                                        >
                                                                            <Setter
                                                                                Property="Symbol"
                                                                                Value="Dismiss24"
                                                                            />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                        <ui:ProgressRing
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsIndeterminate="True"
                            AutomationProperties.Name="Loading users"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        />
                        <ui:Card
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource EmptyStateCard}"
                            Visibility="{Binding ShowEmptyUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AdminEmptyState"
                            AutomationProperties.Name="No people yet"
                        >
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon
                                    Grid.Row="0"
                                    Symbol="People24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource EmptyStateTitleText}"
                                    Text="No people yet"
                                />
                                <ui:TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource EmptyStateBodyText}"
                                    Text="Add a person to start managing access."
                                />
                                <ui:Button
                                    Grid.Row="6"
                                    HorizontalAlignment="Center"
                                    Appearance="Primary"
                                    AutomationProperties.AutomationId="AdminEmptyAddPersonButton"
                                    AutomationProperties.Name="Add person"
                                    Content="Add person"
                                    ToolTip="Add person"
                                    Click="OnAddPersonClicked"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PersonAdd24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                        <ui:Card
                            x:Name="FilteredEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource EmptyStateCard}"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="AdminNoMatchState"
                            AutomationProperties.Name="No matching people"
                        >
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon
                                    Grid.Row="0"
                                    Symbol="Search24"
                                    Style="{StaticResource EmptyStateGlyph}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource EmptyStateTitleText}"
                                    Text="No matching people"
                                />
                                <ui:TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource EmptyStateBodyText}"
                                    Text="No one matches these filters."
                                />
                                <ui:Button
                                    x:Name="ClearUserFiltersButton"
                                    Grid.Row="6"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.AutomationId="ClearUserFiltersButton"
                                    AutomationProperties.Name="Clear people filters"
                                    Content="Clear filters"
                                    Click="OnClearFiltersClicked"
                                >
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Dismiss24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card
                x:Name="DetailPanel"
                Grid.Row="0"
                Grid.Column="2"
                Padding="{StaticResource CardPaddingMedium}"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
            >
                <Grid>
                    <Grid
                        x:Name="NoSelectionPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ui:SymbolIcon
                            Grid.Row="0"
                            Symbol="Person24"
                            Style="{StaticResource EmptyStateGlyph}"
                        />
                        <ui:TextBlock
                            Grid.Row="2"
                            FontTypography="BodyStrong"
                            Text="Select a person"
                            HorizontalAlignment="Center"
                        />
                        <ui:TextBlock
                            Grid.Row="4"
                            Style="{StaticResource EmptyStateBodyText}"
                            Text="Account details and actions will appear here."
                        />
                    </Grid>
                    <ScrollViewer
                        x:Name="SelectedDetailsPanel"
                        AutomationProperties.AutomationId="SelectedPersonDetails"
                        AutomationProperties.Name="Selected person details"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding SelectedUser, Converter={StaticResource NullVisibility}}"
                    >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock
                                Grid.Row="0"
                                FontTypography="Caption"
                                Style="{StaticResource SecondaryText}"
                                Text="Selected person"
                            />
                            <ui:TextBlock
                                Grid.Row="2"
                                Style="{StaticResource PanelHeaderText}"
                                TextWrapping="Wrap"
                                Text="{Binding SelectedUser.DisplayName}"
                            />
                            <ui:TextBlock
                                Grid.Row="4"
                                FontTypography="Body"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding SelectedUser.Username}"
                                TextWrapping="Wrap"
                            />
                            <Separator Grid.Row="6" />
                            <ui:TextBlock Grid.Row="8" FontTypography="BodyStrong" Text="Account" />
                            <Grid Grid.Row="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Role"
                                />
                                <ui:TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Text="{Binding SelectedUser.Role}"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Status"
                                />
                                <ui:TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Text="{Binding SelectedUser.IsActive, Converter={StaticResource ActiveStatusLabel}}"
                                />
                                <ui:TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Lockout"
                                />
                                <ui:TextBlock
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Text="{Binding SelectedUser.LockedOut, Converter={StaticResource LockedLabel}}"
                                />
                                <ui:TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Created"
                                />
                                <ui:TextBlock
                                    Grid.Row="6"
                                    Grid.Column="2"
                                    Text="{Binding SelectedUser.CreatedAt, StringFormat={}{0:g}}"
                                />
                            </Grid>
                            <ui:TextBlock
                                Grid.Row="12"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding SelectedUser.LastSignInAt, Converter={StaticResource LastSignInLabel}}"
                                TextWrapping="Wrap"
                            />
                            <ui:Button
                                x:Name="OpenResetPasswordButton"
                                Grid.Row="14"
                                AutomationProperties.AutomationId="OpenResetPasswordButton"
                                AutomationProperties.Name="Reset selected person's password"
                                ToolTip="Reset selected person's password"
                                Appearance="Primary"
                                Content="Reset password"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Click="OnResetPasswordClicked"
                            >
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="KeyReset24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
