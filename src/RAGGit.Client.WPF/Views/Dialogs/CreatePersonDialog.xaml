<UserControl
    x:Class="RAGGit.Client.WPF.Views.Dialogs.CreatePersonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
>
    <UserControl.Resources>
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Intro line's former bottom margin. -->
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <!-- Field label to its input (the input's former top margin). -->
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <!-- Field input to the next label (the input's former bottom margin). -->
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <!-- Status bar to the action row (the bar's former bottom margin). -->
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock
            Grid.Row="0"
            Style="{StaticResource SecondaryText}"
            Text="Create an account for someone who needs workstation access."
            TextWrapping="Wrap"
        />

        <ui:TextBlock Grid.Row="2" FontTypography="Body" Text="Username" />
        <ui:TextBox
            x:Name="NewUsernameBox"
            Grid.Row="4"
            AutomationProperties.AutomationId="NewUsernameBox"
            AutomationProperties.Name="Username"
            PlaceholderText="Unique login name"
            Text="{Binding NewUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />

        <ui:TextBlock Grid.Row="6" FontTypography="Body" Text="Display name" />
        <ui:TextBox
            x:Name="NewDisplayNameBox"
            Grid.Row="8"
            AutomationProperties.AutomationId="NewDisplayNameBox"
            AutomationProperties.Name="Display name"
            PlaceholderText="Name shown in the directory"
            Text="{Binding NewDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />

        <ui:TextBlock Grid.Row="10" FontTypography="Body" Text="Role" />
        <ComboBox
            x:Name="NewRoleCombo"
            Grid.Row="12"
            AutomationProperties.AutomationId="NewRoleCombo"
            AutomationProperties.Name="Role"
            ItemsSource="{Binding Roles}"
            SelectedItem="{Binding NewRole, Mode=TwoWay}"
        />

        <ui:TextBlock Grid.Row="14" FontTypography="Body" Text="Initial password" />
        <ui:PasswordBox
            x:Name="NewPasswordBox"
            Grid.Row="16"
            AutomationProperties.AutomationId="NewPasswordBox"
            AutomationProperties.Name="Initial password"
            PlaceholderText="At least 10 characters"
            Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />

        <ui:InfoBar
            Grid.Row="18"
            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}}"
            IsOpen="{Binding HasStatus}"
            IsClosable="False"
            Message="{Binding StatusMessage}"
        />

        <Grid Grid.Row="20" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Button gutter: the confirm button's former right margin. -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Confirming action first, dismissing action last (029, FR-012). -->
            <ui:Button
                x:Name="CreateUserButton"
                Grid.Column="0"
                AutomationProperties.AutomationId="CreateUserButton"
                AutomationProperties.Name="Create user"
                ToolTip="Create user"
                Appearance="Primary"
                Content="Create person"
                MinWidth="{StaticResource DialogPrimaryButtonMinWidth}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                Click="OnCreateClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PersonAdd24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                x:Name="CancelCreateButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="CancelCreateButton"
                AutomationProperties.Name="Cancel adding person"
                Content="Cancel"
                MinWidth="{StaticResource DialogSecondaryButtonMinWidth}"
                Click="OnCancelClicked"
            >
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Grid>
</UserControl>
