<Window
    x:Class="RAGGit.Client.WPF.Views.Dialogs.UploadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:services="clr-namespace:RAGGit.Client.Maui.Services;assembly=RAGGit.Client.Core"
    Title="Upload Documents"
    Icon="pack://application:,,,/Assets/RaggitIcon.ico"
    Width="520"
    MinWidth="420"
    MinHeight="400"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
>
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
    </Window.Resources>
    <!-- Option A layout: one intake card (drop zone with the browse action
         inside it) feeding one queue card whose content swaps between a
         placeholder and the list. Upload/Cancel buttons sit in the footer;
         the InfoBar carries outcomes/errors only. Spacing follows the 4px
         scale (4/8/12). -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intake: drop zone + browse action + supported-types hint -->
        <Border
            Grid.Row="0"
            x:Name="DropArea"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            AllowDrop="True"
            DragOver="DropArea_DragOver"
            DragLeave="DropArea_DragLeave"
            Drop="DropArea_Drop"
            AutomationProperties.AutomationId="UploadDropArea"
            AutomationProperties.Name="Drop files here"
        >
            <Grid>
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="ArrowUpload24"
                        HorizontalAlignment="Center"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    />
                    <ui:TextBlock
                        Text="Add documents"
                        FontTypography="BodyStrong"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                    />
                    <ui:TextBlock
                        Text="Drop files here or browse from your device"
                        FontTypography="Body"
                        Style="{StaticResource SecondaryText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                    />
                    <ui:Button
                        x:Name="AddFilesButton"
                        Command="{Binding PickFileCommand}"
                        HorizontalAlignment="Center"
                        Width="44"
                        Height="44"
                        Margin="0,8,0,0"
                        AutomationProperties.AutomationId="AddFilesButton"
                        AutomationProperties.Name="Browse files"
                        ToolTip="Browse files"
                    >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBlock
                        Text="{Binding SupportedTypesText, Mode=OneWay}"
                        FontTypography="Caption"
                        Style="{StaticResource SecondaryText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
                <!-- Drag-over highlight: accent outline over the idle area -->
                <Border
                    BorderThickness="2"
                    CornerRadius="8"
                    Margin="-16,-12"
                    IsHitTestVisible="False"
                    BorderBrush="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                    Visibility="{Binding IsDragOver, Converter={StaticResource BoolVisibility}}"
                />
            </Grid>
        </Border>

        <!-- Pick-time rejection: immediate plain-language message -->
        <ui:InfoBar
            Grid.Row="1"
            Severity="Warning"
            IsOpen="{Binding HasRejection, Mode=OneWay}"
            Message="{Binding RejectionMessage, Mode=OneWay}"
            IsClosable="False"
            Margin="0,12,0,0"
        />

        <!-- Single queue card: header + placeholder/list swap -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="Upload queue" FontTypography="BodyStrong" />
                    <ui:TextBlock
                        Grid.Column="1"
                        Text="{Binding QueueHeaderText, Mode=OneWay}"
                        FontTypography="Caption"
                        Style="{StaticResource SecondaryText}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                    />
                </Grid>
                <ui:ListView
                    x:Name="QueueList"
                    ItemsSource="{Binding Queue}"
                    MaxHeight="260"
                    SelectionMode="Single"
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="0,8,0,0"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{Binding HasFiles, Converter={StaticResource BoolVisibility}}"
                    AutomationProperties.AutomationId="UploadQueueList"
                    AutomationProperties.Name="Files to upload"
                >
                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ui:ListView.ItemContainerStyle>
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Symbol="Document24"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Top"
                                    Margin="2,2,10,0"
                                />
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock
                                        Text="{Binding FileName}"
                                        FontTypography="Body"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <ui:TextBlock
                                        Text="{Binding FileMetaText}"
                                        FontTypography="Caption"
                                        Style="{StaticResource SecondaryText}"
                                        Margin="0,4,0,0"
                                    />
                                    <ProgressBar
                                        Value="{Binding Progress, Mode=OneWay}"
                                        Maximum="1"
                                        Height="4"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
                                        IsIndeterminate="{Binding IsIndexing, Mode=OneWay}"
                                        AutomationProperties.Name="Upload progress"
                                    />
                                    <ui:TextBlock
                                        Text="{Binding StateLabel, Mode=OneWay}"
                                        FontTypography="Caption"
                                        Style="{StaticResource SecondaryText}"
                                        Margin="0,4,0,0"
                                    />
                                    <ui:TextBlock
                                        Text="{Binding ErrorMessage, Mode=OneWay}"
                                        FontTypography="Caption"
                                        Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"
                                    />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="2"
                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    ToolTip="Remove file"
                                    AutomationProperties.AutomationId="{Binding RemoveAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="Remove file"
                                >
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
                <StackPanel
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasFiles, Converter={StaticResource InvertedBoolVisibility}}"
                >
                    <ui:SymbolIcon
                        Symbol="Document24"
                        HorizontalAlignment="Center"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    />
                    <ui:TextBlock
                        Text="No files yet"
                        FontTypography="BodyStrong"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                    />
                    <ui:TextBlock
                        Text="Drop files above or choose Browse files to build the queue."
                        FontTypography="Body"
                        Style="{StaticResource SecondaryText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Summary outcome: full success auto-closes (see code-behind);
             any failure/cancel stays open with per-file outcomes above. -->
        <ui:InfoBar
            Grid.Row="3"
            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
            IsOpen="{Binding HasStatus, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
            IsClosable="False"
            Margin="0,12,0,0"
        />

        <ui:TextBlock
            Grid.Row="4"
            Text="{Binding ClosingStopsUploadHint, Mode=OneWay}"
            Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
            FontTypography="Caption"
            Style="{StaticResource SecondaryText}"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
        />

        <!-- Footer actions -->
        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
        >
            <ProgressBar
                Value="{Binding UploadProgress, Mode=OneWay}"
                Maximum="1"
                Width="160"
                Height="6"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.Name="Overall upload progress"
            />
            <ui:Button
                Content="Upload"
                Command="{Binding UploadCommand}"
                Appearance="Primary"
                MinWidth="90"
                Margin="0,0,8,0"
            />
            <ui:Button
                Content="Cancel"
                Command="{Binding CancelUploadCommand}"
                MinWidth="90"
                Margin="0,0,8,0"
                Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
            />
            <ui:Button Content="Close" MinWidth="90" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
