<UserControl
    x:Class="RAGGit.Client.WPF.Components.PaginationFooterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:RAGGit.Client.WPF.Components"
    x:Name="Root"
>
    <UserControl.Resources>
        <DataTemplate x:Key="CurrentPageTemplate">
            <ui:Button
                Content="{Binding Page}"
                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding Page}"
                Appearance="Primary"
                FontWeight="SemiBold"
                Padding="8,4"
                MinWidth="44"
                MinHeight="44"
                VerticalAlignment="Center"
            />
        </DataTemplate>
        <DataTemplate x:Key="PageNumberTemplate">
            <ui:Button
                Content="{Binding Page}"
                Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding Page}"
                Appearance="Transparent"
                Padding="8,4"
                MinWidth="44"
                MinHeight="44"
                VerticalAlignment="Center"
            />
        </DataTemplate>
        <DataTemplate x:Key="EllipsisTemplate">
            <ui:TextBlock Text="…" FontTypography="Body" Padding="8,4" VerticalAlignment="Center" />
        </DataTemplate>
        <local:PageTokenTemplateSelector
            x:Key="TokenSelector"
            CurrentPageTemplate="{StaticResource CurrentPageTemplate}"
            NumberTemplate="{StaticResource PageNumberTemplate}"
            EllipsisTemplate="{StaticResource EllipsisTemplate}"
        />
    </UserControl.Resources>

    <Border BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock
                    Text="Rows per page"
                    FontTypography="Caption"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                />
                <ComboBox
                    ItemsSource="{Binding PageSizeOptions, ElementName=Root}"
                    SelectedItem="{Binding SelectedPageSize, ElementName=Root, Mode=TwoWay}"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PageSizeCombo"
                />
            </StackPanel>
            <ui:TextBlock
                Grid.Column="1"
                Text="{Binding StatusText, ElementName=Root}"
                FontTypography="Caption"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            />
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
            >
                <ui:Button
                    Command="{Binding FirstCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                    Appearance="Transparent"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="FirstPageButton"
                    AutomationProperties.Name="First page"
                    ToolTip="First page"
                >
                    <ui:SymbolIcon Symbol="ChevronDoubleLeft20" />
                </ui:Button>
                <ui:Button
                    Command="{Binding PreviousCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                    Appearance="Transparent"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PreviousPageButton"
                    AutomationProperties.Name="Previous page"
                    ToolTip="Previous page"
                >
                    <ui:SymbolIcon Symbol="ChevronLeft20" />
                </ui:Button>
                <ItemsControl
                    ItemsSource="{Binding Sequence, ElementName=Root}"
                    ItemTemplateSelector="{StaticResource TokenSelector}"
                    VerticalAlignment="Center"
                    Margin="4,0"
                >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ui:Button
                    Command="{Binding NextCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoNext, ElementName=Root}"
                    Appearance="Transparent"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NextPageButton"
                    AutomationProperties.Name="Next page"
                    ToolTip="Next page"
                >
                    <ui:SymbolIcon Symbol="ChevronRight20" />
                </ui:Button>
                <ui:Button
                    Command="{Binding LastCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoNext, ElementName=Root}"
                    Appearance="Transparent"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="LastPageButton"
                    AutomationProperties.Name="Last page"
                    ToolTip="Last page"
                >
                    <ui:SymbolIcon Symbol="ChevronDoubleRight20" />
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
