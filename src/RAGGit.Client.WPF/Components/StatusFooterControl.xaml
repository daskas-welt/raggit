<UserControl
    x:Class="RAGGit.Client.WPF.Components.StatusFooterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
>
    <!-- Shared status/error footer (feature 028): one severity-styled InfoBar
         plus an optional retry action. The message always wraps (never trims);
         the retry button only shows while open with a command to run. -->
    <Grid ColumnDefinitions="*, Auto">
        <ui:InfoBar
            Grid.Column="0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{Binding StatusAutomationId, ElementName=Root, Mode=OneWay}"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="{Binding IsOpen, ElementName=Root, Mode=OneWay}"
            Message="{Binding Message, ElementName=Root, Mode=OneWay}"
            Severity="{Binding Severity, ElementName=Root, Mode=OneWay}"
        />
        <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            MinHeight="44"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="{Binding RetryAutomationId, ElementName=Root, Mode=OneWay}"
            Command="{Binding RetryCommand, ElementName=Root, Mode=OneWay}"
            Content="{Binding RetryContent, ElementName=Root, Mode=OneWay}"
            ToolTip="{Binding RetryContent, ElementName=Root, Mode=OneWay}"
        >
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowClockwise24" />
            </ui:Button.Icon>
            <ui:Button.Style>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding RetryCommand, ElementName=Root}"
                            Value="{x:Null}"
                        >
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Button.Style>
        </ui:Button>
    </Grid>
</UserControl>
