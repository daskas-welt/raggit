<UserControl
    x:Class="RAGGit.Client.WPF.Components.ChatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:RAGGit.Client.WPF.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="Root"
>
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:CitationOrdinalConverter x:Key="CitationOrdinal" />
        <converters:CitationDocumentNameConverter x:Key="CitationDocumentName" />
        <converters:CitationSubtitleConverter x:Key="CitationSubtitle" />
        <!-- Shared bubble widths (feature 028 US4): one source for every
             realized message instead of per-instance literals. -->
        <sys:Double x:Key="ChatUserBubbleMaxWidth">400</sys:Double>
        <sys:Double x:Key="ChatAssistantBubbleMaxWidth">500</sys:Double>
    </UserControl.Resources>
    <Grid>
        <!-- Gutter row: the 8px above the input bar. The reasoning block carries
             its own leading gutter so a hidden region leaves no gap behind. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Messages -->
        <ListBox
            Grid.Row="0"
            x:Name="MessagesList"
            ItemsSource="{Binding Messages, ElementName=Root}"
            SelectionMode="Single"
            BorderThickness="0"
            Background="Transparent"
            HorizontalContentAlignment="Stretch"
        >
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch">
                        <!-- 4px top/bottom insets (was Margin="0,4"). -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="4" />
                        </Grid.RowDefinitions>
                        <!-- User message (right-aligned) -->
                        <Border
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            MaxWidth="{StaticResource ChatUserBubbleMaxWidth}"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="16,16,4,16"
                            Padding="12,8"
                            Visibility="{Binding IsUser, Converter={StaticResource BoolVisibility}}"
                        >
                            <StackPanel>
                                <ui:TextBlock
                                    Text="{Binding Text}"
                                    Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontTypography="Body"
                                    TextWrapping="Wrap"
                                />
                                <ui:Button
                                    HorizontalAlignment="Right"
                                    Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    ToolTip="Copy message"
                                    AutomationProperties.AutomationId="CopyMessageButton"
                                    AutomationProperties.Name="Copy message"
                                    Click="CopyMessageButton_Click"
                                >
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button>
                            </StackPanel>
                        </Border>
                        <!-- Assistant message (left-aligned) -->
                        <Border
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            MaxWidth="{StaticResource ChatAssistantBubbleMaxWidth}"
                            BorderThickness="1"
                            CornerRadius="16,16,16,4"
                            Padding="12,8"
                            Visibility="{Binding IsUser, Converter={StaticResource InvertedBoolVisibility}}"
                        >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!-- The expander block carries its own 8px leading gap so a
                                         message without citations leaves no gap behind. -->
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock
                                    Grid.Row="0"
                                    Text="{Binding Text}"
                                    FontTypography="Body"
                                    TextWrapping="Wrap"
                                />
                                <Grid
                                    Grid.Row="1"
                                    Visibility="{Binding HasCitations, Converter={StaticResource BoolVisibility}}"
                                >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ui:CardExpander
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="{Binding SourcesAutomationId}"
                                    >
                                        <ui:CardExpander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- 6px icon-to-label gap (was the icon Margin). -->
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- 4px label-to-count gap (was the label Margin). -->
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon
                                                    Grid.Column="0"
                                                    Symbol="TextQuote24"
                                                    VerticalAlignment="Center"
                                                />
                                                <ui:TextBlock Grid.Column="2" Text="Sources" />
                                                <ui:TextBlock
                                                    Grid.Column="4"
                                                    Text="{Binding Citations.Count}"
                                                    Style="{StaticResource SecondaryText}"
                                                />
                                            </Grid>
                                        </ui:CardExpander.Header>
                                        <ListBox
                                            ItemsSource="{Binding Citations}"
                                            SelectionMode="Single"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.AutomationId="{Binding MessageCitationsAutomationId}"
                                        >
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter
                                                        Property="HorizontalContentAlignment"
                                                        Value="Stretch"
                                                    />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Wrapper carries the former Margin="0,2" as edge rows. -->
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="2" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="2" />
                                                        </Grid.RowDefinitions>
                                                        <Border
                                                            Grid.Row="1"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="8"
                                                        >
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- 8px ordinal-to-text gap (was the StackPanel Margin). -->
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    Grid.Column="0"
                                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="6,3"
                                                                    VerticalAlignment="Top"
                                                                >
                                                                    <ui:TextBlock
                                                                        Text="{Binding Ordinal, Converter={StaticResource CitationOrdinal}}"
                                                                        FontTypography="Caption"
                                                                        Foreground="{ui:ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                    />
                                                                </Border>
                                                                <StackPanel Grid.Column="2">
                                                                    <ui:TextBlock
                                                                        Text="{Binding Converter={StaticResource CitationDocumentName}}"
                                                                        FontTypography="Caption"
                                                                        TextTrimming="CharacterEllipsis"
                                                                    />
                                                                    <ui:TextBlock
                                                                        Text="{Binding Text}"
                                                                        FontTypography="Body"
                                                                        TextWrapping="Wrap"
                                                                    />
                                                                    <ui:TextBlock
                                                                        Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                                                        FontTypography="Caption"
                                                                        Style="{StaticResource SecondaryText}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                    />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ui:CardExpander>
                                </Grid>
                                <ui:Button
                                    Grid.Row="2"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    ToolTip="Copy message"
                                    AutomationProperties.AutomationId="CopyMessageButton"
                                    AutomationProperties.Name="Copy message"
                                    Click="CopyMessageButton_Click"
                                >
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state (toggled in code-behind) -->
        <Grid
            x:Name="EmptyState"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 12px glyph-to-title gap (was the glyph Margin). -->
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <!-- 12px title-to-body gap (was EmptyStateBodyMargin). -->
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:SymbolIcon Grid.Row="0" Symbol="Chat24" Style="{StaticResource EmptyStateGlyph}" />
            <ui:TextBlock
                Grid.Row="2"
                Text="Ask a question to get started"
                FontTypography="Title"
                HorizontalAlignment="Center"
            />
            <ui:TextBlock
                Grid.Row="4"
                Text="Your conversation will appear here."
                FontTypography="Body"
                Style="{StaticResource SecondaryText}"
                HorizontalAlignment="Center"
            />
        </Grid>

        <!-- Input bar (fixed at bottom) -->
        <Border Grid.Row="2" BorderThickness="1" CornerRadius="24" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- 8px input-to-send gap (was the button Margin). -->
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    x:Name="InputBox"
                    Text="{Binding InputText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Type your question..."
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    KeyDown="InputBox_KeyDown"
                    AutomationProperties.AutomationId="ChatInputBox"
                />
                <ui:Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="SendQuestionButton"
                    AutomationProperties.Name="Send question"
                    ToolTip="Send question"
                    Command="{Binding SendCommand, ElementName=Root}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                >
                    <Grid Width="24" Height="24">
                        <ui:SymbolIcon
                            Symbol="Send24"
                            Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource InvertedBoolVisibility}}"
                        />
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            IsIndeterminate="True"
                            AutomationProperties.Name="Sending question"
                            Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolVisibility}}"
                        />
                    </Grid>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Live reasoning: what the workstation is doing while answering (032).
             Replaces the former static busy line; the ViewModel clears it the
             moment the answer or a failure is presented. -->
        <Grid
            Grid.Row="3"
            Visibility="{Binding HasReasoning, ElementName=Root, Converter={StaticResource BoolVisibility}}"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox
                x:Name="ReasoningRegion"
                Grid.Row="1"
                ItemsSource="{Binding ReasoningSteps, ElementName=Root}"
                SelectionMode="Single"
                BorderThickness="0"
                Background="Transparent"
                IsHitTestVisible="False"
                Focusable="False"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="ReasoningProgressList"
                AutomationProperties.Name="Work in progress"
            >
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Fixed first column keeps older rows aligned when the
                         activity indicator is collapsed. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 2px top/bottom insets (was Margin="0,2"). -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <ui:ProgressRing
                                Grid.Row="1"
                                Width="14"
                                Height="14"
                                IsIndeterminate="True"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolVisibility}}"
                            />
                            <ui:TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Text}"
                                FontTypography="Caption"
                                Style="{StaticResource SecondaryText}"
                                TextWrapping="Wrap"
                            />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
