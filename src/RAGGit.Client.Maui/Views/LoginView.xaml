<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RAGGit.Client.Maui.ViewModels"
    x:Class="RAGGit.Client.Maui.Views.LoginView"
    Title="Sign in"
>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="24" RowSpacing="12">
        <Label
            Grid.Row="0"
            Text="RAGGit"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center"
        />
        <Label
            Grid.Row="1"
            Text="Sign in to the AI Workstation"
            FontSize="Subtitle"
            HorizontalOptions="Center"
            Margin="0,0,0,12"
        />

        <Entry
            Grid.Row="2"
            Placeholder="Workstation URL"
            Text="{Binding WorkstationUrl}"
            IsReadOnly="True"
            Keyboard="Url"
        />

        <Entry
            Grid.Row="3"
            Placeholder="Username"
            Text="{Binding Username}"
            AutomationProperties.Name="Username"
        />

        <Entry
            Grid.Row="4"
            Placeholder="Password"
            Text="{Binding Password}"
            IsPassword="True"
            AutomationProperties.Name="Password"
        />

        <Button
            Grid.Row="5"
            Text="Sign in"
            Command="{Binding LoginCommand}"
        />

        <ActivityIndicator
            Grid.Row="6"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
        />

        <Label
            Grid.Row="7"
            Text="{Binding ErrorMessage}"
            TextColor="Red"
            VerticalOptions="Start"
        />
    </Grid>
</ContentPage>
