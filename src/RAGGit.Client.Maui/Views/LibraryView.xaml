<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RAGGit.Client.Maui.Views.LibraryView"
             Title="Library">
  <Grid RowDefinitions="Auto,*" Padding="12">
    <Button Grid.Row="0"
            Text="Upload"
            Command="{Binding UploadCommand}"
            IsVisible="{Binding IsAdmin}"
            Margin="0,0,0,12" />
    <RefreshView Grid.Row="1"
                 Command="{Binding LoadDocumentsCommand}"
                 IsRefreshing="{Binding IsBusy}">
      <CollectionView ItemsSource="{Binding Documents}"
                      EmptyView="No documents in the library.">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto,Auto"
                  Padding="8,4"
                  ColumnSpacing="8">
              <Label Text="{Binding Filename}"
                     VerticalOptions="Center" />
              <Label Grid.Column="1"
                     Text="{Binding Status}"
                     VerticalOptions="Center" />
              <Button Grid.Column="2"
                      Text="Delete"
                      IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsAdmin}"
                      Clicked="OnDeleteClicked" />
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </RefreshView>
  </Grid>
</ContentPage>
