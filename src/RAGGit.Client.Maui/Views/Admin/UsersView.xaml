<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    x:Class="RAGGit.Client.Maui.Views.Admin.UsersView"
    Title="People"
>
    <Grid RowDefinitions="Auto,*,Auto" Padding="12">
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <Button Text="Refresh" Command="{Binding LoadUsersCommand}" />
            <Label Text="Admin-only people management" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <syncfusion:SfDataGrid
            Grid.Row="1"
            x:Name="DataGrid"
            ItemsSource="{Binding Users}"
            AutoGenerateColumnsMode="None"
            AllowSorting="True"
            SelectionMode="Single"
            GridLinesVisibility="Both"
            HeaderGridLinesVisibility="Both"
            ColumnWidthMode="Star"
        >
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn MappingName="Username" HeaderText="Username" />
                <syncfusion:DataGridTextColumn MappingName="DisplayName" HeaderText="Name" />
                <syncfusion:DataGridTextColumn
                    MappingName="Role"
                    HeaderText="Role"
                    ColumnWidthMode="FitByCell"
                />
                <syncfusion:DataGridCheckBoxColumn
                    MappingName="IsActive"
                    HeaderText="Active"
                    ColumnWidthMode="FitByCell"
                />
                <syncfusion:DataGridCheckBoxColumn
                    MappingName="LockedOut"
                    HeaderText="Locked"
                    ColumnWidthMode="FitByCell"
                />
            </syncfusion:SfDataGrid.Columns>
            <syncfusion:SfDataGrid.EmptyView>
                <Label
                    Text="No people found."
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                />
            </syncfusion:SfDataGrid.EmptyView>
        </syncfusion:SfDataGrid>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,12,0,0">
            <Label Text="Create person" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Placeholder="Username" Text="{Binding NewUsername}" />
                <Entry Grid.Column="1" Placeholder="Display name" Text="{Binding NewDisplayName}" />
                <Picker
                    Grid.Column="2"
                    Title="Role"
                    ItemsSource="{Binding Roles}"
                    SelectedItem="{Binding NewRole}"
                />
                <Entry
                    Grid.Column="3"
                    Placeholder="Password"
                    IsPassword="True"
                    Text="{Binding NewPassword}"
                />
            </Grid>
            <Button Text="Create" Command="{Binding CreateUserCommand}" />

            <Label Text="Reset password for selected person" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry
                    Grid.Column="0"
                    Placeholder="New password"
                    IsPassword="True"
                    Text="{Binding ResetPassword}"
                />
                <CheckBox Grid.Column="1" IsChecked="{Binding ResetMustChangePassword}" />
                <Label Grid.Column="2" Text="Must change" VerticalOptions="Center" />
            </Grid>
            <Button
                Text="Reset Password"
                Command="{Binding ResetPasswordCommand}"
                CommandParameter="{Binding Source={x:Reference DataGrid}, Path=SelectedItem}"
            />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    Text="Toggle Active"
                    Command="{Binding ToggleActiveCommand}"
                    CommandParameter="{Binding Source={x:Reference DataGrid}, Path=SelectedItem}"
                />
                <Button
                    Grid.Column="1"
                    Text="Change Role"
                    Command="{Binding ChangeRoleCommand}"
                    CommandParameter="{Binding Source={x:Reference DataGrid}, Path=SelectedItem}"
                />
            </Grid>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
