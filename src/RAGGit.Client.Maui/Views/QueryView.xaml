<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.AIAssistView;assembly=Syncfusion.Maui.AIAssistView"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             x:Class="RAGGit.Client.Maui.Views.QueryView"
             Title="Ask">
  <!-- SfAIAssistView replaces Editor+Button+ScrollView — RAG chat with citations as cards/suggestions -->
  <Grid RowDefinitions="*,Auto" Padding="12">
    <syncfusion:SfAIAssistView x:Name="AssistView"
                              Grid.Row="0"
                              Requests="{Binding Requests}"
                              AssistItems="{Binding Responses}"
                              ShowTypingIndicator="{Binding IsBusy}"
                              AllowStopResponse="True"
                              Suggestions="{Binding Suggestions}"
                              SuggestionItemTapped="OnSuggestionTapped">
      <syncfusion:SfAIAssistView.Header>
        <Label Text="Ask the library" FontSize="18" FontAttributes="Bold" />
      </syncfusion:SfAIAssistView.Header>
    </syncfusion:SfAIAssistView>
    <!-- Fallback citations list for Win11 detail pane; AIAssistView handles chat bubbles, citations rendered as card suggestions -->
    <Grid Grid.Row="1" IsVisible="{Binding HasCitations}" Padding="0,8,0,0">
      <toolkit:SfShimmer IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <CollectionView ItemsSource="{Binding Citations}" EmptyView="No citations." MaximumHeightRequest="160">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border Padding="8" StrokeShape="RoundRectangle 4" Margin="0,4">
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Text}" LineBreakMode="WordWrap" />
                <Label FontSize="12" TextColor="Gray">
                  <Label.Text>
                    <MultiBinding StringFormat="Document: {0} | Chunk: {1} | Ordinal: {2}">
                      <Binding Path="DocumentId" />
                      <Binding Path="ChunkId" />
                      <Binding Path="Ordinal" />
                    </MultiBinding>
                  </Label.Text>
                </Label>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </Grid>
    <Label Grid.Row="1" Text="{Binding StatusMessage}" TextColor="Red" LineBreakMode="WordWrap" IsVisible="{Binding HasStatusMessage}" />
  </Grid>
</ContentPage>
