<UserControl
    x:Class="RAGGit.Client.WinUI.Components.PaginationFooterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RAGGit.Client.WinUI.Components"
    x:Name="Root"
>
    <UserControl.Resources>
        <DataTemplate x:Key="CurrentPageTemplate">
            <Button
                Content="{Binding Page}"
                Command="{Binding GoToCommand, ElementName=Root}"
                CommandParameter="{Binding Page}"
                Background="{ThemeResource Primary}"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                FontSize="13"
                Padding="8,4"
                MinWidth="44"
                MinHeight="44"
                CornerRadius="6"
                VerticalAlignment="Center"
            />
        </DataTemplate>
        <DataTemplate x:Key="PageNumberTemplate">
            <Button
                Content="{Binding Page}"
                Command="{Binding GoToCommand, ElementName=Root}"
                CommandParameter="{Binding Page}"
                Background="Transparent"
                Foreground="{ThemeResource OnSurface}"
                FontSize="13"
                Padding="8,4"
                MinWidth="44"
                MinHeight="44"
                CornerRadius="6"
                VerticalAlignment="Center"
            />
        </DataTemplate>
        <DataTemplate x:Key="EllipsisTemplate">
            <TextBlock
                Text="…"
                FontSize="13"
                Foreground="{ThemeResource OnSurfaceVariant}"
                Padding="8,4"
                VerticalAlignment="Center"
            />
        </DataTemplate>
        <local:PageTokenTemplateSelector
            x:Key="TokenSelector"
            CurrentPageTemplate="{StaticResource CurrentPageTemplate}"
            NumberTemplate="{StaticResource PageNumberTemplate}"
            EllipsisTemplate="{StaticResource EllipsisTemplate}"
        />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,8"
        VerticalAlignment="Center"
    >
        <Grid
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12"
            Padding="0"
            VerticalAlignment="Center"
        >
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
            >
                <TextBlock
                    Text="Rows per page"
                    FontSize="12"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                    VerticalAlignment="Center"
                />
                <ComboBox
                    ItemsSource="{Binding PageSizeOptions, ElementName=Root}"
                    SelectedItem="{Binding SelectedPageSize, ElementName=Root, Mode=TwoWay}"
                    FontSize="13"
                    MinHeight="44"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PageSizeCombo"
                />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Text="{Binding StatusText, ElementName=Root}"
                FontSize="12"
                Foreground="{ThemeResource OnSurfaceVariant}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            />
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
            >
                <Button
                    Content="«"
                    Command="{Binding FirstCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                    Background="Transparent"
                    FontSize="14"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="FirstPageButton"
                    AutomationProperties.Name="First page"
                    ToolTipService.ToolTip="First page"
                />
                <Button
                    Content="‹"
                    Command="{Binding PreviousCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoPrevious, ElementName=Root}"
                    Background="Transparent"
                    FontSize="14"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PreviousPageButton"
                    AutomationProperties.Name="Previous page"
                    ToolTipService.ToolTip="Previous page"
                />
                <ItemsControl
                    ItemsSource="{Binding Sequence, ElementName=Root}"
                    ItemTemplateSelector="{StaticResource TokenSelector}"
                    VerticalAlignment="Center"
                >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button
                    Content="›"
                    Command="{Binding NextCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoNext, ElementName=Root}"
                    Background="Transparent"
                    FontSize="14"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NextPageButton"
                    AutomationProperties.Name="Next page"
                    ToolTipService.ToolTip="Next page"
                />
                <Button
                    Content="»"
                    Command="{Binding LastCommand, ElementName=Root}"
                    IsEnabled="{Binding CanGoNext, ElementName=Root}"
                    Background="Transparent"
                    FontSize="14"
                    Padding="8,4"
                    MinWidth="44"
                    MinHeight="44"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="LastPageButton"
                    AutomationProperties.Name="Last page"
                    ToolTipService.ToolTip="Last page"
                />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
