<UserControl
    x:Class="RAGGit.Client.WinUI.Components.ChatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    xmlns:coreModels="using:RAGGit.Client.Core.Models"
    xmlns:models="using:RAGGit.Core.Models"
    x:Name="Root"
>
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyMessagesVisibility" />
        <converters:CitationOrdinalConverter x:Key="CitationOrdinal" />
        <converters:CitationDocumentNameConverter x:Key="CitationDocumentName" />
        <converters:CitationSubtitleConverter x:Key="CitationSubtitle" />
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto" RowSpacing="8">
        <!-- Messages -->
        <ListView
            Grid.Row="0"
            x:Name="MessagesList"
            ItemsSource="{Binding Messages, ElementName=Root}"
            SelectionMode="None"
        >
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="coreModels:ChatMessage">
                    <Grid HorizontalAlignment="Stretch" Padding="0,4">
                        <!-- User message (right-aligned) -->
                        <Border
                            HorizontalAlignment="Right"
                            MaxWidth="400"
                            Background="{ThemeResource Primary}"
                            CornerRadius="16,16,4,16"
                            Padding="12,8"
                            Visibility="{Binding IsUser, Converter={StaticResource BoolVisibility}}"
                        >
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="{Binding Text}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontSize="14"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                />
                                <Button
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Background="Transparent"
                                    Width="36"
                                    Height="32"
                                    MinWidth="36"
                                    MinHeight="32"
                                    Padding="0"
                                    ToolTipService.ToolTip="Copy message"
                                    AutomationProperties.AutomationId="CopyMessageButton"
                                    AutomationProperties.Name="Copy message"
                                    Click="CopyMessageButton_Click"
                                >
                                    <SymbolIcon Symbol="Copy" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Assistant message (left-aligned) -->
                        <Border
                            HorizontalAlignment="Left"
                            MaxWidth="500"
                            Background="{ThemeResource Surface}"
                            BorderBrush="{ThemeResource Outline}"
                            BorderThickness="1"
                            CornerRadius="16,16,16,4"
                            Padding="12,8"
                            Visibility="{Binding IsUser, Converter={StaticResource InvertedBoolVisibility}}"
                        >
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{Binding Text}"
                                    Foreground="{ThemeResource OnSurface}"
                                    FontSize="14"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                />
                                <StackPanel
                                    Visibility="{x:Bind HasCitations, Converter={StaticResource BoolVisibility}, Mode=OneTime}"
                                    Spacing="8"
                                    AutomationProperties.AutomationId="{x:Bind SourcesAutomationId, Mode=OneTime}"
                                >
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Uid="CitationSourcesLabel" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Citations.Count, Mode=OneTime}"
                                            Foreground="{ThemeResource OnSurfaceVariant}"
                                        />
                                    </Grid>
                                    <ListView
                                        ItemsSource="{x:Bind Citations, Mode=OneTime}"
                                        SelectionMode="None"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.AutomationId="{x:Bind MessageCitationsAutomationId, Mode=OneTime}"
                                    >
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter
                                                    Property="HorizontalContentAlignment"
                                                    Value="Stretch"
                                                />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:Citation">
                                                <Border
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    Margin="0,2"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="8"
                                                    >
                                                        <Border
                                                            Background="{ThemeResource AccentButtonBackground}"
                                                            CornerRadius="6"
                                                            Padding="6,3"
                                                            VerticalAlignment="Top"
                                                        >
                                                            <TextBlock
                                                                Text="{x:Bind Ordinal, Converter={StaticResource CitationOrdinal}, Mode=OneTime}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock
                                                                Text="{x:Bind Converter={StaticResource CitationDocumentName}, Mode=OneTime}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource OnSurface}"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                            <TextBlock
                                                                Text="{x:Bind Text, Mode=OneTime}"
                                                                FontSize="13"
                                                                Foreground="{ThemeResource OnSurface}"
                                                                TextWrapping="Wrap"
                                                                IsTextSelectionEnabled="True"
                                                            />
                                                            <TextBlock
                                                                Text="{x:Bind Converter={StaticResource CitationSubtitle}, Mode=OneTime}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource OnSurfaceVariant}"
                                                                IsTextSelectionEnabled="True"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    Width="36"
                                    Height="32"
                                    MinWidth="36"
                                    MinHeight="32"
                                    Padding="0"
                                    ToolTipService.ToolTip="Copy message"
                                    AutomationProperties.AutomationId="CopyMessageButton"
                                    AutomationProperties.Name="Copy message"
                                    Click="CopyMessageButton_Click"
                                >
                                    <SymbolIcon Symbol="Copy" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state (ListView has no EmptyView; toggled in code-behind) -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="0"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
            <TextBlock
                Text="Ask a question to get started"
                FontSize="16"
                Foreground="{ThemeResource OnSurfaceVariant}"
                HorizontalAlignment="Center"
            />
            <TextBlock
                Text="Your conversation will appear here."
                FontSize="13"
                Foreground="{ThemeResource OnSurfaceVariant}"
                HorizontalAlignment="Center"
            />
        </StackPanel>

        <!-- Input bar (fixed at bottom) -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource Surface}"
            BorderBrush="{ThemeResource Outline}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="8"
        >
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox
                    Grid.Column="0"
                    x:Name="InputBox"
                    Text="{Binding InputText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Type your question..."
                    FontSize="14"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    KeyDown="InputBox_KeyDown"
                    AutomationProperties.AutomationId="ChatInputBox"
                />
                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="SendQuestionButton"
                    AutomationProperties.Name="Send question"
                    ToolTipService.ToolTip="Send question"
                    Command="{Binding SendCommand, ElementName=Root}"
                    Background="{ThemeResource Primary}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    CornerRadius="20"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                >
                    <SymbolIcon Symbol="Send" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
