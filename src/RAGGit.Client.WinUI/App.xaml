                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#075985" />
                    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFF" />
                    <SolidColorBrush
                        x:Key="NavigationViewItemForegroundPointerOver"
                        Color="#FFFFFF"
                    />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFFFFF" />
