                    />
                    <StaticResource
                        x:Key="NavigationViewDefaultPaneBackground"
                        ResourceKey="SystemColorWindowColorBrush"
                    />
                    <StaticResource
                        x:Key="NavigationViewTopPaneBackground"
                        ResourceKey="SystemColorWindowColorBrush"
                    />
                    <StaticResource
                        x:Key="NavigationViewItemBackgroundSelected"
                        ResourceKey="SystemColorHighlightColorBrush"
