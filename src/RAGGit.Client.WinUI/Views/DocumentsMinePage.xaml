<Page
    x:Class="RAGGit.Client.WinUI.Views.DocumentsMinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:RAGGit.Client.WinUI.Components"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Background="{ThemeResource SurfaceVariant}"
>
    <Page.Resources>
        <converters:MineMetaConverter x:Key="MineMeta" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="24" RowSpacing="12">
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="My Documents"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{ThemeResource OnSurface}"
                VerticalAlignment="Center"
            />
            <Button
                Grid.Column="1"
                Content="Refresh"
                Command="{Binding RefreshCommand}"
                Height="36"
                FontSize="13"
                VerticalAlignment="Center"
            />
        </Grid>

        <!-- Status -->
        <TextBlock
            Grid.Row="1"
            Text="{Binding StatusMessage}"
            FontSize="13"
            Foreground="{ThemeResource OnSurfaceVariant}"
        />

        <!-- Document List -->
        <Grid Grid.Row="2">
            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                Foreground="{ThemeResource Primary}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="40"
                Height="40"
            />
            <ListView ItemsSource="{Binding Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{ThemeResource Surface}"
                            BorderBrush="{ThemeResource Outline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,6"
                        >
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock
                                    Grid.Row="0"
                                    Text="{Binding Filename}"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2"
                                />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <components:StatusChip
                                        Status="{Binding Status}"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource OnSurfaceVariant}"
                                        VerticalAlignment="Center"
                                        Text="{Binding Converter={StaticResource MineMeta}}"
                                    />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Empty state -->
            <StackPanel
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"
            >
                <TextBlock
                    Text="No documents yet"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                />
                <TextBlock
                    Text="Upload a document to see it here."
                    FontSize="13"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                    HorizontalAlignment="Center"
                />
            </StackPanel>
        </Grid>

        <!-- Load more (explicit button replaces RemainingItemsThreshold) -->
        <Button
            Grid.Row="3"
            Content="Load more"
            Command="{Binding LoadMoreCommand}"
            Visibility="{Binding HasMore, Converter={StaticResource BoolVisibility}}"
            HorizontalAlignment="Center"
        />

        <!-- Footer -->
        <TextBlock
            Grid.Row="4"
            Text="{Binding ErrorMessage}"
            Foreground="{ThemeResource Error}"
            FontSize="13"
            TextTrimming="CharacterEllipsis"
        />
    </Grid>
</Page>
