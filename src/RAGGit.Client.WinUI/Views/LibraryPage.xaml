<Page
    x:Class="RAGGit.Client.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:RAGGit.Client.WinUI.Components"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    xmlns:models="using:RAGGit.Core.Models"
    Background="{ThemeResource DashboardSurface}"
>
    <Page.Resources>
        <converters:DocumentMimeLabelConverter x:Key="MimeLabel" />
        <converters:SizeMbConverter x:Key="SizeMb" />
        <converters:CreatorLabelConverter x:Key="CreatorLabel" />
        <converters:ShortDateConverter x:Key="ShortDate" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="24" RowSpacing="12">
        <!-- Header card -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Document Library"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurface}"
                    VerticalAlignment="Center"
                />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                >
                    <Button
                        Command="{Binding LoadDocumentsCommand}"
                        Width="44"
                        Height="44"
                        MinWidth="44"
                        MinHeight="44"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RefreshButton"
                        AutomationProperties.Name="Refresh documents"
                        ToolTipService.ToolTip="Refresh documents"
                    >
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button
                        x:Name="UploadButton"
                        Click="OnUploadClicked"
                        Width="44"
                        Height="44"
                        MinWidth="44"
                        MinHeight="44"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UploadButton"
                        AutomationProperties.Name="Upload documents"
                        ToolTipService.ToolTip="Upload documents"
                    >
                        <SymbolIcon Symbol="Upload" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document list card -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
        >
            <Grid>
                <ProgressRing
                    IsActive="{Binding IsBusy}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    Foreground="{ThemeResource Primary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="40"
                    Height="40"
                />
                <ListView
                    x:Name="DocumentsList"
                    ItemsSource="{Binding PageItems}"
                    SelectionMode="None"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollMode="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid
                            ColumnDefinitions="*,70,90,120,130,150,44,44"
                            ColumnSpacing="12"
                            MinWidth="880"
                            Padding="16,12"
                        >
                            <TextBlock
                                Grid.Column="0"
                                Text="Filename"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Grid.Column="1"
                                Text="Type"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Grid.Column="2"
                                Text="Size"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Grid.Column="3"
                                Text="Status"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Grid.Column="4"
                                Text="Creator"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                            <TextBlock
                                Grid.Column="5"
                                Text="Created"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                                VerticalAlignment="Center"
                            />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Document">
                            <Grid
                                ColumnDefinitions="*,70,90,120,130,150,44,44"
                                ColumnSpacing="12"
                                MinWidth="880"
                                Padding="16,12"
                            >
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Filename}"
                                    FontSize="14"
                                    Foreground="{ThemeResource OnSurface}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Converter={StaticResource MimeLabel}}"
                                    FontSize="13"
                                    Foreground="{ThemeResource OnSurfaceVariant}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Converter={StaticResource SizeMb}}"
                                    FontSize="13"
                                    Foreground="{ThemeResource OnSurfaceVariant}"
                                    VerticalAlignment="Center"
                                />
                                <components:StatusChip
                                    Grid.Column="3"
                                    Status="{Binding Status}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Converter={StaticResource CreatorLabel}}"
                                    FontSize="13"
                                    Foreground="{ThemeResource OnSurfaceVariant}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding CreatedAt, Converter={StaticResource ShortDate}}"
                                    FontSize="13"
                                    Foreground="{ThemeResource OnSurfaceVariant}"
                                    VerticalAlignment="Center"
                                />
                                <Button
                                    Grid.Column="6"
                                    AutomationProperties.Name="Download document"
                                    ToolTipService.ToolTip="Download document"
                                    Background="Transparent"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="OnDownloadClicked"
                                    VerticalAlignment="Center"
                                >
                                    <SymbolIcon Symbol="Download" />
                                </Button>
                                <Button
                                    Grid.Column="7"
                                    AutomationProperties.Name="Delete document"
                                    ToolTipService.ToolTip="Delete document"
                                    Background="Transparent"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="OnDeleteClicked"
                                    Visibility="{Binding DataContext.IsAdmin, ElementName=DocumentsList, Converter={StaticResource BoolVisibility}}"
                                    VerticalAlignment="Center"
                                >
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- Empty state card (ListView has no EmptyView) -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource Surface}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Visibility="{Binding PageItems, Converter={StaticResource EmptyListVisibility}}"
                >
                    <StackPanel
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                    >
                        <TextBlock
                            Text="No documents yet"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OnSurface}"
                            HorizontalAlignment="Center"
                        />
                        <TextBlock
                            Text="Upload a document to see it here."
                            FontSize="13"
                            Foreground="{ThemeResource OnSurfaceVariant}"
                            HorizontalAlignment="Center"
                        />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pagination footer -->
        <components:PaginationFooterControl
            Grid.Row="2"
            PageSizeOptions="{Binding PageSizeOptions}"
            SelectedPageSize="{Binding PageSize, Mode=TwoWay}"
            StatusText="{Binding StatusText}"
            Sequence="{Binding VisibleSequence}"
            GoToCommand="{Binding GoToPageCommand}"
            FirstCommand="{Binding FirstPageCommand}"
            PreviousCommand="{Binding PreviousPageCommand}"
            NextCommand="{Binding NextPageCommand}"
            LastCommand="{Binding LastPageCommand}"
            CanGoPrevious="{Binding HasPrevious}"
            CanGoNext="{Binding HasNext}"
        />

        <!-- Footer -->
        <TextBlock
            Grid.Row="3"
            Text="{Binding ErrorMessage}"
            Foreground="{ThemeResource Error}"
            FontSize="13"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            MaxLines="2"
        />
    </Grid>
</Page>
