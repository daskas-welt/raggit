<ContentDialog
    x:Class="RAGGit.Client.WinUI.Views.UploadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Title="Upload Documents"
    CloseButtonText="Close"
    DefaultButton="Close"
>
    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
        <converters:StatusSeverityConverter x:Key="StatusSeverity" />
    </ContentDialog.Resources>
    <!-- Click-to-select only (015-file-upload-ui): no drag-and-drop target.
         The queue ListView virtualizes on its own; never wrap it in a
         scrolling container. Spacing follows the 4px scale (4/8/12). -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12" MinWidth="400">
        <!-- Pick row: single entry action + supported-types hint -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Button
                x:Name="AddFilesButton"
                Command="{Binding PickFileCommand}"
                MinHeight="44"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="AddFilesButton"
            >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Add files" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock
                Text="{Binding SupportedTypesText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource OnSurfaceVariant}"
                TextWrapping="Wrap"
            />
        </StackPanel>

        <!-- Pick-time rejection: immediate plain-language message -->
        <InfoBar
            Grid.Row="1"
            Severity="Warning"
            IsOpen="{Binding HasRejection, Mode=OneWay}"
            Message="{Binding RejectionMessage, Mode=OneWay}"
            IsClosable="False"
            AutomationProperties.LiveSetting="Polite"
        />

        <!-- Multi-file queue -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock
                Text="{Binding CompletedCountText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource OnSurfaceVariant}"
                Visibility="{Binding HasFiles, Converter={StaticResource BoolVisibility}}"
            />
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                Visibility="{Binding HasFiles, Converter={StaticResource BoolVisibility}}"
            >
                <ListView
                    x:Name="QueueList"
                    ItemsSource="{Binding Queue}"
                    MaxHeight="260"
                    SelectionMode="None"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="UploadQueueList"
                    AutomationProperties.Name="Files to upload"
                >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="12,8">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{Binding FileName}"
                                        FontSize="14"
                                        Foreground="{ThemeResource OnSurface}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <TextBlock
                                        Text="{Binding FileMetaText}"
                                        FontSize="12"
                                        Foreground="{ThemeResource OnSurfaceVariant}"
                                    />
                                    <ProgressBar
                                        Value="{Binding Progress, Mode=OneWay}"
                                        Maximum="1"
                                        Height="4"
                                        Foreground="{ThemeResource Primary}"
                                        AutomationProperties.Name="Upload progress"
                                    />
                                    <TextBlock
                                        Text="{Binding StateLabel, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource OnSurfaceVariant}"
                                    />
                                    <TextBlock
                                        Text="{Binding ErrorMessage, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource StatusErrorBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"
                                    />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding DataContext.RemoveFileCommand, ElementName=QueueList}"
                                    CommandParameter="{Binding}"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Remove file"
                                    AutomationProperties.AutomationId="{Binding FileName, Mode=OneWay}"
                                    AutomationProperties.Name="Remove file"
                                >
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Visibility="{Binding Queue, Converter={StaticResource EmptyListVisibility}}"
            >
                <TextBlock
                    Text="No files yet. Choose Add files to build the queue."
                    FontSize="13"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                />
            </Border>
        </StackPanel>

        <!-- Start + cancel actions -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button
                Grid.Column="0"
                x:Name="UploadStartButton"
                Command="{Binding UploadCommand}"
                MinHeight="44"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="UploadStartButton"
            >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Upload" />
                    <TextBlock Text="Upload" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                Command="{Binding CancelUploadCommand}"
                MinHeight="44"
                MinWidth="44"
                Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
                ToolTipService.ToolTip="Cancel upload"
                AutomationProperties.AutomationId="CancelUploadButton"
                AutomationProperties.Name="Cancel upload"
            >
                <SymbolIcon Symbol="Cancel" />
            </Button>
        </Grid>

        <!-- Summary outcome: full success auto-closes (see code-behind);
             any failure/cancel stays open with per-file outcomes above. -->
        <InfoBar
            Grid.Row="4"
            Severity="{Binding StatusSeverity, Converter={StaticResource StatusSeverity}, Mode=OneWay}"
            IsOpen="{Binding HasStatus, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
            IsClosable="False"
            AutomationProperties.LiveSetting="Polite"
        />
    </Grid>
</ContentDialog>
