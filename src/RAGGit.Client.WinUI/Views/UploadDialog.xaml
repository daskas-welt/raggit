<ContentDialog
    x:Class="RAGGit.Client.WinUI.Views.UploadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Title="Upload Document"
    CloseButtonText="Close"
    DefaultButton="Close"
>
    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
    </ContentDialog.Resources>
    <StackPanel Spacing="20" MinWidth="360">
        <!-- Drop Zone -->
        <Border
            BorderBrush="{ThemeResource Outline}"
            BorderThickness="2"
            CornerRadius="12"
            Background="{ThemeResource SurfaceVariant}"
            Padding="32"
            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
        >
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock
                    Text="Click to select a file"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource OnSurface}"
                />
                <TextBlock
                    Text="PDF, DOCX, TXT, XLSX supported"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                />
                <Button
                    Content="Select file"
                    Command="{Binding PickFileCommand}"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="SelectFileButton"
                />
            </StackPanel>
        </Border>

        <!-- Selected File Info -->
        <StackPanel
            Spacing="0"
            Visibility="{Binding HasFile, Converter={StaticResource BoolVisibility}}"
        >
            <TextBlock
                Text="Selected file"
                FontSize="12"
                Foreground="{ThemeResource OnSurfaceVariant}"
            />
            <TextBox Text="{Binding SelectedFileName}" IsReadOnly="True" FontSize="14" />
        </StackPanel>

        <!-- Upload Button -->
        <Button
            Content="Upload"
            Command="{Binding UploadCommand}"
            IsEnabled="{Binding IsUploadEnabled}"
            HorizontalAlignment="Stretch"
            Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}"
            AutomationProperties.AutomationId="UploadButton"
        />

        <!-- Cancel (replaces the MAUI sheet's implicit dismiss-during-upload) -->
        <Button
            Content="Cancel upload"
            Command="{Binding CancelUploadCommand}"
            HorizontalAlignment="Stretch"
            Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
            AutomationProperties.AutomationId="CancelUploadButton"
        />

        <!-- Progress -->
        <StackPanel
            Spacing="4"
            Visibility="{Binding IsUploading, Converter={StaticResource BoolVisibility}}"
        >
            <ProgressBar
                Value="{Binding UploadProgress, Mode=OneWay}"
                Maximum="1"
                Foreground="{ThemeResource Primary}"
                Height="8"
            />
            <TextBlock
                Text="{Binding UploadProgress, Mode=OneWay}"
                FontSize="12"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource OnSurfaceVariant}"
            />
        </StackPanel>

        <!-- Status -->
        <TextBlock
            Text="{Binding StatusMessage}"
            FontSize="13"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
        />

        <!-- Loading -->
        <ProgressRing
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
            Foreground="{ThemeResource Primary}"
            HorizontalAlignment="Center"
            Width="32"
            Height="32"
        />
    </StackPanel>
</ContentDialog>
