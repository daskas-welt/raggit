<Page
    x:Class="RAGGit.Client.WinUI.Views.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:RAGGit.Client.WinUI.Components"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Background="{ThemeResource SurfaceVariant}"
>
    <Page.Resources>
        <converters:CitationSubtitleConverter x:Key="CitationSubtitle" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="8">
        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Text="Ask the Library"
            FontSize="22"
            FontWeight="Bold"
            Foreground="{ThemeResource OnSurface}"
        />

        <!-- Chat -->
        <components:ChatControl
            Grid.Row="1"
            x:Name="ChatView"
            Messages="{Binding Messages}"
            InputText="{Binding QueryText, Mode=TwoWay}"
            SendCommand="{Binding AskCommand}"
        />

        <!-- Citations Footer -->
        <Grid
            Grid.Row="2"
            Visibility="{Binding HasCitations, Converter={StaticResource BoolVisibility}}"
        >
            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                Foreground="{ThemeResource Primary}"
                HorizontalAlignment="Center"
            />
            <ListView ItemsSource="{Binding Citations}" MaxHeight="140" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{ThemeResource Surface}"
                            BorderBrush="{ThemeResource Outline}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,4"
                        >
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap"
                                    FontSize="13"
                                />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource OnSurfaceVariant}"
                                    Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status -->
        <InfoBar
            Grid.Row="2"
            Severity="Informational"
            IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
        />

        <!-- Loading overlay -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
            Foreground="{ThemeResource Primary}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="40"
            Height="40"
        />
    </Grid>
</Page>
