<Page
    x:Class="RAGGit.Client.WinUI.Views.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:RAGGit.Client.WinUI.Components"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    xmlns:models="using:RAGGit.Core.Models"
    Background="{ThemeResource DashboardSurface}"
>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="24" RowSpacing="12">
        <!-- Header card -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
        >
            <TextBlock
                Text="Ask the Library"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{ThemeResource OnSurface}"
            />
        </Border>

        <!-- Chat -->
        <components:ChatControl
            Grid.Row="1"
            x:Name="ChatView"
            Messages="{Binding Messages}"
            InputText="{Binding QueryText, Mode=TwoWay}"
            SendCommand="{Binding AskCommand}"
        />

        <!-- Did-you-mean suggestion chips -->
        <Border
            Grid.Row="2"
            Visibility="{Binding HasSuggestedPersons, Converter={StaticResource BoolVisibility}}"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
        >
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Μήπως εννοούσατε; / Did you mean?"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource OnSurface}"
                />
                <ItemsControl
                    x:Name="SuggestionChips"
                    ItemsSource="{Binding SuggestedPersons}"
                    AutomationProperties.AutomationId="SuggestionChips"
                >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PersonSuggestion">
                            <Button
                                Content="{Binding Name}"
                                Command="{Binding ElementName=SuggestionChips, Path=DataContext.UseSuggestedPersonCommand}"
                                CommandParameter="{Binding}"
                                Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SuggestionChipButton"
                            />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status -->
        <InfoBar
            Grid.Row="3"
            Severity="Informational"
            IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
            Message="{Binding StatusMessage, Mode=OneWay}"
        />

        <!-- Loading overlay -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
            Foreground="{ThemeResource Primary}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="40"
            Height="40"
        />
    </Grid>
</Page>
