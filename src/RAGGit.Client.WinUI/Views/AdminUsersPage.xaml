<Page
    x:Class="RAGGit.Client.WinUI.Views.AdminUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Background="{ThemeResource SurfaceVariant}"
>
    <Page.Resources>
        <converters:ActiveGlyphConverter x:Key="ActiveGlyph" />
        <converters:LockedGlyphConverter x:Key="LockedGlyph" />
        <converters:NullToVisibilityConverter x:Key="NullVisibility" />
        <converters:SelectedUserLabelConverter x:Key="SelectedUserLabel" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyUsersVisibility" />
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="People Management"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurface}"
                    VerticalAlignment="Center"
                />
                <Button
                    Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding LoadUsersCommand}"
                    Height="36"
                    FontSize="13"
                    VerticalAlignment="Center"
                />
            </Grid>

            <!-- Users list -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
            >
                <StackPanel Spacing="0">
                    <Grid ColumnDefinitions="*,110,70,70" Padding="16,10">
                        <TextBlock
                            Grid.Column="0"
                            Text="User"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{ThemeResource OnSurfaceVariant}"
                            VerticalAlignment="Center"
                        />
                        <TextBlock
                            Grid.Column="1"
                            Text="Role (tap to change)"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{ThemeResource OnSurfaceVariant}"
                            VerticalAlignment="Center"
                        />
                        <TextBlock
                            Grid.Column="2"
                            Text="Active"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{ThemeResource OnSurfaceVariant}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                        />
                        <TextBlock
                            Grid.Column="3"
                            Text="Locked"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{ThemeResource OnSurfaceVariant}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                        />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource Outline}" />
                    <ListView
                        x:Name="UsersList"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                        SelectionMode="Single"
                    >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,110,70,70" Padding="16,10">
                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="0"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="{Binding Username}"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            Foreground="{ThemeResource OnSurface}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontSize="12"
                                            Foreground="{ThemeResource OnSurfaceVariant}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="{Binding Role}"
                                        Click="OnChangeRoleClicked"
                                        Height="32"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                    />
                                    <Button
                                        Grid.Column="2"
                                        Content="{Binding IsActive, Converter={StaticResource ActiveGlyph}}"
                                        Click="OnToggleActiveClicked"
                                        Background="Transparent"
                                        Foreground="{ThemeResource Primary}"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Width="40"
                                        Height="32"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding LockedOut, Converter={StaticResource LockedGlyph}}"
                                        FontSize="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="No users found."
                        FontSize="14"
                        Foreground="{ThemeResource OnSurfaceVariant}"
                        HorizontalAlignment="Center"
                        Padding="40"
                        Visibility="{Binding Users, Converter={StaticResource EmptyUsersVisibility}}"
                    />
                </StackPanel>
            </Border>
            <TextBlock
                Text="{Binding SelectedUser, Converter={StaticResource SelectedUserLabel}}"
                FontSize="12"
                Foreground="{ThemeResource OnSurfaceVariant}"
                Visibility="{Binding SelectedUser, Converter={StaticResource NullVisibility}}"
            />

            <!-- Create Person -->
            <Expander
                Header="Create Person"
                IsExpanded="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
            >
                <StackPanel Spacing="12">
                    <TextBox
                        Header="Username"
                        Description="Unique login name."
                        Text="{Binding NewUsername, Mode=TwoWay}"
                        FontSize="14"
                    />
                    <TextBox
                        Header="Display Name"
                        Description="Shown in the users list."
                        Text="{Binding NewDisplayName, Mode=TwoWay}"
                        FontSize="14"
                    />
                    <ComboBox
                        Header="Role"
                        Description="Admin or Employee."
                        ItemsSource="{Binding Roles}"
                        SelectedItem="{Binding NewRole, Mode=TwoWay}"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                    />
                    <PasswordBox
                        Header="Password"
                        Description="Initial password for the new account."
                        Password="{Binding NewPassword, Mode=TwoWay}"
                        FontSize="14"
                    />
                    <Button
                        Content="Create"
                        Command="{Binding CreateUserCommand}"
                        Height="40"
                        HorizontalAlignment="Stretch"
                    />
                </StackPanel>
            </Expander>

            <!-- Reset Password (operates on selected user) -->
            <Expander
                Header="Reset Password"
                IsExpanded="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
            >
                <StackPanel Spacing="12">
                    <PasswordBox
                        Header="New Password"
                        Description="The selected user signs in with this next."
                        Password="{Binding ResetPassword, Mode=TwoWay}"
                        FontSize="14"
                    />
                    <CheckBox
                        Content="Must change"
                        IsChecked="{Binding ResetMustChangePassword, Mode=TwoWay}"
                    />
                    <Button
                        Content="Reset Password"
                        Click="OnResetPasswordClicked"
                        Height="40"
                        HorizontalAlignment="Stretch"
                    />
                </StackPanel>
            </Expander>

            <!-- Error -->
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="{ThemeResource Error}"
                FontSize="13"
                TextWrapping="Wrap"
            />

            <!-- Loading -->
            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                Foreground="{ThemeResource Primary}"
                HorizontalAlignment="Center"
                Width="32"
                Height="32"
            />
        </StackPanel>
    </ScrollViewer>
</Page>
