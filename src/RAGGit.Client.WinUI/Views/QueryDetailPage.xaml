<Page
    x:Class="RAGGit.Client.WinUI.Views.QueryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    Background="{ThemeResource SurfaceVariant}"
>
    <Page.Resources>
        <converters:HistoryCitationSubtitleConverter x:Key="CitationSubtitle" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Query Detail"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{ThemeResource OnSurface}"
                VerticalAlignment="Center"
            />
            <Button
                Grid.Column="1"
                Content="Back"
                Click="OnBackClicked"
                Height="36"
                FontSize="13"
                VerticalAlignment="Center"
            />
        </Grid>

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            Foreground="{ThemeResource Error}"
            FontSize="13"
            TextWrapping="Wrap"
        />

        <!-- Content -->
        <Grid Grid.Row="2">
            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                Foreground="{ThemeResource Primary}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="40"
                Height="40"
            />
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <!-- Prompt -->
                    <Border
                        Background="{ThemeResource Surface}"
                        BorderBrush="{ThemeResource Outline}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                    >
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Prompt"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                            />
                            <TextBlock
                                Text="{Binding Detail.Prompt}"
                                FontSize="14"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>

                    <!-- Answer -->
                    <Border
                        Background="{ThemeResource Surface}"
                        BorderBrush="{ThemeResource Outline}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                    >
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Answer"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource OnSurfaceVariant}"
                            />
                            <TextBlock
                                Text="{Binding Detail.Answer}"
                                FontSize="14"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>

                    <!-- Citations -->
                    <TextBlock
                        Text="Citations"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{ThemeResource OnSurfaceVariant}"
                        Margin="0,4,0,0"
                    />
                    <ListView ItemsSource="{Binding Detail.Citations}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{ThemeResource Surface}"
                                    BorderBrush="{ThemeResource Outline}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4"
                                >
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{Binding Text}"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                        />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource OnSurfaceVariant}"
                                            Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                        />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="No citations for this query."
                        FontSize="13"
                        Foreground="{ThemeResource OnSurfaceVariant}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding Detail.Citations, Converter={StaticResource EmptyListVisibility}}"
                    />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
