<Page
    x:Class="RAGGit.Client.WinUI.Views.QueryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RAGGit.Client.WinUI.Converters"
    xmlns:models="using:RAGGit.Core.Models"
    Background="{ThemeResource DashboardSurface}"
>
    <Page.Resources>
        <converters:HistoryCitationSubtitleConverter x:Key="CitationSubtitle" />
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:EmptyListToVisibilityConverter x:Key="EmptyListVisibility" />
    </Page.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="24" RowSpacing="12">
        <!-- Header card -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Query Detail"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurface}"
                    VerticalAlignment="Center"
                />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <Button
                        Content="Ask again"
                        Click="OnAskAgainClicked"
                        Height="36"
                        FontSize="13"
                        AutomationProperties.AutomationId="AskAgainButton"
                        ToolTipService.ToolTip="Run this query again"
                    />
                    <Button Content="Back" Click="OnBackClicked" Height="36" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            Foreground="{ThemeResource Error}"
            FontSize="13"
            TextWrapping="Wrap"
        />

        <!-- Prompt card -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
        >
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Prompt"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                />
                <TextBlock
                    Text="{Binding Detail.Prompt, FallbackValue=''}"
                    FontSize="14"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                />
                <Button
                    Content="Copy"
                    FontSize="11"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Copy prompt"
                    AutomationProperties.AutomationId="CopyPromptButton"
                    Click="CopyPromptButton_Click"
                />
            </StackPanel>
        </Border>

        <!-- Answer card -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
        >
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Answer"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                />
                <TextBlock
                    Text="{Binding Detail.Answer, FallbackValue=''}"
                    FontSize="14"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                />
                <Button
                    Content="Copy"
                    FontSize="11"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="Copy answer"
                    AutomationProperties.AutomationId="CopyAnswerButton"
                    Click="CopyAnswerButton_Click"
                />
            </StackPanel>
        </Border>

        <!-- Citations card -->
        <Border
            Grid.Row="4"
            Background="{ThemeResource MetricTileBackground}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
        >
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <TextBlock
                    Grid.Row="0"
                    Text="Citations"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{ThemeResource OnSurfaceVariant}"
                />
                <Grid Grid.Row="1">
                    <ListView
                        ItemsSource="{Binding Detail.Citations}"
                        SelectionMode="None"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                    >
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryCitation">
                                <Border
                                    Background="{ThemeResource Surface}"
                                    BorderBrush="{ThemeResource Outline}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,4"
                                >
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{Binding Text}"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                        />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource OnSurfaceVariant}"
                                            Text="{Binding Converter={StaticResource CitationSubtitle}}"
                                            IsTextSelectionEnabled="True"
                                        />
                                        <Button
                                            Content="Copy"
                                            FontSize="11"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            ToolTipService.ToolTip="Copy citation"
                                            AutomationProperties.AutomationId="CopyCitationButton"
                                            Click="CopyCitationButton_Click"
                                        />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="No citations for this query."
                        FontSize="13"
                        Foreground="{ThemeResource OnSurfaceVariant}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Detail.Citations, Converter={StaticResource EmptyListVisibility}}"
                    />
                </Grid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <ProgressRing
            Grid.Row="2"
            Grid.RowSpan="3"
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
            Foreground="{ThemeResource Primary}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="40"
            Height="40"
        />
    </Grid>
</Page>
