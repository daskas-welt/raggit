@startuml 004 Identity Architecture
' Feature 004-identity — per-person accounts topology
' Render: scripts/Render-PlantUml.ps1 (PNG) or @plantuml/mcp-js (SVG)
' NOTE: no !theme directive - the official @plantuml/mcp-js engine hangs
' rendering when a theme is requested (themes.js unavailable headless).
' Dialect: rectangle/actor/package (JS-engine safe; no [bracket] components).
skinparam defaultFontSize 15

package "LAN workstation :5001 HTTPS" {
  rectangle "WinUI client\nlogin + SecureStorage cache" as client
  rectangle "operator-cli\nraggit user add" as cli
  rectangle "workstation-api\nJwtBearer HS256 - Bearer + ApiKey" as api
  rectangle "jwt-auth\n8h token - sub=User.Id" as jwt
  rectangle "users-db\nPBKDF2-SHA256 310k - COLLATE NOCASE" as users
  rectangle "lancedb\ndocs with CreatedBy = person id" as lance
  rectangle "ollama\n:11434 loopback - embed + chat" as ollama
  rectangle "eval-tests\noffline proof - 0 egress" as eval
}

client --> api : login/me/users\nBearer
cli --> users : seed Admin/Employee\ndirect rag.db write
api --> jwt : issue / validate
api --> users : lookup NOCASE\nlockout check
api --> lance : attributed query
api --> ollama : cited answer
api --> eval : SC-005 offline gate

note right of users : No company_id (Constitution I)\nNever hard-delete: deactivate only
@enduml
