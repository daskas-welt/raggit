{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Neon": {
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "plantuml-js": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@plantuml/mcp-js@0.2.2"
      ],
      "enabled": true
    }
  }
}
