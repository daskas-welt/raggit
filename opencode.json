{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Neon": {
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "servers": {
      "digitalocean": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@digitalocean/mcp",
          "--services",
          "droplets,accounts,networking,volumes,docs"
        ],
        "environment": {
          "DIGITALOCEAN_API_TOKEN": "{env:DIGITALOCEAN_API_TOKEN}"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
        }
      }
    }
  }
}
