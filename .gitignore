# Build outputs
bin/
obj/
out/
# Single-project MSIX output (WindowsAppSDK 2.x emits to project-root AppPackages/)
AppPackages/

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/mcp.json
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET
*.dll
*.exe
*.pdb
*.cache
*.log
project.lock.json
project.fragment.lock.json
artifacts/

# Data and models (workstation-local, never committed).
# NOTE: bare /data/ only matches the repo root — runtime data also lives
# under src/<project>/data/, so both forms (plus key material) are listed.
**/data/
**/data.backup-*/
# ...but a SOURCE directory named Data is not runtime data. On Windows the rule
# above matches it case-insensitively, so re-include it explicitly — otherwise
# the SQLite repositories under src/RAGGit.Core/Data/ silently leave the index.
!src/RAGGit.Core/Data/
!src/RAGGit.Core/Data/**
*.db
/models/
*.gguf
*.onnx
*.key
*.pem

# Test results
TestResults/
coverage/
*.trx

# OS files
.DS_Store
Thumbs.db
desktop.ini

# NuGet
*.nupkg
*.snupkg
nuget.exe

# Publish
publish/
app.publish/

# PlantUML renders are committed (SVG canonical in docs/images/, PNG optional via jar)
# CodeGraph local index (12MB+), never commit
.codegraph/
# Per-tool mirrors of the CodeGraph agent block (AGENTS.md is canonical)
.claude/
.gemini/
GEMINI.md
