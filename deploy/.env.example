# ---------------------------------------------------------------------------
# RAGGit - private cloud deployment inputs (feature 031-remote-workstation-hosting)
#
# Copy this file to `deploy/.env` and fill it in. `deploy/.env` is gitignored;
# never commit real secrets.
#
# IMPORTANT: the names on the left are operator-facing `.env` variables. They are
# NOT .NET configuration keys. `deploy/docker-compose.prod.yml` maps each one to
# the container environment variable shown in the middle (where `__` is `:`),
# which is what the application actually reads:
#
#   .env variable        container env var                                   config key
#   ------------------   -------------------------------------------------   ---------------------------
#   ADMIN_API_KEY        Api__AdminKey                                       Api:AdminKey
#   EMPLOYEE_API_KEY     Api__EmployeeKey                                    Api:EmployeeKey
#   CERT_PFX_PATH        ASPNETCORE_Kestrel__Certificates__Default__Path     Kestrel default certificate
#   CERT_PFX_PASSWORD    ASPNETCORE_Kestrel__Certificates__Default__Password Kestrel default certificate
#   EMBED_MODEL          Ollama__EmbedModel                                  Ollama:EmbedModel
#   CHAT_MODEL           Ollama__ChatModel                                   Ollama:ChatModel
#   VECTOR_SIZE          VectorDb__VectorSize                                VectorDb:VectorSize
#   EMBED_BATCH_SIZE     Ingest__EmbedBatchSize                              Ingest:EmbedBatchSize
#   OLLAMA_URL           Ollama__Url                                         Ollama:Url
#
# A bare `OLLAMA_URL` is not a valid .NET key - it only works because the compose
# file maps it. Do not rename these without updating the compose file too.
# ---------------------------------------------------------------------------

# Address clients use. The machine's PRIVATE/VPN address: the workstation must be
# reachable only from the company's own networks and must never be an open public
# endpoint. In local mode this is the machine's LAN address.
WORKSTATION_HOST=10.116.0.4

# Host IP the published port binds to (the private interface). Required: compose
# refuses to start without it, so the port is never accidentally bound to 0.0.0.0.
BIND_ADDRESS=10.116.0.4

# Host path of the mounted block-storage volume (bind source for /app/data).
RAGGIT_DATA_DIR=/mnt/raggit-data

# Credentials. Per-person sign-in is the norm; these keys bootstrap and automate
# access. CHANGE BOTH before deploying.
ADMIN_API_KEY=change-me-admin-key
EMPLOYEE_API_KEY=change-me-employee-key

# TLS certificate: a password-protected PFX whose subject/SAN matches the address
# clients use (IP SAN for a private IP, else the VPN host name). These paths are
# INSIDE the container - the volume is mounted at /app/data, so
# /app/data/certs/raggit.pfx is $RAGGIT_DATA_DIR/certs/raggit.pfx on the host.
# The container runs as a non-root user, so the PFX must be readable by it
# (chmod 644 is sufficient for a password-protected PFX on a private-only host).
CERT_PFX_PATH=/app/data/certs/raggit.pfx
CERT_PFX_PASSWORD=change-me-cert-password

# Models and vector settings. VECTOR_SIZE and EMBED_MODEL must agree
# (384 / 768 / 1024 <-> model family) or startup warns or fails:
#   all-minilm / bge-micro -> 384    nomic-embed-text -> 768
#   snowflake-arctic-embed2 / bge-m3 / mxbai -> 1024
# On CPU-only hardware prefer a 384-dim model: the 1024-dim default embeds
# slowly enough to make a large library impractical. See the runbook's
# "Performance and model sizing" before committing a library.
EMBED_MODEL=snowflake-arctic-embed2
CHAT_MODEL=qwen2.5:3b
VECTOR_SIZE=1024

# Chunks embedded per Ollama request. MUST fit inside Ollama:TimeoutMs (300 s):
# a batch of N costs roughly N x per-chunk time. 8 is safe on CPU; 32-64 on GPU.
EMBED_BATCH_SIZE=8

# Native Ollama on the host, reached from the container via host.docker.internal.
# Never publish 11434.
OLLAMA_URL=http://host.docker.internal:11434

# First admin account created by deploy/bootstrap.sh (private cloud mode).
# Change these; the password is only ever passed to the CLI over stdin.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME="Workstation Admin"
ADMIN_PASSWORD=change-me-strong-password
